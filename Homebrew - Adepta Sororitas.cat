    <selectionEntry type="unit" import="true" name="Uriah Jacobus" hidden="false" id="c1e8-0a6f-55e4-3422" publicationId="1bb1-1c40-9f73-9fdb">
      <rules>
        <rule name="Protector of the Faith" id="5fe5-abfe-3501-f868" hidden="false">
          <description>The unit he joins has Feel No Pain (6+), or improves an existing Feel No Pain by 1</description>
        </rule>
        <rule name="Spirit of the Martyr" id="71cd-740c-f028-3733" hidden="false">
          <description>Once per game, when Uriah would be slain, he may perform the Spirit of the Martyr Act of Faith without spending a Faith point</description>
        </rule>
        <rule name="War Hymns" id="2833-945f-e6e0-c6be" hidden="false">
          <description>The unit he joins adds 1 to its Attacks in a turn in which it charged</description>
        </rule>
        <rule name="Zealot" id="2d65-6f63-5c4a-84ab" hidden="false">
          <description>Uriah and any unit he joins gain Hatred and Fearless</description>
        </rule>
      </rules>
