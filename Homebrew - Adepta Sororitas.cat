    <selectionEntry type="upgrade" import="true" name="Armour of Saint Katherine" hidden="false" id="fd59-c4ba-caad-eb93" publicationId="1bb1-1c40-9f73-9fdb">
      <profiles>
        <profile name="Armour of Saint Katherine" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="22bb-7a44-f82e-1f6c">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*The blessed armour of the Martyred Saint, worn by Celestine.* The Armour of Saint Katherine confers a 2+ Armour Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Brazier of Holy Fire" hidden="false" id="b269-ea1c-8b34-d384" publicationId="1bb1-1c40-9f73-9fdb">
      <profiles>
        <profile name="Brazier of Holy Fire" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="ca9b-3334-3d38-12fb">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A burning brazier swung at the enemy in a gout of holy flame.* A one-use flamer that also counts as a frag grenade; see the Armoury.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="676e-0a43-22d8-6b96" name="Brazier of holy fire" hidden="false" targetId="d793-b56e-3afd-f595" type="profile" />
      </infoLinks>
      <entryLinks>
