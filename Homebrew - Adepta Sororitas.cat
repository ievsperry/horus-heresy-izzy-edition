        <profile name="Vehicle Equipment" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="2c53-a2ec-f328-6d0d">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Any Sororitas Rhino, Immolator, Exorcist or Castigator may take any of the following, each once:</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Aestred Thurga and Agathae Dolan" hidden="false" id="12a0-0d2f-3f05-5af6" publicationId="1bb1-1c40-9f73-9fdb">
      <rules>
        <rule name="Litanies of Faith" id="ac98-ef44-52af-d83b" hidden="false">
          <description>While Dolan lives, the unit they join may re-roll failed charges and Morale checks</description>
        </rule>
        <rule name="Righteous Fury" id="1a11-1a39-addd-9697" hidden="false">
          <description>Thurga adds 1 to her Attacks for each friendly Sororitas character slain earlier in the game</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Independent Character" id="f78b-1ae9-779d-917d" hidden="false" targetId="c57d-4820-458a-7ab5" type="rule" />
        <infoLink name="Order (X)" id="4993-c395-2650-fe1f" hidden="false" targetId="c81d-97d6-8640-e9c3" type="rule" />
        <infoLink name="Shield of Faith" id="357d-9e15-0214-106d" hidden="false" targetId="5251-be94-c535-6673" type="rule" />
      </infoLinks>
      <categoryLinks>
        <categoryLink targetId="36c3-e85e-97cc-c503" id="99f8-0f86-368e-600c" primary="false" name="Unit:" />
      </categoryLinks>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Aestred Thurga" hidden="false" id="5ce6-af0f-6780-b490" publicationId="1bb1-1c40-9f73-9fdb">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="7de8-e191-051c-e306" percentValue="false" includeChildSelections="false" includeChildForces="false" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="22c5-b4cc-87e7-c887" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Aestred Thurga" typeId="4bb2-cb95-e6c8-5a21" typeName="Unit" hidden="false" id="cd02-78ae-85d2-5555" publicationId="1bb1-1c40-9f73-9fdb">
