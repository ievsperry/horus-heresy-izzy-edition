          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A holy icon of the Imperium, carried to inspire the faithful.* As the bearer's datasheet states.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Sororitas Carapace" hidden="false" id="3fe9-b167-9b71-80b5" publicationId="1bb1-1c40-9f73-9fdb">
      <profiles>
