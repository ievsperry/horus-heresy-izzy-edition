          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Enemy units in base contact with the bearer's unit subtract 1 from their Weapon Skill</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="The Cloak of Saint Aspira" hidden="false" id="56eb-e073-5c10-9b17" publicationId="1bb1-1c40-9f73-9fdb">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="7435-ee04-186a-e1a6" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile name="The Cloak of Saint Aspira" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="0ae4-4470-5b14-95e8">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The bearer adds 1 to her Armour Save, to a best of 2+</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="The Litanies of Faith" hidden="false" id="ac37-6713-c372-46f2" publicationId="1bb1-1c40-9f73-9fdb">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="36c4-40b5-62e4-855a" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile name="The Litanies of Faith" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="191c-39ad-35b4-6d08">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Once per turn, the bearer's unit may perform an Act of Faith without spending a Faith point</characteristic>
          </characteristics>
        </profile>
