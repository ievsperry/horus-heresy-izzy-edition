    <selectionEntry type="unit" import="true" name="Saint Celestine" hidden="false" id="c26f-7768-c989-99c3" publicationId="1bb1-1c40-9f73-9fdb">
      <rules>
        <rule name="Healing Tears" id="661d-6796-701d-368f" hidden="false">
          <description>At the end of each of your turns, Celestine restores one lost Wound</description>
        </rule>
        <rule name="Lifewards" id="9d3e-e4cc-0b1d-df7d" hidden="false">
          <description>While a Geminae Superia is alive, wounds allocated to Celestine may be allocated to a Geminae instead, as Look Out, Sir! on a 2+</description>
        </rule>
        <rule name="Miraculous Intervention" id="85ff-e172-13b7-8da3" hidden="false">
          <description>The first time Celestine is slain, roll a D6 at the end of the phase; on a 2+, place her back within 6" of where she fell with D3 Wounds</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Deep Strike" id="37dd-b53a-9618-d5b2" hidden="false" targetId="f1e1-986f-c783-ca9e" type="rule" />
        <infoLink name="Hammer of Wrath (X)" id="423f-7185-ed33-c6cf" hidden="false" targetId="aec0-c3aa-1e4e-1779" type="rule">
