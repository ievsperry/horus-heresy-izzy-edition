    <selectionEntry type="unit" import="true" name="Celestian Insidiants" hidden="false" id="f51d-3dcd-cd66-a63a" publicationId="1bb1-1c40-9f73-9fdb">
      <rules>
        <rule name="Denuncia Oratory" id="0d33-39a6-e230-4b81" hidden="false">
          <description>While the Denuncia lives, each time the unit's quarry is destroyed, choose a new enemy unit to be its quarry</description>
        </rule>
        <rule name="Inspiration" id="4bf7-3dc6-83d6-6618" hidden="false">
          <description>In a turn in which the unit charged, or destroyed an enemy character, psyker or model with 6 or more Wounds, its weapons gain Rending (6+)</description>
        </rule>
        <rule name="Martyrdom of the Insidiants" id="c9ba-ce03-4c46-3f02" hidden="false">
          <description>When an Inspired Insidiant is slain, before removing it, one friendly Sororitas unit within 6" may immediately gain one Benediction until the end of the turn: +1 Attack, re-roll failed to-hit rolls, restore one lost Wound to a character, or move up to 6" (this move may be a charge)</description>
        </rule>
        <rule name="Rituale Nullificatus" id="0599-e747-65bb-e30c" hidden="false">
          <description>The unit has Feel No Pain (4+) against Psychic weapons, psychic powers and Perils of the Warp</description>
        </rule>
        <rule name="Simulacrum Imperialis" id="6370-94d9-6ee9-4a43" hidden="false">
          <description>While the Reliquarius lives, at the start of each of your turns, if the unit is within 3" of an objective, roll a D6; on a 4+, gain 1 Faith point</description>
        </rule>
        <rule name="Virtue of Intolerance" id="0b52-a405-f756-958a" hidden="false">
          <description>At the start of the game, choose one enemy unit to be the unit's quarry. The unit has Preferred Enemy against its quarry</description>
        </rule>
        <rule name="Weapons of the Witch Hunters" id="4993-64ec-0bd9-9414" hidden="false">
          <description>The unit's null maces, condemnor bolt pistols and virge of admonition gain Murderous Strike against psykers (see Armoury)</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Adamantium Will (X+)" id="10f3-95e4-0af7-8157" hidden="false" targetId="4380-44a5-f01a-d964" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Adamantium Will (5+)" />
          </modifiers>
        </infoLink>
        <infoLink name="Invulnerable Save (X)" id="9eeb-f8d9-b1e2-b7de" hidden="false" targetId="3340-8300-cc17-3aa4" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (5+)" />
          </modifiers>
        </infoLink>
        <infoLink name="Order (X)" id="1785-54ec-8b36-20ea" hidden="false" targetId="c81d-97d6-8640-e9c3" type="rule" />
        <infoLink name="Shield of Faith" id="fffd-aa83-14aa-919e" hidden="false" targetId="5251-be94-c535-6673" type="rule" />
      </infoLinks>
