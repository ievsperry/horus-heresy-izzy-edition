          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A shield that projects an energy field, carried by Crusaders.* A model with a storm shield has a 3+ Invulnerable Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="4d2b-11ff-feea-ac1a" hidden="false" targetId="3340-8300-cc17-3aa4" type="rule">
