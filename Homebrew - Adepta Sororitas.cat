      </constraints>
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Executioner of Heretics" hidden="false" id="694d-6411-4e1b-f5d9" publicationId="1bb1-1c40-9f73-9fdb">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="74bd-dea0-ca46-1125" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Executioner of Heretics" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="5963-88fc-6ebc-167d">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord and any unit she joins have Hatred against every enemy unit, and Preferred Enemy (Psykers). In addition, your army may make one additional reaction in your opponent's Shooting phase, above its normal Reaction Allotment.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="1b23-1c2e-a406-50ea" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Indomitable Belief" hidden="false" id="29f9-25d3-c280-eb11" publicationId="1bb1-1c40-9f73-9fdb">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8a4a-5ac9-873f-546d" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Indomitable Belief" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="5fac-d7c6-6f81-9026">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">At the start of each of your turns, gain 1 additional Faith point while the Warlord is on the battlefield. In addition, your army may make one additional reaction in your opponent's Assault phase, above its normal Reaction Allotment.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="6123-531f-28fe-ee54" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Pure of Will" hidden="false" id="f1af-4f6b-3001-cde0" publicationId="1bb1-1c40-9f73-9fdb">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1224-aa39-c33e-4313" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Pure of Will" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="169f-9498-c1d5-f59a">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord has Adamantium Will (4+), and enemy psykers within 12" of her suffer Perils of the Warp on any double. In addition, your army may make one additional reaction in your opponent's Movement phase, above its normal Reaction Allotment.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="ba49-22c9-8fe1-de54" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Inspirational Martyr" hidden="true" id="9537-381c-b410-c133" publicationId="1bb1-1c40-9f73-9fdb">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="0911-d978-9d63-ae2b" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c1c7-d23b-e617-b60c" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Inspirational Martyr" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="42e1-0e39-4d97-a58e">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">If the Warlord is slain, gain D3+1 Faith points, and every friendly unit within 12" gains Rage (2) for the rest of the game.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="05ed-028b-2f7c-3a27" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Quiet Fury" hidden="true" id="adad-dfbe-7bef-9bff" publicationId="1bb1-1c40-9f73-9fdb">
          <modifiers>
