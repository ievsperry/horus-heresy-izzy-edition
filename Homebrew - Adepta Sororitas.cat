          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Lighter armour worn by Novitiates still proving their faith.* Sororitas carapace confers a 4+ Armour Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Sororitas Power Armour" hidden="false" id="0081-8e0f-bcb3-3797" publicationId="1bb1-1c40-9f73-9fdb">
