  <publications>
    <publication id="1bb1-1c40-9f73-9fdb" name="Adepta Sororitas for The Horus Heresy 2.0 — Homebrew Conversion" shortName="HB - Adepta Sororitas" />
  </publications>
  <selectionEntries>
    <selectionEntry type="upgrade" import="true" name="Adepta Sororitas" hidden="false" id="4fee-72d5-0ad3-83a0" publicationId="1bb1-1c40-9f73-9fdb">
      <constraints>
        <constraint type="min" value="1" field="selections" scope="force" shared="true" id="d3db-7212-9da4-175c" percentValue="false" includeChildSelections="true" includeChildForces="false" />
        <constraint type="max" value="1" field="selections" scope="force" shared="true" id="981a-9d0a-90ee-ec8c" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile name="Righteous Retribution" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="54b4-d391-ce69-18c7">
          <characteristics>
            <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Sororitas unit loses one or more models to a Shooting Attack. After the attack is resolved, the unit makes a Return Fire Shooting Attack against the attacking unit, and may re-roll to-hit rolls of 1.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Faith" id="cc84-9fc7-028f-3eb7" hidden="false">
          <description>The Sisters' faith is a weapon in its own right. It is tracked as a pool of Faith points for your whole army.

Acts of Faith. Spend 1 Faith point to have one friendly Sororitas unit perform an Act of Faith at the time it lists. A unit may perform only one Act of Faith per phase, and each Act may be used only once per turn across your army.

Gaining Faith. At the start of each of your turns, gain D3 Faith points, plus 1 for each Sororitas HQ character on the battlefield (to a maximum of +2). You also gain Faith through Martyrdom: each time a friendly Sororitas unit is destroyed, or a Sororitas character is slain, gain 1 Faith point. Unspent Faith points carry over between turns, to a maximum of 6.

Miracles. Once per turn, you may spend 2 Faith points to replace one dice roll made for a friendly Sororitas unit (a to-hit, to-wound, saving throw, charge distance or Morale roll) with a result of 6, before any re-rolls.

• Divine Guidance (when the unit is selected to shoot): The unit may re-roll failed to-hit rolls
• Fleet of Foot (at the start of your Movement phase): The unit may Advance and still shoot and declare a charge this turn
• Hand of the Emperor (at the start of the Assault phase): The unit adds 1 to its Strength and its melee weapons gain Rending (6+)
• Light of the Emperor (when the unit takes a Morale check or Pinning test): The unit automatically passes it, and may still shoot and charge normally this turn
• The Passion (when the unit declares a charge): The unit may re-roll its charge distance and adds 1 to its Attacks
• Spirit of the Martyr (when the unit is selected as a target, or before allocating wounds to it): The unit has Feel No Pain (5+), or improves an existing Feel No Pain by 1</description>
        </rule>
        <rule name="Unit Types" id="d13e-d286-043d-ea3a" hidden="false">
          <description>Paragon Warsuits are Infantry with the Mechanised sub-type, and use the official 2.0 Mechanised rules.

Penitent Engines, Mortifiers and the Anchorite are also Infantry with the Mechanised sub-type. Their pilots are condemned penitents, so they never gain Faith points through Martyrdom and may not benefit from Acts of Faith, except Spirit of the Martyr.</description>
        </rule>
      </rules>
      <categoryLinks>
        <categoryLink targetId="e90d-e5a8-f42d-da84" id="c99c-9c17-f028-f723" primary="true" name="Allegiance:" />
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Order" hidden="false" id="80a7-59da-bb5c-0600">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="d164-55ce-b0c5-6b80" percentValue="false" includeChildSelections="false" includeChildForces="false" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="48c0-6d89-14c5-4083" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Order of Our Martyred Lady" hidden="false" id="0911-d978-9d63-ae2b" publicationId="1bb1-1c40-9f73-9fdb">
              <profiles>
                <profile name="Martyrs' Vengeance" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="3830-91a1-b5b9-3304">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: a friendly unit within 6" of a unit with this Order is destroyed in close combat. The unit moves up to D6 plus its Initiative toward the enemy unit that destroyed it; if this brings it into base contact, it counts as having charged†.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Martyrs' Fury" id="6ad5-61ed-b80b-8669" hidden="false">
                  <description>gain 2 Faith points instead of 1 through Martyrdom for this Order's units.</description>
                </rule>
                <rule name="Vengeance" id="b3e1-68a7-0f48-9c65" hidden="false">
                  <description>the unit adds 1 to its Attacks in a turn in which a friendly unit within 6" was destroyed.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Order of the Argent Shroud" hidden="false" id="2e68-39a6-6513-0931" publicationId="1bb1-1c40-9f73-9fdb">
              <profiles>
                <profile name="Swift Redeployment" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="2dfc-c9dd-fe95-08fc">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Movement phase). Trigger: an enemy unit ends a move within 12" of an Argent Shroud unit. The unit moves up to D6 plus its Initiative Characteristic in inches in any direction.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Selfless Heroism" id="9550-9429-d437-970e" hidden="false">
                  <description>Sororitas characters may re-roll failed Look Out, Sir! rolls†.</description>
                </rule>
                <rule name="Silent Advance" id="0e3c-79df-7e18-664d" hidden="false">
                  <description>the unit may Advance and still shoot in the same turn.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Order of the Bloody Rose" hidden="false" id="ea72-413b-bf9b-eeed" publicationId="1bb1-1c40-9f73-9fdb">
              <profiles>
                <profile name="Bloody Counter-charge" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="463f-cee7-2d06-6d73">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: an enemy unit declares a charge against a Bloody Rose unit. Instead of firing Overwatch, the unit gains Counter-Charge (1) until the end of the phase†.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Blood Price" id="d1b6-57f8-194a-8e64" hidden="false">
                  <description>the unit may re-roll failed charge distance rolls.</description>
                </rule>
                <rule name="Furious Rage" id="1de1-94bc-39ff-3d3f" hidden="false">
                  <description>the unit adds 1 to its Attacks in a turn in which it charged.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Order of the Ebon Chalice" hidden="false" id="acf3-16a8-d6c6-d277" publicationId="1bb1-1c40-9f73-9fdb">
              <profiles>
                <profile name="Fire and Faith" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="8f76-9466-1f09-b5b2">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: an Ebon Chalice unit is selected as the target of a Shooting Attack. The unit makes a Return Fire Shooting Attack before the enemy attack is resolved, instead of after it.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Ancient Rituals" id="c049-da72-bcb7-fb7e" hidden="false">
                  <description>once per turn, you may spend Faith points on an Act of Faith for an Ebon Chalice unit even if that Act has already been used this turn.</description>
                </rule>
                <rule name="Fervent Discipline" id="5198-d3fe-1123-af51" hidden="false">
                  <description>in a turn in which it did not move, the unit may re-roll to-hit rolls of 1 with ranged weapons.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Order of the Sacred Rose" hidden="false" id="0c0a-0aa6-649d-b24b" publicationId="1bb1-1c40-9f73-9fdb">
              <profiles>
                <profile name="Unshakeable Line" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="0141-0cdb-7afd-f817">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: an enemy unit declares a charge against a Sacred Rose unit. The unit fires Overwatch with every model, adding 1 to its Ballistic Skill for the Overwatch, to a maximum of 5†.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Calm Under Fire" id="148c-29c7-9efd-5704" hidden="false">
                  <description>the unit may re-roll failed Morale checks.</description>
                </rule>
                <rule name="Serene Composure" id="66a9-a3b3-54dc-d204" hidden="false">
                  <description>the unit adds 1 to its Leadership, to a maximum of 10.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Order of the Valorous Heart" hidden="false" id="cbab-ba7b-7d4b-6afd" publicationId="1bb1-1c40-9f73-9fdb">
              <profiles>
                <profile name="Unbending Endurance" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="801e-09cf-2866-4e7d">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Valorous Heart unit is selected as the target of a Shooting Attack. Against that attack, the unit improves its Feel No Pain by a further 1, to a best of 4+.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Imperturbable" id="bebd-c741-dba8-0d0b" hidden="false">
                  <description>the unit has Feel No Pain (6+), or improves an existing Feel No Pain by 1.</description>
                </rule>
                <rule name="Penitent Bearing" id="eb2b-261e-1dfb-ffd0" hidden="false">
                  <description>the unit may re-roll failed Pinning tests.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Rite of War" hidden="false" id="3a4d-762b-43d0-7d57">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8080-4277-79d4-995a" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Armoured Convent" hidden="false" id="20f3-4160-8f7e-e3c1" publicationId="1bb1-1c40-9f73-9fdb">
              <rules>
                <rule name="Effects" id="912c-df2b-ed21-6913" hidden="false">
                  <description>Paragon Warsuits may be taken as Troops and gain the Line sub-type, and Immolators gain Scout.</description>
                </rule>
                <rule name="Limitations" id="db00-3546-c750-cead" hidden="false">
                  <description>Requires Morvenn Vahl or a Canoness as Warlord.   every Infantry unit must start the game embarked on a transport.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="48c7-cb3b-bd81-80f6" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Crusade of Faith" hidden="false" id="0457-ec4d-d05c-d8bf" publicationId="1bb1-1c40-9f73-9fdb">
              <rules>
                <rule name="Effects" id="6b82-11b6-471e-2ce3" hidden="false">
                  <description>at the start of the game, gain D3 Faith points, and Sororitas units may perform two Acts of Faith per phase instead of one.</description>
                </rule>
                <rule name="Limitations" id="eefd-38d1-1058-75b7" hidden="false">
                  <description>Requires a Canoness or Saint Celestine as Warlord.   no Penitent Engines, Mortifiers or Repentia.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="0a11-a1c2-1d02-ec00" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Penitent Host" hidden="false" id="2272-ad17-ba5a-a39a" publicationId="1bb1-1c40-9f73-9fdb">
              <rules>
                <rule name="Effects" id="e260-c05d-ef45-9313" hidden="false">
                  <description>Repentia Squads and Arco-flagellants may be taken as Troops and gain the Line sub-type, and Penitent Engines may be taken as Elites.</description>
                </rule>
                <rule name="Limitations" id="7ca9-f5cd-3804-58e4" hidden="false">
                  <description>Requires a Ministorum Priest or Dogmata as Warlord.   the army may not include more Battle Sisters Squads than penitent units (Repentia, Arco-flagellants, Penitent Engines and Mortifiers).</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="e107-49fd-dc69-12ac" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
