          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Ornate, consecrated power armour, worn by the Sisters of Battle.* Sororitas power armour confers a 3+ Armour Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Storm Shield" hidden="false" id="8107-a423-2afb-ccc0" publicationId="1bb1-1c40-9f73-9fdb">
