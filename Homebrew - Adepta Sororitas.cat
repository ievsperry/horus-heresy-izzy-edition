    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Chirurgeon's Tools" hidden="false" id="c7d6-0f41-be1a-205c" publicationId="1bb1-1c40-9f73-9fdb">
      <profiles>
        <profile name="Chirurgeon's Tools" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="ca3f-333d-492e-27dd">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*The surgical tools of a Hospitaller, used to keep her Sisters in the fight.* The bearer has the Medicae special rule (see the Hospitaller).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Null Censer" hidden="false" id="b3df-58f7-bfe8-8ffd" publicationId="1bb1-1c40-9f73-9fdb">
      <profiles>
        <profile name="Null Censer" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="ea6f-f568-e8ac-6ff1">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A censer that burns null-incense, choking the powers of the warp.* Enemy psykers within 12" of the bearer subtract 2 from their Leadership for Psychic checks.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Paragon Warsuit" hidden="false" id="5940-7c99-1430-de8d" publicationId="1bb1-1c40-9f73-9fdb">
      <profiles>
        <profile name="Paragon Warsuit" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="d115-1cee-496a-0a20">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A heavy armoured suit piloted by the most honoured Sisters.* A Paragon Warsuit confers a 2+ Armour Save, and its wearer has the Mechanised sub-type.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Reliquary of the Witch-bane" hidden="false" id="3bd5-1d1b-6b5c-612d" publicationId="1bb1-1c40-9f73-9fdb">
      <profiles>
        <profile name="Reliquary of the Witch-bane" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="d34f-c04e-6540-6941">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A relic said to have slain a hundred witches.* The bearer's unit may re-roll failed saves against psychic weapons.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Rosarius" hidden="false" id="3df1-bcf1-4f59-c426" publicationId="1bb1-1c40-9f73-9fdb">
      <profiles>
        <profile name="Rosarius" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="960f-934a-7ed9-dc42">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A holy amulet that projects a protective field.* A model with a rosarius has a 4+ Invulnerable Save. Shield of Faith does not improve it further.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="d82a-3264-5b29-cf72" hidden="false" targetId="3340-8300-cc17-3aa4" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (4+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Sacresant Shield" hidden="false" id="24bd-4925-4d07-98c9" publicationId="1bb1-1c40-9f73-9fdb">
      <profiles>
        <profile name="Sacresant Shield" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="52bf-8c93-9250-9528">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A heavy shield carried by the Celestian Sacresants.* The bearer adds 1 to its Armour Save, to a best of 2+, and has a 5+ Invulnerable Save in close combat.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="abba-7d69-f748-ffa9" hidden="false" targetId="3340-8300-cc17-3aa4" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (5+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
