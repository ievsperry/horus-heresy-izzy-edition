                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0973-6044-255d-6662" percentValue="false" includeChildSelections="false" includeChildForces="false" />
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0ed9-8e64-9a3f-5a3d" percentValue="false" includeChildSelections="false" includeChildForces="false" />
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9443-d7e0-7e8c-8627" percentValue="false" includeChildSelections="false" includeChildForces="false" />
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8d57-f98a-364d-2c1d" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule name="Effects" id="71c1-7c93-ee1d-973e" hidden="false">
                  <description>Seraphim and Zephyrim Squads may be taken as Troops and gain the Line sub-type.</description>
                </rule>
                <rule name="Limitations" id="aa7d-b330-9faa-b6a7" hidden="false">
                  <description>Requires a Canoness with a jump pack, Saint Celestine or Junith Eruita as Warlord.   no Heavy Support choices other than Exorcists.</description>
                </rule>
              </rules>
