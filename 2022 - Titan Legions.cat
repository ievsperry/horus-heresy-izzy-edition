  <catalogueLinks>
    <catalogueLink id="de74-d2a5-d0be-55c8" name="Mech Library" targetId="3129-da35-55e0-642d" type="catalogue" importRootEntries="true"/>
    <catalogueLink id="e048-9e5e-507c-5baf" name="LI - Assassins and Agents" targetId="4c88-1a81-7e53-0a67" type="catalogue" importRootEntries="true"/>
  </catalogueLinks>
  <sharedRules>
    <rule name="Secutarii" id="ecaa-8700-0ae7-5907" hidden="false">
      <description>A unit with this special rule belongs to the Titan Legions (Collegia Titanica and Secutarii) and may only be taken in a Titan Maniple Detachment.</description>
    </rule>
    <rule name="Titan Guard" id="3506-59b7-b30a-5c8d" hidden="false">
      <description>Models with this special rule gain the Stubborn and Feel No Pain (6+) special rules while within 6" of a friendly model with the Titan Unit Type.</description>
    </rule>
    <rule name="Void-Shield Capacitor Relay" id="5cbb-ed2f-a69c-896a" hidden="false">
      <description>During the Shooting phase, instead of making a Shooting Attack or using Battlesmith, a Titan Enginseer within 3" of a friendly model with the Titan Unit Type may attempt to reboot its collapsed Void Shields. Roll a D6, adding +1 for every Repair Servo-Automaton in the unit within 3" of the Titan: on a 4+, the Titan immediately restores 1 collapsed Void Shield (in addition to any normal end-of-turn Void Shield restoration rolls).</description>
    </rule>
    <rule name="Titan-Link Targeting" id="425a-73fb-26b0-28c0" hidden="false">
      <description>If a friendly model with the Titan Unit Type within 12" fired at an enemy unit in the same Shooting phase, this unit may re-roll failed To Hit rolls of 1 when targeting that same enemy unit.</description>
    </rule>
  </sharedRules>
  <selectionEntries>
    <selectionEntry type="upgrade" import="true" name="Rite of War" hidden="false" id="b924-9d00-271d-f38d">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <comment>Rites of War: Titan Maniple only</comment>
          <conditions>
            <condition type="notInstanceOf" value="0" field="selections" scope="ancestor" childId="aebe-bed9-b32f-a8ea" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="force" shared="true" id="7bc3-7326-6f13-7cf1" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
      </constraints>
      <categoryLinks>
        <categoryLink id="bc99-4169-b44a-ee47" name="Rite of War:" hidden="false" targetId="d494-e450-d4aa-579a" primary="true"/>
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup id="1bb0-127f-e1bf-b09a" name="Rites of War" hidden="false" collective="false" import="true">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2d01-a322-2f67-5633" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Iron Phalanx of the God-Engines" hidden="false" id="49b6-b6b6-4be2-96fb">
              <modifiers>
                <modifier type="set" field="f10c-4b9c-86d9-56b8" value="0">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition type="lessThan" value="1" field="selections" scope="force" childId="b08e-55fe-3e1d-913b" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                        <condition type="lessThan" value="1" field="selections" scope="force" childId="d737-baca-32e7-8da6" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                        <condition type="lessThan" value="1" field="selections" scope="force" childId="3dd1-77d8-4289-b745" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                        <condition type="lessThan" value="1" field="selections" scope="force" childId="841c-c2f5-9817-3061" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                        <condition type="lessThan" value="1" field="selections" scope="force" childId="2dbc-7655-bb05-ab89" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
                <modifier type="set" field="f10c-4b9c-86d9-56b8" value="0">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="force" childId="a24f-12d8-36c1-f477" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f10c-4b9c-86d9-56b8" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
              </constraints>
              <rules>
                <rule id="5b32-aa35-f947-0278" name="Prerequisites" hidden="false">
                  <description>• A Detachment using this Rite of War must include at least one Secutarii Axiarch or at least one model with the Titan Unit Type, and its Warlord must be either a Secutarii Axiarch or a Titan (if eligible to serve as Warlord).</description>
                </rule>
                <rule id="b708-9e66-f7ca-8e3f" name="Effects" hidden="false">
                  <description>• Titan Guard Battleline: Secutarii Peltasts and Secutarii Hoplites may be selected as Troops choices in a Detachment using this Rite of War, and gain the Line Unit Sub-type.
• Synchronized Shield-Wall: Friendly Secutarii Hoplites, Secutarii Peltasts, and Secutarii Ballistarii within 6" of a friendly model with the Titan Unit Type improve their Kyropatris Field Generator Invulnerable Save by +1 (to a maximum of 4+), and may re-roll failed Morale and Pinning tests.
• Sacristan Field-Support: Enginseer Field-Repair Teams in a Detachment using this Rite of War may be selected as non-Compulsory Troops choices in addition to Elites choices, and gain a 5+ Invulnerable Save while within 6" of a friendly Titan.
• No Step Back: Friendly units with the Secutarii special rule within 3" of an Objective marker or a friendly Titan gain the Heart of the Legion special rule (granting Feel No Pain (6+)).</description>
                </rule>
                <rule id="31e6-0cea-89e4-56fe" name="Limitations" hidden="false">
                  <description>• A Detachment using this Rite of War may not include any Fast Attack choices (other than Moderati Recon Foot-Patrols), nor may it include any Fortification choices.
• All Compulsory Troops choices in a Detachment using this Rite of War must be Secutarii Peltasts or Secutarii Hoplites.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Vanguard Reconnaissance Maniple" hidden="false" id="0515-5c4a-0116-f411">
              <modifiers>
                <modifier type="set" field="69d1-829c-8d08-0731" value="0">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition type="lessThan" value="1" field="selections" scope="force" childId="b08e-55fe-3e1d-913b" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                        <condition type="lessThan" value="1" field="selections" scope="force" childId="841c-c2f5-9817-3061" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
                <modifier type="set" field="69d1-829c-8d08-0731" value="0">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="force" childId="d737-baca-32e7-8da6" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                        <condition type="atLeast" value="1" field="selections" scope="force" childId="3dd1-77d8-4289-b745" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                        <condition type="atLeast" value="1" field="selections" scope="force" childId="2dbc-7655-bb05-ab89" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                        <condition type="atLeast" value="1" field="selections" scope="force" childId="a24f-12d8-36c1-f477" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="69d1-829c-8d08-0731" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
              </constraints>
              <rules>
                <rule id="6de9-d95b-8cb1-a93d" name="Prerequisites" hidden="false">
                  <description>• A Detachment using this Rite of War must include at least one Secutarii Axiarch or at least one Warhound Scout Titan, and its Warlord must be either a Secutarii Axiarch or a Warhound Scout Titan.</description>
                </rule>
                <rule id="794b-76f3-d6c3-6499" name="Effects" hidden="false">
                  <description>• Outriders of the Legion: Moderati Recon Foot-Patrols and Secutarii Peltasts may be selected as Compulsory Troops choices in a Detachment using this Rite of War, and gain the Line Unit Sub-type (removing Support Squad from Moderati Recon Foot-Patrols).
• Forward Target-Lock: Friendly Moderati Recon Foot-Patrols add +12" to the range of their Micro-Auspex Designators, and friendly Warhound Scout Titans may re-roll failed Outflank or Reserves rolls while at least one Moderati Recon Foot-Patrol is on the battlefield.
• Swift Stride: All friendly Secutarii Infantry units in a Detachment using this Rite of War gain the Scout and Move Through Cover special rules, and add +1" to their Run and Charge Distance rolls.
• Predatory Pack: If a Detachment using this Rite of War includes two or more Warhound Scout Titans, those Warhounds gain the Fleet (1) special rule and may re-roll To Hit rolls of 1 when targeting an enemy unit that was hit by a Micro-Auspex Designator in the same Shooting phase.</description>
                </rule>
                <rule id="9e48-a1c3-4601-aaef" name="Limitations" hidden="false">
                  <description>• A Detachment using this Rite of War may not include any Reaver, Warbringer, or Warlord Titans, nor may it include any Heavy Support choices (other than Secutarii Ballistarii mounted in Dedicated Transports).
• A Detachment using this Rite of War may not select any Fortification choices.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ordo Destructor Siege Cohort" hidden="false" id="03e5-358a-7f14-4b19">
              <modifiers>
                <modifier type="set" field="e6fe-91e3-79fa-01bc" value="0">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition type="lessThan" value="1" field="selections" scope="force" childId="b08e-55fe-3e1d-913b" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                        <condition type="lessThan" value="1" field="selections" scope="force" childId="d737-baca-32e7-8da6" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                        <condition type="lessThan" value="1" field="selections" scope="force" childId="3dd1-77d8-4289-b745" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                        <condition type="lessThan" value="1" field="selections" scope="force" childId="841c-c2f5-9817-3061" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                        <condition type="lessThan" value="1" field="selections" scope="force" childId="2dbc-7655-bb05-ab89" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
                <modifier type="set" field="e6fe-91e3-79fa-01bc" value="0">
                  <conditions>
                    <condition type="atLeast" value="1" field="forces" scope="roster" childId="d4f2-6da5-b6de-06ec" shared="true" includeChildSelections="true" includeChildForces="true" percentValue="false"/>
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e6fe-91e3-79fa-01bc" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
              </constraints>
              <rules>
                <rule id="271f-898e-b53a-159e" name="Prerequisites" hidden="false">
                  <description>• A Detachment using this Rite of War must include at least one Secutarii Axiarch or at least one model with the Titan Unit Type, and its Warlord must be either a Secutarii Axiarch or a Titan.</description>
                </rule>
                <rule id="52b9-1129-49cb-280a" name="Effects" hidden="false">
                  <description>• Breaching Phalanx: Secutarii Ballistarii may be selected as non-Compulsory Troops choices in addition to Heavy Support choices in a Detachment using this Rite of War.
• Siege-Breaker Protocols: All Secutarii units and Titans in a Detachment using this Rite of War gain the Tank Hunters and Wrecker special rules when targeting enemy Vehicles, Dreadnoughts, or Buildings / Fortifications.
• Overcharged Capacitors: Once per battle, at the start of any of the controlling player's Shooting phases, the Warlord may activate Reactor Surge. Until the end of that Shooting phase, all Secutarii Ballistarii and Enginseer Field-Repair Teams gain +1 to their Ballistic Skill Characteristic (to a maximum of BS 5), and all friendly Titans add +1 to any rolls made to restore collapsed Void Shields at the end of that turn.
• Subterranean Assault: Any Secutarii Infantry unit in this Detachment numbering 10 models or fewer may select a Termite Assault Drill as a Dedicated Transport.</description>
                </rule>
                <rule id="6bcf-918d-1f16-03d0" name="Limitations" hidden="false">
                  <description>• No unit in a Detachment using this Rite of War may make Run moves in the Shooting phase during the first game turn.
• A Detachment using this Rite of War may not include any Allied Detachment.
• All Compulsory Troops choices in a Detachment using this Rite of War must be Secutarii Peltasts or Secutarii Hoplites.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <costs>
