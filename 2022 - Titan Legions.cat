    <selectionEntry id="c497-145b-70df-9558" name="Titanshard Armour" publicationId="bde1-6db1-163b-3b76" page="125" hidden="false" collective="false" import="true" type="upgrade">
      <profiles>
        <profile id="fb0b-d16f-5099-6792" name="Titanshard Armour" publicationId="bde1-6db1-163b-3b76" page="125" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Titanshard Armour confers a 3+ Armour Save and a 5+ Invulnerable Save. In addition, a model with Titanshard Armour may re-roll Feel No Pain Damage Mitigation rolls which are the result of attacks made by weapons with the Poisoned (X) or Rad-phage special rules.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Enginseer Field-Repair Team" hidden="false" id="0d49-5dca-5a27-232e">
      <rules>
        <rule name="Servo-Assistants" id="e5cc-7900-fc90-84f7" hidden="false">
          <description>Battlesmith (4+) is the Titan Enginseer's; each Repair Servo-Automaton in base contact with the Enginseer adds +1 to the Battlesmith roll, to a maximum of 2+.</description>
        </rule>
        <rule name="Note" id="271a-2de2-4df9-c055" hidden="false">
          <description>An Enginseer Field-Repair Team numbering 10 models or fewer may take a Triaros Armoured Conveyor or a Termite Assault Drill as a Dedicated Transport.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Secutarii" id="1b4e-17d1-12bf-ba7d" hidden="false" targetId="ecaa-8700-0ae7-5907" type="rule"/>
