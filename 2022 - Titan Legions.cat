    <selectionEntry type="unit" import="true" name="Secutarii Ballistarii" hidden="false" id="4e22-9c22-3dd0-fc72">
      <rules>
        <rule name="Titan-Linked Field" id="0302-3f20-04c5-9860" hidden="false">
          <description>The unit's Kyropatris Field Generators confer a 5+ Invulnerable Save against Shooting Attacks, improving to 4+ while within 6" of a friendly Titan.</description>
        </rule>
        <rule name="Note" id="4d0a-3236-c552-078b" hidden="false">
          <description>Every model in the unit carries the same heavy weapon. A Secutarii Ballistarii unit numbering 10 models or fewer may take a Triaros Armoured Conveyor as a Dedicated Transport.</description>
        </rule>
      </rules>
