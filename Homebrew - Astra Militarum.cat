    <selectionEntry type="upgrade" import="true" name="The Emperor's Benediction" hidden="false" id="de41-d5bc-38f8-0aaf" publicationId="0fda-9dad-a0bf-40e6">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="04ea-f7e1-015d-3e3c" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile name="The Emperor's Benediction" typeId="1a1a-e592-2849-a5c0" typeName="Weapon" hidden="false" id="cafd-87a4-170b-757c" publicationId="0fda-9dad-a0bf-40e6">
          <characteristics>
            <characteristic name="Range" typeId="95ba-cda7-b831-6066">12"</characteristic>
            <characteristic name="Strength" typeId="24d9-b8e1-a355-2458">5</characteristic>
            <characteristic name="AP" typeId="f7a6-e0d8-7973-cd8d">4</characteristic>
            <characteristic name="Type" typeId="2f86-c8b4-b3b4-3ff9">Pistol 1, Precision Shot, Master-crafted</characteristic>
          </characteristics>
        </profile>
        <profile name="The Emperor's Benediction" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="d4be-abdd-110e-fcbc">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Wielded by a succession of brutal, uncompromising Commissars, this masterwork bolt pistol is feared by all. Its elementary but bloodthirsty machine spirit has been blamed for a series of unfortunate 'accidents' on the field of battle. In spite of this, the Officio Prefectus view the Emperor's Benediction as an artefact of some distinction – some say that it can taste cowardice even before the reprehensible act has been committed.* Heirloom of Conquest — Lord Commissar only; replaces the bolt pistol. Only one of each heirloom may be taken per army. Its profile is in the Armoury.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Master-crafted" id="f127-3bc7-1113-f7f3" hidden="false" targetId="6de0-55b0-bf21-48b9" type="rule" />
      </infoLinks>
    </selectionEntry>
