      <rules>
        <rule name="Bodyguard" id="44c4-2ca4-5cf0-d54c" hidden="false">
          <description>While Nork has joined a unit with an officer, he may take wounds allocated to that officer as Look Out, Sir! on a 2+</description>
        </rule>
        <rule name="Loyal" id="b355-7b4f-b481-70e5" hidden="false">
          <description>Nork may issue orders to Ogryn and Bullgryn units within 6" as though he were an officer with Voice of Command (1)</description>
