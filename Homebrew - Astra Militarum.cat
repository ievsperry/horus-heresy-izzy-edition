<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="6aaf-163e-5512-c78e" name="Homebrew - Astra Militarum" revision="16" battleScribeVersion="2.03" library="false" gameSystemId="28d4-bd2e-4858-ece6" gameSystemRevision="130" type="catalogue" authorName="Isaac">
  <publications>
    <publication id="0fda-9dad-a0bf-40e6" name="Astra Militarum for The Horus Heresy 2.0 — Homebrew Conversion" shortName="HB - Astra Militarum" />
  </publications>
  <selectionEntries>
    <selectionEntry type="upgrade" import="true" name="Astra Militarum" hidden="false" id="dc0d-35ba-0d83-561a" publicationId="0fda-9dad-a0bf-40e6">
      <constraints>
        <constraint type="min" value="1" field="selections" scope="force" shared="true" id="f033-137c-9abb-57e3" percentValue="false" includeChildSelections="true" includeChildForces="false" />
        <constraint type="max" value="1" field="selections" scope="force" shared="true" id="6c93-6fb7-b1b7-4277" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile name="Covering Fire" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="74c8-6293-3371-3fd0">
          <characteristics>
            <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: an Astra Militarum Infantry unit is selected as the target of a Shooting Attack. Another friendly Astra Militarum Infantry unit within 6" of the target, and in range and line of sight of the attacker, may make a Shooting Attack against the attacking unit after that attack is resolved, as though using Return Fire†.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink targetId="e90d-e5a8-f42d-da84" id="bb49-28cd-023a-b2e7" primary="true" name="Allegiance:" />
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Regiment" hidden="false" id="cbb0-faa8-53df-4653">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="f3b3-455d-18f0-83d0" percentValue="false" includeChildSelections="false" includeChildForces="false" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7755-b7a7-e4f2-6bbb" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Cadian" hidden="false" id="9510-5d77-7cea-145f" publicationId="0fda-9dad-a0bf-40e6">
              <profiles>
                <profile name="Fire Discipline" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="8541-45db-4b6b-1148">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Cadian Infantry unit is selected as the target of a Shooting Attack. The unit makes a Return Fire Shooting Attack before the enemy attack is resolved, instead of after it.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Born Soldiers" id="5555-d1af-1007-790e" hidden="false">
                  <description>in a turn in which it did not move, the unit may re-roll to-hit rolls of 1 with ranged weapons.</description>
                </rule>
                <rule name="Veteran Officers" id="5d2f-314b-fe4a-43ed" hidden="false">
                  <description>Cadian officers issue orders to units within 18" instead of 12".</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Catachan" hidden="false" id="365f-05ef-4447-be95" publicationId="0fda-9dad-a0bf-40e6">
              <profiles>
                <profile name="Ambush" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="8ab4-e8e5-dda4-a4a0">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Movement phase). Trigger: an enemy unit ends a move within 12" of a Catachan Infantry unit that is in cover. The Catachan unit makes a Shooting Attack against the triggering unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Brutal Strength" id="7e4e-4af4-927a-eb61" hidden="false">
                  <description>Infantry models add 1 to their Strength in close combat.</description>
                </rule>
                <rule name="Jungle Fighters" id="2b15-acbe-4b47-5241" hidden="false">
                  <description>Infantry units have Move Through Cover, and Stealth while in area terrain†.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Death Korps of Krieg" hidden="false" id="bf51-017e-dbd4-920d" publicationId="0fda-9dad-a0bf-40e6">
              <profiles>
                <profile name="Death Before Dishonour" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="505b-5e1f-d567-5df3">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: an enemy unit declares a charge against a Krieg Infantry unit. Instead of firing Overwatch, the unit gains Counter-Charge (1) until the end of the phase†.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Grim Demeanour" id="1835-5308-6eac-379b" hidden="false">
                  <description>Infantry units may re-roll failed Morale checks and Pinning tests.</description>
                </rule>
                <rule name="Siege Masters" id="b853-551e-3ab1-9540" hidden="false">
                  <description>artillery and Barrage weapons in the detachment may re-roll the scatter dice.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Mordian" hidden="false" id="133c-3945-56cb-740e" publicationId="0fda-9dad-a0bf-40e6">
              <profiles>
                <profile name="Volley Fire" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="26eb-47d5-73b6-f0af">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Mordian Infantry unit is selected as the target of a Shooting Attack. The unit makes a Return Fire Shooting Attack as though it had received the First Rank, Fire! Second Rank, Fire! order.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Iron Discipline" id="c0cd-1516-f740-9bd0" hidden="false">
                  <description>Infantry models add 1 to their Leadership, to a maximum of 10.</description>
                </rule>
                <rule name="Parade Drill" id="45ad-e1e6-7ef8-495c" hidden="false">
                  <description>a Mordian unit that receives the First Rank, Fire! Second Rank, Fire! order may still move, but may not Advance.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Tallarn" hidden="false" id="14c9-cf61-16dc-34cf" publicationId="0fda-9dad-a0bf-40e6">
              <profiles>
                <profile name="Strike and Vanish" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="901d-bc74-6d79-9922">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Movement phase). Trigger: an enemy unit ends a move within 12" of a Tallarn unit. The Tallarn unit moves up to D6 plus its Initiative Characteristic in inches (vehicles and Cavalry move up to 6"), and must end further from the triggering unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Desert Raiders" id="d29f-0a27-bb6f-4560" hidden="false">
                  <description>Infantry and Cavalry units of 15 or fewer models gain the Outflank special rule†.</description>
                </rule>
                <rule name="Swift As the Wind" id="e201-6316-d536-478c" hidden="false">
                  <description>vehicles and Cavalry add 2 to their Movement Characteristic.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Valhallan" hidden="false" id="9e49-436c-dbb2-09f9" publicationId="0fda-9dad-a0bf-40e6">
              <profiles>
                <profile name="Hold At All Costs" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="9f3a-57de-1563-558f">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: an enemy unit declares a charge against a Valhallan Infantry unit. The unit fires Overwatch with every model, adding 1 to its Ballistic Skill for the Overwatch, to a maximum of 5†.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Endless Ranks" id="6b83-cf09-bc3d-e847" hidden="false">
                  <description>Infantry units of 20 or more models never become Pinned.</description>
                </rule>
                <rule name="Ice Warriors" id="ca7c-b05f-dc6d-0aba" hidden="false">
                  <description>Infantry units of 10 or more models have Feel No Pain (6+).</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Elysian" hidden="false" id="12af-1e7d-6633-e9e3" publicationId="0fda-9dad-a0bf-40e6">
              <profiles>
                <profile name="Rapid Insertion" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="a618-fdf9-5d2f-63ba">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Movement phase). Trigger: an enemy unit ends a move within 12" of an objective marker. One Elysian Infantry unit in Reserves that has Deep Strike may immediately arrive by Deep Strike, placed wholly within 12" of that objective marker and more than 1" from enemy models. It scatters as normal and may not declare a charge this turn. This Reaction may be made by a unit in Reserves†.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Drop Troops" id="6655-35bd-d7c8-7cbe" hidden="false">
                  <description>Infantry units and Sentinels have Deep Strike, including Heavy Weapons Teams.</description>
                </rule>
                <rule name="Iron Discipline" id="f648-9bb8-7f49-bfcf" hidden="false">
                  <description>a unit within 6" of a friendly model with Voice of Command (X) may make a Regroup test even if it is below 25% of its starting strength.</description>
                </rule>
                <rule name="Airborne Platoons" id="307e-d9fa-d98c-0c9f" hidden="false">
                  <description>Infantry Platoon squads and Veterans may take a Valkyrie as a Dedicated Transport instead of a Chimera or Taurox. An Elysian detachment may not include Leman Russ or Rogal Dorn tanks; its armour is Valkyries, Vendettas and Sentinels.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Rite of War" hidden="false" id="120a-650b-4869-218a">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d2cb-6944-1a0c-6676" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Armoured Company" hidden="false" id="a1ea-9b94-e3be-5675" publicationId="0fda-9dad-a0bf-40e6">
              <rules>
                <rule name="Effects" id="f13f-cdc6-9e12-275e" hidden="false">
                  <description>Leman Russ Strike Squadrons may be taken as Troops and gain the Line sub-type.</description>
                </rule>
                <rule name="Limitations" id="d3d5-2271-3d86-3940" hidden="false">
                  <description>Requires a Leman Russ Command tank with Tank Orders as Warlord.   the army may not include more Infantry units than it has vehicle units.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="475b-e5c6-3a26-00b9" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Mechanised Infantry" hidden="false" id="efcd-968a-f43c-c620" publicationId="0fda-9dad-a0bf-40e6">
              <rules>
                <rule name="Effects" id="0588-e6f6-faa5-41e2" hidden="false">
                  <description>any Infantry unit of 10 or fewer models may take a Chimera as a Dedicated Transport, and units embarked on a Chimera may receive orders.</description>
                </rule>
                <rule name="Limitations" id="c770-9ad3-1fc5-d3fd" hidden="false">
                  <description>Requires an officer with Voice of Command as Warlord.   every Infantry unit must start the game embarked on a transport.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="4d15-34f7-2beb-e6ed" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Siege Artillery" hidden="false" id="d24c-7bd9-a6ee-9431" publicationId="0fda-9dad-a0bf-40e6">
              <modifiers>
                <modifier type="set" field="bfa9-a176-08c1-50c6" value="0">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="20ef-cd01-a8da-376e" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="bfa9-a176-08c1-50c6" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule name="Effects" id="0f06-b289-4ba0-d111" hidden="false">
                  <description>Heavy Weapons Squads and Field Ordnance Batteries may be taken as Troops, and artillery and Barrage weapons may re-roll scatter dice.</description>
                </rule>
                <rule name="Limitations" id="c795-0e48-5c37-ac99" hidden="false">
                  <description>Requires a Master of Ordnance or Lord Commissar as Warlord.   no Fast Attack choices.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="b62a-b77c-98a3-01a3" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Air Cavalry" hidden="false" id="fd02-4897-f52e-79c4" publicationId="0fda-9dad-a0bf-40e6">
