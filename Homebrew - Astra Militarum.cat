    <selectionEntry type="unit" import="true" name="Colour Sergeant Kell" hidden="false" id="28f1-042b-1b98-83f4" publicationId="0fda-9dad-a0bf-40e6">
      <rules>
        <rule name="Listen Up, Maggots!" id="bb36-276e-b813-ea82" hidden="false">
          <description>Orders issued to the unit Kell has joined are passed automatically</description>
        </rule>
        <rule name="Watch Your Back, Sir!" id="f49b-5d00-6e4e-4640" hidden="false">
          <description>While Kell has joined a unit with Ursarkar E. Creed, he may take wounds allocated to Creed as Look Out, Sir! on a 2+</description>
        </rule>
