    <selectionEntry type="upgrade" import="true" name="Brute Shield" hidden="false" id="3cc8-04b2-a4a7-db53" publicationId="0fda-9dad-a0bf-40e6">
      <profiles>
        <profile name="Brute Shield" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="d688-bed4-77eb-773a">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A heavy shield with a crackling energy field, carried by Bullgryns.* A model with a brute shield has a 5+ Invulnerable Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="fe6b-d75a-b2fa-04b5" hidden="false" targetId="e95f-b73d-1ff4-2879" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (5+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Camo Cloaks" hidden="false" id="c680-67bc-1578-b5e0" publicationId="0fda-9dad-a0bf-40e6">
      <profiles>
        <profile name="Camo Cloaks" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="ed82-7e5f-aa31-4982">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Light-bending cloaks worn by forward sentries.* A unit wearing camo cloaks gains Infiltrate and Shrouded (6+). If the unit already has Shrouded (X), it instead improves that value by 1, to a maximum of Shrouded (4+).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Camo Gear" hidden="false" id="91ea-dc84-a453-38ef" publicationId="0fda-9dad-a0bf-40e6">
      <profiles>
        <profile name="Camo Gear" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="8de0-e173-5e2a-b3b1">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Mottled fatigues, netting and foliage that blur a squad into its surroundings.* A unit in which every model has camo gear has Shrouded (5+).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Carapace Armour" hidden="false" id="af80-bb73-5ba7-6e77" publicationId="0fda-9dad-a0bf-40e6">
      <profiles>
        <profile name="Carapace Armour" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="de23-3947-b0bd-678c">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Rigid plates worn by Scions and veteran troopers.* Carapace armour confers a 4+ Armour Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Command Rod" hidden="false" id="664d-50e8-5039-53f1" publicationId="0fda-9dad-a0bf-40e6">
      <profiles>
        <profile name="Command Rod" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="3232-7727-573c-5eb6">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A badge of office that lets a Tempestor Prime coordinate his forces.* A Tempestor Prime with a command rod has Voice of Command (3).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Demolitions" hidden="false" id="6519-87d1-f868-60bd" publicationId="0fda-9dad-a0bf-40e6">
      <profiles>
        <profile name="Demolitions" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="277c-c5d1-8fb1-c42c">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Veteran doctrine.* The entire squad has melta bombs. One Veteran carries a demolition charge in addition to his other equipment.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Forward Sentries" hidden="false" id="ee89-1ad9-f570-7262" publicationId="0fda-9dad-a0bf-40e6">
      <profiles>
        <profile name="Forward Sentries" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="bf38-9c02-677d-eb32">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Veteran doctrine.* The squad has camo gear and snare mines.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Grenadiers" hidden="false" id="18aa-5d71-4a1e-d388" publicationId="0fda-9dad-a0bf-40e6">
      <profiles>
        <profile name="Grenadiers" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="66c3-fe68-53a9-3f4e">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Veteran doctrine.* The squad replaces its flak armour with carapace armour.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Flak Armour" hidden="false" id="5304-251c-725b-7b96" publicationId="0fda-9dad-a0bf-40e6">
      <profiles>
        <profile name="Flak Armour" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="2f44-f151-73ab-e3a5">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Layered padding issued by the trillion to the Imperial Guard.* Flak armour confers a 5+ Armour Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Frag Bombs" hidden="false" id="12b7-c824-089a-c39e" publicationId="0fda-9dad-a0bf-40e6">
      <profiles>
        <profile name="Frag Bombs" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="06d2-87fd-c9a7-0858">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Grenades sized for Ogryn hands.* Frag bombs count as frag grenades†.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Death Korps Medi-pack" hidden="false" id="9bb1-7536-4e54-ce43" publicationId="0fda-9dad-a0bf-40e6">
      <profiles>
        <profile name="Death Korps Medi-pack" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="ad0a-78ec-e593-6b65">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Krieg medics patch up the wounded and drive them back into the line.* A unit that includes a model with a Death Korps medi-pack has Feel No Pain (5+).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Melta Bombs" hidden="false" id="6622-e935-8d37-1359" publicationId="0fda-9dad-a0bf-40e6">
      <profiles>
        <profile name="Melta Bombs" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="de5d-7a90-d9ee-cebb">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Shaped magnetic charges for cracking armour.* A model with melta bombs may use them in the same way as krak grenades, but the automatic Hit is Str 8, AP 1 and has Armourbane (Melta)†.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Medi-pack" hidden="false" id="343d-2772-0b27-bc25" publicationId="0fda-9dad-a0bf-40e6">
      <profiles>
        <profile name="Medi-pack" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="bde3-c90e-a99b-3761">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Field surgery gear and stimms carried by a squad medic.* A unit that includes a model with a medi-pack has Feel No Pain (6+).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="The Deathmask of Ollanius" hidden="false" id="41c5-d4d6-3087-b934" publicationId="0fda-9dad-a0bf-40e6">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="8718-47b0-0e7f-f849" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile name="The Deathmask of Ollanius" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="052a-f892-7f82-3735">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Ollanius the Pious is the epitome of Imperial sainthood, believed martyred at the hands of Horus himself. In the millennia since his passing, Ollanius' deathmask has been revered as a holy relic; whosoever wears this ancient artefact is granted the determination and endurance of the famous martyr himself. The mask is a terrifying piece of craftsmanship, depicting in obsidian and void-fired bronze the agonised visage of a tortured angel. It is said that, in the presence of traitors, the Deathmask will weep tears of blood.* Heirloom of Conquest. Only one of each heirloom may be taken per army. The bearer of the Deathmask of Ollanius gains a 4+ invulnerable save, and has the It Will Not Die and Fear special rules.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="The Laurels of Command" hidden="false" id="4c5b-373c-68bf-668d" publicationId="0fda-9dad-a0bf-40e6">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="53d6-09bc-476e-b7b8" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile name="The Laurels of Command" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="b92f-aae3-fc90-cf90">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*The Laurels of Command are a callous and controversial means to ensure obedience. Concealed within their peerless artistry is a band of empathic-impulsion circuitry which allows the wearer limited control over the minds of indoctrinated individuals via subliminal suggestion. Under their effects even cowards fight to the last, while orders are executed in perfect synchronisation. However, if the officer wearing the Laurels is slain, the echoes of his death can leave his subordinates reeling in confusion.* Heirloom of Conquest — Company Commander only; Tempestor Prime in this list. Only one of each heirloom may be taken per army. Whenever a friendly unit from Codex: Astra Militarum within 6" of the bearer is required to take a Morale check, the bearer of the Laurels may choose whether they pass or fail. However, if the model with the Laurels is removed as a casualty, all friendly units from Codex: Astra Militarum within 6" must take an immediate Pinning test.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="The Tactical Auto-Reliquary of Tyberius" hidden="false" id="9499-c54d-39a7-16ca" publicationId="0fda-9dad-a0bf-40e6">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="b4a2-a11c-bc88-84d1" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile name="The Tactical Auto-Reliquary of Tyberius" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="e1b3-a6aa-c043-07fb">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Built into the gold-chased skull of Lord Commander Lucellin Tyberius himself, this device contains a web of psycho-circuitry containing Tyberius' memory engrams and tactical acumen – and with it, his curmudgeonly and overbearing personality. Borne aloft by its own gravitic motors, the device observes and evaluates an officer's decisions. The moment it considers an order poorly chosen, the skull cuts into the vox and loudly overrides its exasperated owner. In imperious, static-laden tones, the auto-reliquary will countermand the officer's orders and issue a barrage of its own from Tyberius' store of tactical insights.* Heirloom of Conquest — Company Commander only; Tempestor Prime in this list. Only one of each heirloom may be taken per army. When rolling Leadership tests for orders issued by an officer with the Tactical Auto-Reliquary, any successful Leadership test that results in a double will count as Inspired Tactics. However, if you roll a double 1 while using the Tactical Auto-Reliquary, you still benefit from Inspired Tactics, though the officer has 'accidentally' shut the device out of the vox network – it may no longer be used this game.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Platoon Standard" hidden="false" id="666a-e9b2-0c38-05a2" publicationId="0fda-9dad-a0bf-40e6">
      <profiles>
        <profile name="Platoon Standard" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="0771-f70c-24e8-c1d0">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A banner that reminds the men what they fight for.* A unit that includes a model with a platoon standard may re-roll failed Morale checks.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Refractor Field" hidden="false" id="721b-fe39-b2ef-2867" publicationId="0fda-9dad-a0bf-40e6">
      <profiles>
        <profile name="Refractor Field" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="7918-9ce8-a399-54e6">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A personal field generator issued to officers.* A model with a refractor field has a 5+ Invulnerable Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="17f5-04fd-702a-9974" hidden="false" targetId="e95f-b73d-1ff4-2879" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (5+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Rosarius" hidden="false" id="2920-75f0-6c58-0768" publicationId="0fda-9dad-a0bf-40e6">
      <profiles>
        <profile name="Rosarius" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="67af-eca8-3b88-2918">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A holy amulet that projects a protective field.* A model with a rosarius has a 4+ Invulnerable Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="b641-b065-a235-b0f5" hidden="false" targetId="e95f-b73d-1ff4-2879" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (4+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Slabshield" hidden="false" id="24ce-070d-0f57-4fbe" publicationId="0fda-9dad-a0bf-40e6">
      <profiles>
        <profile name="Slabshield" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="1558-f181-2c2e-1340">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A slab of armour plate wielded like a door.* A model with a slabshield adds 2 to its Armour Save, to a best of 2+.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Track Guards" hidden="false" id="b75d-38da-ea2a-2925" publicationId="0fda-9dad-a0bf-40e6">
      <profiles>
        <profile name="Track Guards" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="27b7-93f8-2958-ac7c">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Armoured skirts that protect a tank's drive systems.* A vehicle with track guards may ignore the first Immobilised result it suffers on the Vehicle Damage table†.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Vox-caster" hidden="false" id="34e1-9810-b486-844f" publicationId="0fda-9dad-a0bf-40e6">
      <profiles>
        <profile name="Vox-caster" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="6293-281d-8dc2-e4e9">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A backpack radio that keeps the squad in contact with command.* A unit that includes a model with a vox-caster may re-roll the Leadership test for orders.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Mental Fortitude" hidden="false" id="f49c-6ce0-cdfb-986b" publicationId="0fda-9dad-a0bf-40e6">
      <profiles>
        <profile name="Mental Fortitude" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="7c64-9997-8156-30f6">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">Movement (start) phase. One friendly unit within 12" automatically passes Morale checks and Pinning tests until the start of your next turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Nightshroud" hidden="false" id="18f5-74c4-ace7-1647" publicationId="0fda-9dad-a0bf-40e6">
      <profiles>
        <profile name="Nightshroud" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="183f-2b6d-f675-187a">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">Movement (start) phase. One friendly unit within 12" gains Shrouded (5+) until the start of your next turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Psychic Barrier" hidden="false" id="1fc9-ca5d-1b19-e14b" publicationId="0fda-9dad-a0bf-40e6">
      <profiles>
        <profile name="Psychic Barrier" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="6546-00ba-bb0e-1eb5">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">Movement (start) phase. One friendly unit within 12" gains a 5+ Invulnerable Save until the start of your next turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Terrifying Visions" hidden="false" id="b35a-4c75-a595-ba94" publicationId="0fda-9dad-a0bf-40e6">
      <profiles>
        <profile name="Terrifying Visions" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="93a7-048c-7d7b-d777">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">Shooting phase. One enemy unit within 18" subtracts 2 from its Leadership until the start of your next turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
