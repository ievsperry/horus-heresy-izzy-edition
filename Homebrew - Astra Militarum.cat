      <rules>
        <rule name="Amphibious" id="e2fa-7367-b4df-f953" hidden="false">
          <description>The Chimera treats water features as open ground</description>
        </rule>
        <rule name="Lasgun Arrays" id="5bdc-0d73-9b69-0e3b" hidden="false">
