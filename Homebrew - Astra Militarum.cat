    <selectionEntry type="unit" import="true" name="Tank Commander" hidden="false" id="682b-bdb4-2e0a-c920" publicationId="0fda-9dad-a0bf-40e6">
      <rules>
        <rule name="Lumbering Behemoth" id="1568-cd93-90d3-36c1" hidden="false">
          <description>The Leman Russ may fire its turret weapon after moving up to 6" as though it had not moved</description>
        </rule>
        <rule name="Note" id="8bbe-cda0-613c-c328" hidden="false">
          <description>30 points for the Tank Commander, plus his Leman Russ and the 1-2 other Leman Russ of his squadron (130 points each, plus weapons). The Tank Commander and his squadron are one HQ choice. These are the Leman Russ variants from the Heavy Support section.</description>
        </rule>
      </rules>
