    <selectionEntry type="unit" import="true" name="Master of Ordnance" hidden="false" id="48c5-508c-d83d-8ce2" publicationId="0fda-9dad-a0bf-40e6">
      <rules>
        <rule name="Call In the Barrage" id="2df2-ea4b-1680-1941" hidden="false">
          <description>Once per game, instead of shooting, the Master of Ordnance makes one Shooting Attack with an Ordnance Barrage</description>
        </rule>
        <rule name="Range Finder" id="4dbf-042a-f844-d1fe" hidden="false">
          <description>Friendly artillery and Barrage weapons with a target within 12" of him may re-roll scatter dice</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Independent Character" id="2c1c-bf90-c5fd-3f68" hidden="false" targetId="c57d-4820-458a-7ab5" type="rule" />
        <infoLink name="Regiment (X)" id="4c36-1c93-9b30-d266" hidden="false" targetId="3db4-0599-0496-8aaf" type="rule" />
        <infoLink name="Move Through Cover" id="4871-f14b-a0aa-fe0b" hidden="true" targetId="2b6f-bfec-759e-1746" type="rule">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="365f-05ef-4447-be95" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
        </infoLink>
        <infoLink name="Outflank" id="6294-b253-0532-d7a4" hidden="true" targetId="bfbf-e75c-49a2-0285" type="rule">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditionGroups>
