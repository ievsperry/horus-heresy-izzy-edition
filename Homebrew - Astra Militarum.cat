  <sharedSelectionEntryGroups>
    <selectionEntryGroup name="Warlord Traits" hidden="false" id="2b89-afde-0c02-720b">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="78e0-d11e-07c1-11b1" percentValue="false" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Bellowing Voice" hidden="false" id="1e18-2056-6947-8e7b" publicationId="0fda-9dad-a0bf-40e6">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5b19-5ad0-0b6a-8ebd" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Bellowing Voice" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="f45e-f8ed-bc6a-bd97">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">*Orders that carry across the din of battle.* The Warlord issues orders to units within 18" instead of 12". In addition, while the Warlord is on the battlefield, your army may make one additional reaction in your opponent's Movement phase, above its normal Reaction Allotment.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="c9fb-4749-e814-2fb0" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Grand Strategist" hidden="false" id="a037-762e-d472-7f90" publicationId="0fda-9dad-a0bf-40e6">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b1a1-017e-77d8-5bb3" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Grand Strategist" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="c493-1652-c88f-1369">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">*A commander who plans every battle three moves ahead.* You may re-roll one Reserves roll each turn. In addition, while the Warlord is on the battlefield, your army may make one additional reaction in your opponent's Shooting phase, above its normal Reaction Allotment.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="68d1-828d-b44f-9c8d" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Iron Will" hidden="false" id="dbf3-7b8a-7a25-9188" publicationId="0fda-9dad-a0bf-40e6">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="db32-c6ff-bada-ba8c" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Iron Will" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="e187-424d-1443-3606">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">*An officer whose men would rather face the enemy than his displeasure.* The Warlord's Leadership is 10, and friendly units within 6" of him may re-roll failed Morale checks. In addition, while the Warlord is on the battlefield, your army may make one additional reaction in your opponent's Assault phase, above its normal Reaction Allotment.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="adc4-2df1-6b45-1bc4" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
