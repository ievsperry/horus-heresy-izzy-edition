    <selectionEntry type="upgrade" import="true" name="The Blade of Conquest" hidden="false" id="c2c0-c345-b948-ac2f" publicationId="0fda-9dad-a0bf-40e6">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="4dff-5bce-047d-d451" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile name="The Blade of Conquest" typeId="1a1a-e592-2849-a5c0" typeName="Weapon" hidden="false" id="4942-bdd2-6ced-8399" publicationId="0fda-9dad-a0bf-40e6">
          <characteristics>
            <characteristic name="Range" typeId="95ba-cda7-b831-6066">-</characteristic>
            <characteristic name="Strength" typeId="24d9-b8e1-a355-2458">+1</characteristic>
            <characteristic name="AP" typeId="f7a6-e0d8-7973-cd8d">3</characteristic>
            <characteristic name="Type" typeId="2f86-c8b4-b3b4-3ff9">Melee, Master-crafted</characteristic>
          </characteristics>
        </profile>
        <profile name="The Blade of Conquest" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="99ba-85c6-96fd-1110">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*The greatest Imperial Guard commander ever to bestride the stars, Warmaster Solar Macharius reclaimed a thousand worlds for the Emperor. Upon his death he was enshrined as a saint; the six ornate blades of his subordinate generals laid upon the altar to his glory. Only one of these weapons has been reclaimed to active service. The Blade of Conquest is a beautiful example of bladesmithing, but its true worth lies in the authority it symbolises. Any man who wields this sword can light a righteous fire in the hearts of his men, for they fight in the shadow of Saint Solar himself.* Heirloom of Conquest — replaces the bearer's close combat weapon. Only one of each heirloom may be taken per army. Its profile is in the Armoury.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Master-crafted" id="e361-00f8-1117-a565" hidden="false" targetId="6de0-55b0-bf21-48b9" type="rule" />
      </infoLinks>
    </selectionEntry>
