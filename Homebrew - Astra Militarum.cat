                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f03f-496c-1aec-cd65" percentValue="false" includeChildSelections="false" includeChildForces="false" />
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d292-72e7-e7fd-8879" percentValue="false" includeChildSelections="false" includeChildForces="false" />
