      <profiles>
        <profile name="Psychic Maelstrom" typeId="cede-0217-1b10-2a34" typeName="Psychic Weapon" hidden="false" id="4832-2dd0-bc30-2b3b" publicationId="0fda-9dad-a0bf-40e6">
