                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7254-dad8-e07e-1988" percentValue="false" includeChildSelections="false" includeChildForces="false" />
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="02c3-c8b9-cc7a-73d3" percentValue="false" includeChildSelections="false" includeChildForces="false" />
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4e20-4fe8-dd75-2867" percentValue="false" includeChildSelections="false" includeChildForces="false" />
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9f4b-507b-8e9e-cb9c" percentValue="false" includeChildSelections="false" includeChildForces="false" />
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4f20-2980-8153-94f5" percentValue="false" includeChildSelections="false" includeChildForces="false" />
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2c92-9929-166d-8f72" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule name="Effects" id="496c-aa4e-f5e9-4acd" hidden="false">
                  <description>units with Deep Strike may arrive by Deep Strike Assault from the first game turn, and Reserve rolls for them succeed on a 3+. Infantry units of 12 or fewer models may take a Valkyrie or Vendetta as a Dedicated Transport.</description>
                </rule>
                <rule name="Limitations" id="04cc-88ef-86c1-96d3" hidden="false">
                  <description>Requires an Elysian officer with Voice of Command as Warlord.   no Lords of War, and no tanks (Chimera, Deathstrike, Hellhound, Hydra, Leman Russ, Manticore, Rogal Dorn Battle Tank, Wyvern).</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="5874-c9b8-fc33-89d4" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Tempestus Drop Force" hidden="false" id="aca7-8fdc-028a-206a" publicationId="0fda-9dad-a0bf-40e6">
              <modifiers>
                <modifier type="set" field="6a57-42c5-ad48-20ae" value="0">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="cbc8-14fc-1d85-cd44" shared="true" includeChildSelections="true" includeChildForces="false" />
