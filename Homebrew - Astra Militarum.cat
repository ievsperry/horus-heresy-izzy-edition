              <rules>
                <rule name="Effects" id="46c9-226a-bd8a-9f98" hidden="false">
                  <description>Tempestus Scions may be taken as Troops and gain the Line sub-type, and may arrive by Deep Strike from the first game turn.</description>
                </rule>
                <rule name="Limitations" id="b705-641b-8d31-b4e7" hidden="false">
                  <description>Requires a Tempestor Prime as Warlord.   no Heavy Support choices other than Valkyries or Vendettas taken as transports, and no Lords of War.</description>
                </rule>
              </rules>
