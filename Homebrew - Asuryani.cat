    <selectionEntry type="upgrade" import="true" name="Aspect Shrine: Dire Avenger" hidden="false" id="6de0-582d-7f34-f68a" publicationId="d5ae-9e15-7ef2-10f7">
      <rules>
        <rule name="Aspect Shrine: Dire Avenger" id="d2a3-43b3-5f86-4b1a" hidden="false">
          <description>May be selected by up to three Exarchs in a Detachment. - Special Rules: Aspect Shrine (Dire Avenger), Feel No Pain (5+), Flexible Tactics. - Wargear: gains an Augury Scanner, Shuriken Pistol, and Twin-linked Avenger Catapult at no cost.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Aspect Shrine (X)" id="0c17-8659-1d65-d2f3" hidden="false" targetId="ca67-1dda-6b7a-970f" type="rule">
