    <selectionEntry type="upgrade" import="true" name="Aspect Shrine: Dark Reaper" hidden="false" id="88a6-59d1-402b-6826" publicationId="d5ae-9e15-7ef2-10f7">
      <rules>
        <rule name="Aspect Shrine: Dark Reaper" id="6e5a-a6df-2054-5f5e" hidden="false">
          <description>May be selected by a single Exarch in a Detachment. - Unit Sub-type: gains Heavy. - Special Rules: Aspect Shrine (Dark Reaper), Fast Shot, Inescapable Accuracy, Relentless. - Wargear: exchanges Aspect Armour for Heavy Aspect Armour (if not already equipped) and gains a Reaper Launcher (with Starswarm, Starshot, and Starhawk Missiles) at no cost.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Aspect Shrine (X)" id="2998-a2b2-7cc4-72a2" hidden="false" targetId="ca67-1dda-6b7a-970f" type="rule">
