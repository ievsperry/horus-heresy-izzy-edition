        <profile name="Molten Body" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="0bb3-1161-880a-9fc1">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Provides a 3+ Invulnerable Save. Flame, Melta, and Volkite weapons can never wound the model; any such Wounds allocated to it are discarded. When the model loses its last Wound, before it is removed, all models (friend and enemy) within D6+6" suffer an automatic Hit at Str 8, AP –.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="930e-444c-79d3-6206" hidden="false" targetId="a59c-ba92-c096-58d8" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (3+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Power Field" hidden="false" id="0adf-874d-a5c0-44d4" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Power Field" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="1cb8-67ab-5c90-1113">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Provides a 5+ Invulnerable Save. A model with Wounds that suffers an unsaved Instant Death Wound is not removed outright, but loses D3 Wounds for each such Wound. When the model loses its last Wound or Hull Point, before it is removed or replaced with a Wreck, all models (friend and enemy) within D6" suffer an automatic Hit at Str 8, AP –.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="9355-7ed1-2bbe-e48d" hidden="false" targetId="a59c-ba92-c096-58d8" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (5+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Wave Serpent Shield" hidden="false" id="f97f-0cc8-ec70-0c01" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Wave Serpent Shield" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="b445-fe8e-3f44-d9e9">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Provides a 6+ Invulnerable Save against Shooting Attacks on the Front or Side Armour. Once per game, it may instead fire a Shield Blast (see Armoury), counted as a Hull (Front) Mounted weapon. After the Shield Blast, the model loses the 6+ Invulnerable Save for the rest of the battle.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="0be8-6072-590f-9137" hidden="false" targetId="a59c-ba92-c096-58d8" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (6+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Wraithshield" hidden="false" id="b457-d20e-f37e-7c54" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Wraithshield" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="3c1e-827a-80da-a736">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Provides a 4+ Invulnerable Save. A model with Wounds that suffers an unsaved Instant Death Wound is not removed outright, but loses D3 Wounds for each such Wound. When the model loses its last Wound or Hull Point, before it is removed or replaced with a Wreck, all models (friend and enemy) within D6" suffer an automatic Hit at Str 8, AP –.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="20fa-b648-16c6-945c" hidden="false" targetId="a59c-ba92-c096-58d8" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (4+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Jetbikes and Engines" hidden="false" id="cdc7-e600-dd44-e1bd" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Jetbikes and Engines" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="38e6-5fbd-db5b-1ade">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3" />
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Raptor Jetbike" hidden="false" id="b14d-ef4c-ed82-ba8c" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Raptor Jetbike" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="40f6-e165-0c3b-591f">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model with a Raptor Jetbike becomes Cavalry (Antigrav), M 18 and gains Battle-Hardened (1), Deep Strike, Firing Protocols (3), Fleet (2), Hammer of Wrath (1), Hit &amp; Run, Infiltrate, Relentless, Scout, Shrouded (5+). The model keeps any other Unit Sub-types it had.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Vyper Jetbike" hidden="false" id="1a07-ea26-7025-2c64" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Vyper Jetbike" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="e3a2-0dfa-5353-b9a6">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model with a Vyper Jetbike becomes Cavalry (Antigrav), M 16 and gains Deep Strike, Firing Protocols (2), Fleet (2), Hammer of Wrath (2), Hit &amp; Run, Relentless, Shrouded (5+). The model keeps any other Unit Sub-types it had. The model keeps any other Unit Sub-types it had.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Khaine's Destrier" hidden="false" id="5f7b-024d-8286-fd7f" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Khaine's Destrier" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="51f6-84ae-8dfe-4819">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Drastanta's unique jetbike. Drastanta gains: - Two Master-crafted Shuriken Cannons. - The Charge sub-phase move above. - May join units that include Cavalry despite the usual restrictions, and counts as having the Cavalry Unit Type in addition to its others, including for rules that target Cavalry. - Deep Strike, Firing Protocols (3), and Hammer of Wrath (2).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Revenant Jump Engines" hidden="false" id="0991-1ec6-b1bd-4d9b" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Revenant Jump Engines" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="631d-3981-5962-5eb9">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">At the start of the Controlling Player's Movement phase, the model may add +16" to its Movement for that turn (up to 32"), gaining all benefits of that Movement including Charge distance. While activated it ignores terrain when Moving and Charging (but may not end in Impassable Terrain), and may move over friendly and enemy models, ending at least 1" from other units. It may not be activated during a Reaction.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Star Engines" hidden="false" id="81d5-0aac-200a-c70d" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Star Engines" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="69b6-dbe6-45cf-0bda">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The model moves an additional 3" when making Movement Reactions.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Vectored Engines" hidden="false" id="6b7b-5b97-58d9-cefb" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Vectored Engines" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="7f86-5f09-0ebc-71f3">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">When targeted by a Shooting Attack in the opposing player's turn, if the Reactive Player chooses to have the model react, it may first pivot on the spot to face any direction.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Webway Shunt Generator" hidden="false" id="f377-3976-6707-ea70" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Webway Shunt Generator" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="2ae1-8c77-1144-b87c">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Once per game, in the Controlling Player's Movement phase before moving, the model may instead be placed anywhere on the board and follow the Deep Strike Assault procedure (Core Rulebook, page 310), counting as having passed its Reserve roll. It cannot charge that turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Spectre Jet Pack" hidden="false" id="a7e9-1304-704d-7459" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Spectre Jet Pack" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="3212-042b-9f30-5470">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A unit made up entirely of models with Spectre Jet Packs may add +7" to its Move and ignore terrain in the Movement phase. It must still test for Dangerous Terrain when beginning or ending in it, and treats Difficult Terrain as Dangerous. - It may make an extra 7" Move in the Shooting phase after shooting, ignoring terrain the same way. - Any Reaction Move is increased by 7" and ignores terrain the same way. - The model gains Bulky (2) and Deep Strike, or Bulky (3) if it already has Bulky (2).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Swooping Hawk Wings" hidden="false" id="0da6-cdf4-b1f0-3716" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Swooping Hawk Wings" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="018c-e98e-e356-5ad2">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">At the start of the Controlling Player's Movement phase, or when deploying by Deep Strike Assault, the model may set its Move to 16" for that turn, gaining all benefits of that Movement including Charge distance. While activated it ignores terrain when Moving and Charging (still testing for Dangerous Terrain), and may move over friendly and enemy models, ending at least 1" from other units. The model gains Bulky (2) and Deep Strike, or Bulky (3) if it already has Bulky (2).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Warp Jump Generator" hidden="false" id="4a6f-f1fd-3d0f-4e9d" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Warp Jump Generator" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="cecc-aa38-3543-83a4">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A unit made up entirely of models with Warp Jump Generators may set its Move to 14" and move in any direction, ignoring Difficult, Dangerous, and Impassable Terrain. It must still test for Dangerous Terrain when beginning or ending in it, and treats Difficult Terrain as Dangerous. - It may make an extra 7" Move in the Shooting phase after shooting, ignoring terrain the same way. - Any Reaction Move (except Flickerjump) is increased by 7" and ignores terrain the same way. - The model gains Bulky (2) and Deep Strike, or Bulky (3) if it already has Bulky (2).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Augury Scanner" hidden="false" id="a318-de66-ce14-044b" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Augury Scanner" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="d3d8-14ec-7bc4-df05">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A unit with at least one Augury Scanner gains: - Enemy models cannot deploy using Infiltrate within 18" of it. - It ignores the 24" line of sight limit for Shooting Attacks under Night Fighting. - When an enemy unit deploys from Reserves, it may make the Interceptor Advanced Reaction (Core Rulebook, page 309) without spending a Reaction point. This does not allow more than one Reaction per phase, but may exceed the normal three-Reaction limit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Banshee Mask" hidden="false" id="3925-2a7d-b6aa-2a33" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Banshee Mask" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="a61c-e6f5-e9b0-55cf">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">In the Assault phase, the Reactive player may not make Reactions targeting a unit that contains a model with a Banshee Mask. This does not apply if the unit makes a Disordered Charge.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Comm-Bead" hidden="false" id="0df6-29c9-5179-b4f5" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Comm-Bead" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="dc3c-fed3-558d-abc2">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">While a model with a Comm-Bead is on the battlefield and not Embarked, the Controlling Player may re-roll Scatter rolls (for attacks or deployment) if the model has line of sight to the target unit or point. A unit with a Comm-Bead also ignores the –1 Leadership penalty from Night Fighting.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Craftworld Standard" hidden="false" id="636a-c270-a53d-b59f" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Craftworld Standard" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="3538-5d46-9a73-ad0d">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A unit with a Craftworld Standard adds +1 to its Wounds score for winning combat. Before rolling Fall Back distance, it may choose to Fall Back only D6" (instead of 2D6", or 3D6" for Cavalry). If forced off the battlefield edge, it stops 1" from the edge instead.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Crystal Targeting Matrix" hidden="false" id="2a19-930b-099c-99be" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Crystal Targeting Matrix" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="e59b-c09a-ad2d-d882">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Once per game, the model may fire a single weapon at its full Ballistic Skill in the Controlling Player's Shooting phase after moving Flat Out.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Ghostwalker Matrix" hidden="false" id="688a-673e-4948-d4f5" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Ghostwalker Matrix" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="589e-745e-ea2d-f46b">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The model has Move Through Cover. If it has the Antigrav Sub-type, it gains Pathfinder instead.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Gloom-Field" hidden="false" id="6a3a-a108-5757-a62a" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Gloom-Field" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="93e0-9627-462f-2797">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A unit containing at least one model with a Gloom-Field has Shrouded (5+).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Guide Stones" hidden="false" id="e65c-b027-89b1-0074" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Guide Stones" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="62bf-4480-9096-339e">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Units with Wraith models within 12" of a friendly model with Guide Stones automatically pass the Wraithsight Leadership test. A Wraith unit that has Guide Stones itself also passes its own test.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Helical Targeting Array" hidden="false" id="64a9-6762-63a5-2038" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Helical Targeting Array" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="d94a-01a4-167e-97af">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The Controlling Player may activate it at the start of any of their turns, or at the start of the battle if they are not taking the first turn. Until the start of their next turn: - The model may not move, Run, or make any Reactions other than Interceptor or Overwatch. - It may use the Skyfire special rule for its Shooting Attacks. - No Shrouded Damage Mitigation rolls may be made against its attacks. - Its Interceptor Reactions cost no Reaction point. This does not allow more than one Reaction per phase, but may exceed the normal three-Reaction limit. - A Vehicle with it may fire all its weapons, not just Defensive weapons, when making Interceptor.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Outcast Cloaks" hidden="false" id="1870-e52a-722f-affd" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Outcast Cloaks" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="e711-ff16-613d-d157">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">When a unit made up entirely of models with Outcast Cloaks is targeted by a Shooting Attack, the range counts as 6" further than it is. Enemies with Night Vision and Primarchs ignore this. Barrage attacks against the unit always scatter as though it were out of line of sight.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Plasma Grenades" hidden="false" id="7626-2ad3-9f96-58bf" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Plasma Grenades" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="5d51-f0a4-76df-56b2">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A unit with Plasma Grenades attacks at its normal Initiative after Charging through Difficult or Dangerous Terrain, but still suffers the Charge roll penalties. In the Assault phase, a model with Plasma Grenades engaged with a Building, Fortification, Vehicle, Dreadnought, or Automata may instead inflict one automatic Str 5, AP 4 Hit with Breaching (6+) at Initiative step 1. If it does, the unit Piles In at Initiative 1, and that model may not otherwise attack or use other Hit- or Wound-inflicting rules or wargear that phase (it may still Sweeping Advance).</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <entryLinks>
        <entryLink import="true" name="Plasma grenades" hidden="false" id="97e2-7e08-47ce-aa10" type="selectionEntry" targetId="0a7c-f03b-b6bc-5a71">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="bfff-7629-0e96-2ed2" percentValue="false" includeChildSelections="false" includeChildForces="false" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="de35-0bf9-52c7-df6c" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
        </entryLink>
      </entryLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Searchlights" hidden="false" id="2846-abeb-4224-0556" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Searchlights" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="842e-cf02-c66b-81ca">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The model ignores the 24" Night Fighting line of sight limit for Shooting Attacks, but enemies targeting it ignore that limit too. Any unit it shoots at may be targeted by other units that phase ignoring the 24" limit. Searchlights are not weapons and cannot be hit by Weapon Destroyed results.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Spirit Stones" hidden="false" id="82c4-4e06-45a4-1f54" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Spirit Stones" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="51fc-c810-16da-8f22">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The model gains the Reinforced Sub-type.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Terror's Lament" hidden="false" id="2040-a794-60e4-bf6a" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Terror's Lament" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="20ef-fdf7-656d-5941">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">In the Assault phase, the Reactive player may not make Reactions targeting a unit that contains a model with Terror's Lament. Enemies in base contact with that model have –1 Attacks and –1 Initiative (to a minimum of 1). This does not apply if the unit makes a Disordered Charge.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="The Crown of the Seventh Sky" hidden="false" id="c97e-7211-ee50-ac11" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="The Crown of the Seventh Sky" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="888d-104c-e281-cbcb">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Drastanta and any unit they have joined may make a single Reaction in the Movement phase without spending a Reaction point.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Wireweave Net" hidden="false" id="ef56-2e63-23fc-764e" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Wireweave Net" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="8177-060e-3fbc-2532">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The first time in a game a unit with a Wireweave Net is charged, the charging player suffers –3" to the Charge distance rolled.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Protect" hidden="false" id="2b6b-2174-d6e3-41ae" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Protect" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="07c3-f289-948a-7c45">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">*The Psyker surrounds nearby allies with shimmering barriers of psychic force that bend aside incoming attacks and reinforce failing armor.* Instead of making a Shooting Attack, a Psyker with this Psychic Power may select a single friendly unit within 12". That unit gains a 6+ Invulnerable Save until the end of the current player turn. When using this power, the controlling player may choose to have the Psyker take a Psychic check. If the Check is passed, then the target unit instead gains a 4+ Invulnerable Save until the end of the current player turn. If the Check is failed, then the target unit gains no benefit and the Psyker suffers Perils of the Warp.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Jinx" hidden="false" id="ed33-a49e-f48e-8998" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Jinx" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="a9e6-a753-16f4-173e">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">*The Psyker tears apart the protective fate-threads surrounding their enemies, leaving them exposed and vulnerable to incoming attacks.* Instead of making a Shooting Attack, a Psyker with this Psychic Power may select a single enemy unit within 18". That unit reduces all Armour Saves, Cover Saves and Invulnerable Saves by -1 until the start of the controlling player's next turn. When using this power, the controlling player may choose to have the Psyker take a Psychic check. If the Check is passed, then the target unit instead reduces all Armour Saves, Cover Saves and Invulnerable Saves by -2 until the start of the controlling player's next turn. If the Check is failed, then the target unit suffers no additional effect and the Psyker suffers Perils of the Warp.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Guide" hidden="false" id="5f86-e5f5-14f3-d037" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Guide" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="1454-76bd-6ead-3339">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">*The Psyker manipulates the strands of fate to guide allied warriors toward deadly precision and impossible accuracy.* Instead of making a Shooting Attack, a Psyker with this Psychic Power may select a single friendly unit within 24". Until the start of the Psyker's next Psychic phase, that unit re-rolls all failed To Hit rolls with its ranged Shooting Attacks, as if its ranged weapons were Twin-linked.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Voice of Twilight" hidden="false" id="a073-e5de-c8c3-5068" publicationId="d5ae-9e15-7ef2-10f7">
      <profiles>
        <profile name="Voice of Twilight" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="8707-b8d2-91de-c90d">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">*Submerging their mind into the shadow realm, the psyker empowers their accompanying wraiths.* Instead of making a Shooting Attack, select a single friendly unit with a model within 18" that contains at least one Wraith model. Apply one of the following to all Wraith models in the unit until the beginning of the Controlling Player's next turn: - Gains Furious Charge. - Gains Precision Shots (5+). - Gains Precision Strikes (5+). - Gains Split Fire. The controlling player may choose to take a Psychic check: if passed, two different options are applied instead of one; if failed, no benefits are gained and the Psyker suffers Perils of the Warp.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
