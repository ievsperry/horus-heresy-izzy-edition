      <rules>
        <rule id="1073-12d1-bdb4-4203" name="Ætheric Blessing: Ravenous Dissolution" hidden="false">
          <description>The Melee weapons of models in a unit with this Ætheric Blessing gain the Murderous Strike (6+) special rule (or improve an existing Murderous Strike value by +1, to a maximum of 4+), and the unit adds +1 to its Combat Resolution score in any combat that includes an enemy model with the Character Unit Sub-type.</description>
        </rule>
      </rules>
      <categoryLinks>
        <categoryLink id="7de3-c42e-511b-4424" name="Ravenous Dissolution" hidden="false" targetId="2774-1a32-f196-be76" primary="false"/>
