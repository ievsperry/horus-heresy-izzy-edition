      <rules>
        <rule name="Note" id="5383-ebc7-4a61-9479" hidden="false">
          <description>The entire unit must exchange its Warp-Fire Bolts for one Empyric Manifestation, and every model in the unit manifests the same one. Ætheric Blessing: +5 points per model.</description>
        </rule>
      </rules>
