    <selectionEntry type="unit" import="true" name="Formless Distortion: The Protean Doppelgänger" hidden="false" id="209f-fc34-959b-eef5">
      <rules>
        <rule name="Mirror of the Prey" id="1f32-9c30-083d-c27b" hidden="false">
          <description>When fighting in close combat against an enemy Character, the Protean Doppelgänger may choose to replace its own WS, S, T, I, A, and Armour Save with the unmodified characteristics of that enemy Character (if higher), and all of its attacks gain Precision Strikes (3+) and Rending (4+).</description>
        </rule>
        <rule name="Treachery Unmasked" id="d863-3ea2-fe01-b134" hidden="false">
          <description>Enemy units wishing to declare a Charge against or target the Protean Doppelgänger with Shooting Attacks from more than 12" away must first pass a Leadership test; if failed, they may not target the Doppelgänger that phase.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Daemons of the Ruinstorm" id="add9-3c80-1d9a-7ec0" hidden="false" targetId="96c8-8244-551e-fb18" type="rule"/>
