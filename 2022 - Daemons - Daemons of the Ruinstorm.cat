                      <conditions>
                        <condition type="lessThan" value="1" field="selections" scope="force" childId="2f3f-adc4-b19f-a5c7" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                        <condition type="lessThan" value="1" field="selections" scope="force" childId="5a2e-abe2-3044-3c1c" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                      </conditions>
