    <selectionEntry type="unit" import="true" name="Rapturous Sensation: The Velvet Executioner" hidden="false" id="6d8f-dedc-aee8-198c">
      <rules>
        <rule name="Quicksilver Duelist" id="9637-f1a9-2586-965e" hidden="false">
          <description>Enemy models locked in combat with the Velvet Executioner may only make a single Attack against her (regardless of their Attacks Characteristic, Charge bonuses, or two-weapon bonuses), and all of her close combat attacks gain Precision Strikes (3+) and Sudden Strike (1).</description>
        </rule>
      </rules>
