                        <condition type="lessThan" value="1" field="selections" scope="force" childId="5a2e-abe2-3044-3c1c" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
                <modifier type="set" field="e234-85fa-36cc-0ffd" value="0">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="force" childId="8d58-f500-443f-d897" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                        <condition type="atLeast" value="1" field="selections" scope="force" childId="c13b-8207-15bb-f932" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                        <condition type="atLeast" value="1" field="selections" scope="force" childId="ab4d-5d51-2b82-a6c9" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e234-85fa-36cc-0ffd" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
              </constraints>
              <rules>
                <rule id="04d7-2ce0-40f7-c5f5" name="Prerequisites" hidden="false">
                  <description>• A Detachment using this Rite of War must be aligned to the Heedless Slaughter Ætheric Dominion, and must include a Ruinstorm Daemon Sovereign or Ruinstorm Harbinger equipped with the Heedless Slaughter Ætheric Blessing as the army's Warlord.</description>
                </rule>
                <rule id="7a00-aea4-3aee-e266" name="Effects" hidden="false">
                  <description>• Hounds of Blood: Ruinstorm Daemon Beasts, Ruinstorm Greater Daemon Beasts, and Ruinstorm Flesh-Reaper Cavalry may be selected as Troops choices in a Detachment using this Rite of War. Any unit selected as a Compulsory Troops choice in this manner gains the Line Unit Sub-type.
• Blood-Frenzied Charge: Every unit in a Detachment using this Rite of War with the Heedless Slaughter Ætheric Blessing gains the Rage (2) special rule (or improves an existing Rage value by +1) and adds +1 to its Hammer of Wrath attack rolls.
• Skulls for the Throne: Whenever a friendly unit with the Daemon Unit Type destroys an enemy unit in the Assault phase, every model in that Daemon unit gains a +1 bonus to its Weapon Skill Characteristic (to a maximum of WS 10) for the remainder of the battle.</description>
                </rule>
                <rule id="9d15-4b87-9650-f98c" name="Limitations" hidden="false">
                  <description>• A Detachment using this Rite of War may not include any models armed with ranged weapons or Psychic Weapons (excluding Ruinstorm Daemon Sovereigns or Daemon Behemoths using breath/roar attacks with a range of 12" or less); Ruinstorm Warp-Spawn Packs, Incinerator Swarms, and Cataclysm Brute Packs may not be included in the Detachment.
• Every eligible unit in the Detachment must purchase the Heedless Slaughter Ætheric Blessing.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="The Plague-Swollen Host (Putrid Corruption)" hidden="false" id="c55a-5e28-5735-2b55">
              <modifiers>
                <modifier type="set" field="hidden" value="true">
                  <conditions>
                    <condition type="lessThan" value="1" field="selections" scope="force" childId="b7db-bf16-47c5-dc05" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                  </conditions>
                </modifier>
                <modifier type="set" field="0ac6-324b-d15f-632b" value="0">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition type="lessThan" value="1" field="selections" scope="force" childId="b7db-bf16-47c5-dc05" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
                <modifier type="set" field="0ac6-324b-d15f-632b" value="0">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition type="lessThan" value="1" field="selections" scope="force" childId="2f3f-adc4-b19f-a5c7" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                        <condition type="lessThan" value="1" field="selections" scope="force" childId="5a2e-abe2-3044-3c1c" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
                <modifier type="set" field="0ac6-324b-d15f-632b" value="0">
