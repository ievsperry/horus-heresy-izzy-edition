                      <conditions>
                        <condition type="atLeast" value="1" field="forces" scope="roster" childId="d4f2-6da5-b6de-06ec" shared="true" includeChildSelections="true" includeChildForces="true" percentValue="false"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="526d-b97d-d4c8-b095" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
              </constraints>
              <rules>
                <rule id="cf6b-b095-b018-9716" name="Prerequisites" hidden="false">
                  <description>• A Detachment using this Rite of War must include a Ruinstorm Daemon Sovereign or a Ruinstorm Harbinger as the army's Warlord.</description>
                </rule>
                <rule id="a48c-6545-c9e2-f418" name="Effects" hidden="false">
                  <description>• Vanguard of Monstrosities: Ruinstorm Daemon Brutes may be selected as Troops choices in a Detachment using this Rite of War. Any unit selected as a Compulsory Troops choice in this manner gains the Line Unit Sub-type.
• Cataclysmic Fire Support: Ruinstorm Cataclysm Brute Packs may be selected as Elites choices in addition to Heavy Support choices in a Detachment using this Rite of War.
• Unstoppable Juggernauts: Every unit composed entirely of models with the Daemon Unit Type and a base Wounds Characteristic of 3 or 4 (including Ruinstorm Daemon Brutes, Cataclysm Brute Packs, and Flesh-Reaper Cavalry) in a Detachment using this Rite of War gains the Stubborn and Heart of the Legion special rules (granting Feel No Pain (6+)—or improving an existing Feel No Pain roll by +1, to a maximum of 4+—while within 3" of an Objective marker).
• Crushing Advance: Models in a Ruinstorm Daemon Brute or Cataclysm Brute Pack unit gain the Hammer of Wrath (1) special rule (resolved at their unmodified Strength Characteristic and AP 3) in any turn in which they make a successful Charge.</description>
                </rule>
                <rule id="95f2-d87f-070e-573f" name="Limitations" hidden="false">
                  <description>• A Detachment using this Rite of War may not include any models with a base Wounds Characteristic of 1 (such as Ruinstorm Lesser Daemon Swarms or Ruinstorm Warp-Spawn Packs).
• A Detachment using this Rite of War may not select any Fortification choices, and may not include an Allied Detachment.
• All Compulsory Troops choices in a Detachment using this Rite of War must be Ruinstorm Daemon Brutes.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Screaming Host of the Skies" hidden="false" id="c114-98a5-c4ba-f0f6">
              <modifiers>
                <modifier type="set" field="6f5a-c37f-dfb3-93b8" value="0">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition type="lessThan" value="1" field="selections" scope="force" childId="2f3f-adc4-b19f-a5c7" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
                <modifier type="set" field="6f5a-c37f-dfb3-93b8" value="0">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="force" childId="2219-cb60-b52-a36c" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                        <condition type="atLeast" value="1" field="selections" scope="force" childId="ab4d-5d51-2b82-a6c9" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                        <condition type="atLeast" value="1" field="selections" scope="force" childId="bc02-3e9e-9e2e-0938" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                        <condition type="atLeast" value="1" field="selections" scope="force" childId="0654-98a0-becc-f11a" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                      </conditions>
