    <selectionEntry type="unit" import="true" name="Malevolent Artifice: The Soul-Flayer Construct" hidden="false" id="d666-9499-3382-1f7a">
      <rules>
        <rule name="Target-Lock Augury" id="66c5-9986-c4ef-aa72" hidden="false">
          <description>At the start of the battle, before deployment, nominate one enemy Character (including the opposing Warlord or a Character Dreadnought). The Soul-Flayer gains Preferred Enemy against that model's unit, and all of his Shooting Attacks and Melee attacks against that unit gain Precision Strikes (3+) and Precision Shots (3+).</description>
        </rule>
      </rules>
