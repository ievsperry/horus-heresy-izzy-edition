    <selectionEntry type="unit" import="true" name="Infernal Tempest: The Fate-Weaver of Shifting Flame" hidden="false" id="2115-0ed3-9612-abfa">
      <rules>
        <rule name="Threads of Doom" id="1247-08e7-7531-2e9a" hidden="false">
          <description>Once per Shooting phase, when the Fate-Weaver resolves a Shooting Attack or Psychic Weapon against a unit containing an enemy Character, all hits scored automatically allocate directly to an enemy Character of the controlling player's choice (ignoring Look Out, Sir! rolls), and the target may not re-roll failed Saving Throws against those wounds.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Daemons of the Ruinstorm" id="5072-687c-9286-81ff" hidden="false" targetId="96c8-8244-551e-fb18" type="rule"/>
