                        <condition type="greaterThan" value="1" field="selections" scope="force" childId="7031-469a-1aeb-eab0" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
                <modifier type="set" field="f646-a304-0bfd-3ecf" value="0">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition type="lessThan" value="3" field="selections" scope="force" childId="9b5d-fac7-799b-d7e7" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f646-a304-0bfd-3ecf" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
              </constraints>
              <rules>
                <rule id="00c3-48c3-621d-6f42" name="Prerequisites" hidden="false">
                  <description>• A Detachment using this Rite of War must include a Ruinstorm Daemon Sovereign or a Ruinstorm Harbinger as the army's Warlord.</description>
                </rule>
                <rule id="8bed-8d68-e215-8e18" name="Effects" hidden="false">
                  <description>• Endless Multitude: Ruinstorm Lesser Daemon Swarms and Ruinstorm Warp-Spawn Packs in a Detachment using this Rite of War may increase their maximum unit size to up to 20 models (at their standard points cost per additional model).
• Surging Tide: Ruinstorm Warp-Spawn Packs and Ruinstorm Daemon Beasts in a Detachment using this Rite of War do not have the Support Squad special rule (if applicable) and may be selected as Troops choices, gaining the Line Unit Sub-type if selected as Compulsory Troops.
• Drawn Through the Breach: Whenever a Ruinstorm Lesser Daemon Swarm, Ruinstorm Warp-Spawn Pack, or Ruinstorm Daemon Beast unit is completely destroyed, the controlling player may place an identical replacement unit into Deep Strike Reserves on a D6 roll of 4+ (this replacement unit may not carry Ætheric Blessings or character upgrades, and each unit may only be replaced once per game).
• Chorus of Ruin: Friendly units with the Daemon Unit Type within 12" of a Ruinstorm Herald Conclave or Ruinstorm Harbinger gain the Stubborn special rule and add +1" to their Run and Charge Distance rolls.</description>
                </rule>
                <rule id="5f98-f85f-2cfd-7159" name="Limitations" hidden="false">
                  <description>• A Detachment using this Rite of War may not include any Lords of War choices (such as Ruinstorm Arch-Daemons), nor may it include more than one Heavy Support choice (such as Ruinstorm Daemon Behemoths, Cataclysm Brute Packs, or Soul-Forge Engines).
• A Detachment using this Rite of War must include at least three Troops choices.
• All Compulsory Troops choices in a Detachment using this Rite of War must be Ruinstorm Lesser Daemon Swarms or Ruinstorm Warp-Spawn Packs.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Phalanx of Abominations" hidden="false" id="6f52-e302-28c1-d8a8">
              <modifiers>
                <modifier type="set" field="526d-b97d-d4c8-b095" value="0">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition type="lessThan" value="1" field="selections" scope="force" childId="2f3f-adc4-b19f-a5c7" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                        <condition type="lessThan" value="1" field="selections" scope="force" childId="5a2e-abe2-3044-3c1c" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
                <modifier type="set" field="526d-b97d-d4c8-b095" value="0">
