    <selectionEntry type="unit" import="true" name="Encroaching Ruin: The Ash-Reaper of Entropy" hidden="false" id="98ae-d145-87ee-2765">
      <rules>
        <rule name="Withered Resolve &amp; Rusted Plate" id="6e8b-8231-d77b-5d2f" hidden="false">
          <description>Enemy Characters within 6" of the Ash-Reaper suffer a -2 penalty to their Leadership Characteristic, cannot use Stubborn or Fearless rules, and worsen their Armour Save by 1 (e.g., a 2+ Armour Save becomes a 3+ Armour Save).</description>
        </rule>
      </rules>
