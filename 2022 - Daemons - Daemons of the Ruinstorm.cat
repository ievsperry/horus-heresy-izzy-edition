              </constraints>
              <rules>
                <rule id="8a01-c33c-e648-5b13" name="Prerequisites" hidden="false">
                  <description>• A Detachment using this Rite of War must be aligned to the Rapturous Sensation Ætheric Dominion, and must include a Ruinstorm Daemon Sovereign or Ruinstorm Harbinger equipped with the Rapturous Sensation Ætheric Blessing as the army's Warlord.</description>
                </rule>
                <rule id="3d28-f5fc-bc10-41a3" name="Effects" hidden="false">
                  <description>• Dancers of the Veil: Ruinstorm Daemon Beasts and Ruinstorm Flesh-Reaper Cavalry may be selected as Troops choices in a Detachment using this Rite of War. Any unit selected as a Compulsory Troops choice in this manner gains the Line Unit Sub-type.
• Blinding Quicksilver: All Ruinstorm Lesser Daemon Swarms, Daemon Beasts, Greater Daemon Beasts, Sky-Ray Packs, and Flesh-Reaper Cavalry in a Detachment using this Rite of War gain the Hit &amp; Run and Fleet (2) special rules, and add +1 to their Sweeping Advance rolls.
• Sonic Agony: Any Ruinstorm Warp-Spawn Pack equipped with Sonic Shrieks forces enemy units that suffer one or more unsaved wounds from those attacks to take their Pinning test at a -2 Leadership penalty.</description>
                </rule>
                <rule id="284d-19d2-e793-a85e" name="Limitations" hidden="false">
                  <description>• A Detachment using this Rite of War may not include any Heavy Support choices with a Movement Characteristic of 6" or less (such as Ruinstorm Cataclysm Brute Packs).
• Units in a Detachment using this Rite of War may not make Hold the Line Reactions in the Shooting phase.
• Every eligible unit in the Detachment must purchase the Rapturous Sensation Ætheric Blessing.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Host of Inevitable Decay (Encroaching Ruin)" hidden="false" id="9122-7ddf-1402-5b80">
              <modifiers>
                <modifier type="set" field="hidden" value="true">
                  <conditions>
                    <condition type="lessThan" value="1" field="selections" scope="force" childId="ca6c-e8cf-7bc1-eaa0" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
