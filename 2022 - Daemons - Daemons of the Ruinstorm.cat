    <selectionEntry type="unit" import="true" name="Heedless Slaughter: The Skull-Taker of the Brass Spire" hidden="false" id="9dc0-3c91-ebaa-9e94">
      <rules>
        <rule name="Challenger of the Worthy" id="ba96-5b46-6ea4-4145" hidden="false">
          <description>The Skull-Taker must always issue and accept Challenges whenever possible. While fighting in a Challenge, all of his Melee attacks gain Precision Strikes (3+) and Murderous Strike (4+), and his opponent may not make Look Out, Sir! rolls.</description>
        </rule>
      </rules>
