                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0634-d0f0-223a-5ba9" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
              </constraints>
              <rules>
                <rule id="aae5-987f-b403-3317" name="Prerequisites" hidden="false">
                  <description>• A Detachment using this Rite of War must be aligned to the Ravenous Dissolution Ætheric Dominion, and must include a Ruinstorm Daemon Sovereign or Ruinstorm Arch-Daemon equipped with the Ravenous Dissolution Ætheric Blessing as the army's Warlord.</description>
                </rule>
                <rule id="522b-6057-83fe-13d2" name="Effects" hidden="false">
                  <description>• Cannibalistic Surge: Ruinstorm Greater Daemon Beasts and Ruinstorm Incinerator Swarms may be selected as Troops choices in a Detachment using this Rite of War. Any Ruinstorm Lesser Daemon Swarm or Greater Daemon Beast selected as a Compulsory Troops choice gains the Line Unit Sub-type.
• Feast on Essence: Whenever any unit (friendly or enemy) is completely destroyed within 6" of a friendly Ruinstorm Daemon Sovereign, Daemon Behemoth, Greater Daemon Beast, or Lesser Daemon Swarm, that Daemon unit immediately regains D3 lost Wounds (or restores D3 destroyed 1-Wound models to the unit).
• Spiteful Detonation: Whenever a friendly Ruinstorm Daemon Brute, Cataclysm Brute Pack, or Soul-Forge Engine is destroyed, every unit (friendly and enemy) within 6" immediately suffers D6 automatic hits at Strength 5, AP 3, Ignores Cover.</description>
                </rule>
                <rule id="f5a4-1993-634e-fc49" name="Limitations" hidden="false">
                  <description>• A Detachment using this Rite of War may never include an Allied Detachment (and may not be taken as an Allied Detachment itself).
• Friendly units in a Detachment using this Rite of War may not join units with Independent Characters (other than Ruinstorm Herald Conclaves), and cannot benefit from Look Out, Sir! rolls.
• Every eligible unit in the Detachment must purchase the Ravenous Dissolution Ætheric Blessing.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Reality-Shattering Flux (Formless Distortion)" hidden="false" id="c9b5-5e2d-eef2-df40">
              <modifiers>
                <modifier type="set" field="hidden" value="true">
                  <conditions>
                    <condition type="lessThan" value="1" field="selections" scope="force" childId="8ed0-3582-f536-c48e" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                  </conditions>
                </modifier>
                <modifier type="set" field="75fe-8f41-ed95-000d" value="0">
                  <conditionGroups>
