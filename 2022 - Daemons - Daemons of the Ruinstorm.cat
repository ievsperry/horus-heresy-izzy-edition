      <rules>
        <rule id="58f1-5d0f-bcce-3770" name="Ætheric Blessing: Putrid Corruption" hidden="false">
          <description>Enemy units locked in close combat with a unit with this Ætheric Blessing suffer a -1 penalty to their Toughness Characteristic when resolving To Wound rolls in the Assault phase and a -1 penalty to their Initiative Characteristic (each to a minimum of 1).</description>
        </rule>
      </rules>
