                        <condition type="atLeast" value="1" field="selections" scope="force" childId="157c-7592-a6b9-f96" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                        <condition type="atLeast" value="1" field="selections" scope="force" childId="bb35-e585-a226-28e" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                        <condition type="atLeast" value="1" field="selections" scope="force" childId="8d58-f500-443f-d897" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                        <condition type="atLeast" value="1" field="selections" scope="force" childId="14c1-3063-c9b4-d99b" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
