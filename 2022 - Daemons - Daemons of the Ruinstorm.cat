    <selectionEntry type="unit" import="true" name="Putrid Corruption: The Blight-Stalker of Nurgle's Rot" hidden="false" id="4d71-9576-4455-932d">
      <rules>
        <rule name="Aura of Rot &amp; Ruin" id="104b-dcf3-3c3e-faf2" hidden="false">
          <description>Enemy models with the Character Unit Sub-type within 6" of the Blight-Stalker suffer a -1 penalty to their Toughness and Weapon Skill Characteristics (to a minimum of 1), and reduce all Invulnerable Saves by -1 (to a maximum of 6+).</description>
        </rule>
      </rules>
