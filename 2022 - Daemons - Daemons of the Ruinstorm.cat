    <selectionEntry type="unit" import="true" name="Ruinstorm Sky-Ray Pack" hidden="false" id="17c9-ed00-bb42-ad07">
      <modifiers>
        <modifier type="add" field="category" value="6399-5c65-7833-1025">
          <conditionGroups>
            <conditionGroup type="or">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="c114-98a5-c4ba-f0f6" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="0efd-e6e2-acb8-3d67" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Sky-Hunter" id="2560-3590-feb3-488b" hidden="false">
          <description>Models in this unit ignore terrain and intervening models and units during the Movement phase, though they must take Dangerous Terrain tests if beginning or ending a move in Dangerous Terrain.</description>
        </rule>
        <rule name="Slashing Dive" id="e6b8-b54d-3ee7-ae7c" hidden="false">
          <description>Once per turn during the Movement phase, after a Ruinstorm Sky-Ray Pack completes a move that passed directly over one or more models belonging to a single enemy unit (excluding Flyers and Buildings), that enemy unit immediately suffers D3 automatic hits for each Sky-Ray in the unit, resolved at Strength 4, AP 4, with the Rending (6+) special rule.</description>
        </rule>
        <rule name="Note" id="c059-ef86-2f92-567b" hidden="false">
          <description>Ætheric Blessing: +10 points per model.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Daemons of the Ruinstorm" id="6298-e3a4-6fb9-e29f" hidden="false" targetId="96c8-8244-551e-fb18" type="rule"/>
        <infoLink name="Daemonic (X)" id="2066-9a64-590d-db0a" hidden="false" targetId="69eb-cbfa-a5f6-db1d" type="rule">
