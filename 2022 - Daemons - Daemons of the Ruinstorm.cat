              </constraints>
              <rules>
                <rule id="48d1-a305-c4a1-8ae6" name="Prerequisites" hidden="false">
                  <description>• A Detachment using this Rite of War must be aligned to the Malevolent Artifice Ætheric Dominion, and must include a Ruinstorm Daemon Sovereign (equipped with the Malevolent Artifice Ætheric Blessing) or a Ruinstorm Harbinger as the army's Warlord.</description>
                </rule>
                <rule id="00e0-2f69-ab5a-7ba0" name="Effects" hidden="false">
                  <description>• Iron-Bound Cohort: Ruinstorm Cataclysm Brute Packs and Ruinstorm Daemon Brutes may be selected as Troops choices in a Detachment using this Rite of War. Any unit selected as a Compulsory Troops choice in this manner gains the Line Unit Sub-type.
• Engines of the Forge: Ruinstorm Soul-Forge Engines may be taken in squadrons of 1 to 3 models as a single Heavy Support choice, and Ruinstorm Daemon Behemoths gain a 3+ Armour Save and It Will Not Die (4+).
• Infernal Repairs: Friendly Ruinstorm Herald Conclaves gain the Battlesmith (4+) special rule, which may be used to restore lost Hull Points or Wounds to friendly Corrupted Engines, Soul-Forge Engines, Daemon Behemoths, and Cataclysm Brute Packs within base contact.
• Dark Communion: All models in a Detachment using this Rite of War may purchase the Malevolent Artifice Ætheric Blessing at -5 points per model (to a minimum of 5 points per model).</description>
                </rule>
                <rule id="e6cc-d0e9-417b-5959" name="Limitations" hidden="false">
                  <description>• A Detachment using this Rite of War may not include any Fast Attack choices (such as Ruinstorm Sky-Ray Packs, Daemon Beasts, or Ruinstorm Flesh-Reaper Cavalry).
• A Detachment using this Rite of War must include at least one Ruinstorm Herald Conclave and at least one Ruinstorm Soul-Forge Engine or Daemon Behemoth.
• Every eligible unit in the Detachment must purchase the Malevolent Artifice Ætheric Blessing.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Maw of Annihilation (Ravenous Dissolution)" hidden="false" id="4231-4f2b-7b00-7fde">
              <modifiers>
                <modifier type="set" field="hidden" value="true">
                  <conditions>
                    <condition type="lessThan" value="1" field="selections" scope="force" childId="945c-b969-75eb-19d9" shared="true" includeChildSelections="true" includeChildForces="false" percentValue="false"/>
