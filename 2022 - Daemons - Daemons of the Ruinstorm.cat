            <modifier type="set" field="name" value="Hatred (Sanguinius)"/>
          </modifiers>
        </infoLink>
        <infoLink id="bdd1-ccfb-797d-413e" name="It Will Not Die (X)" hidden="false" targetId="2784-d0be-a4e2-890f" type="rule">
