    <selectionEntry type="upgrade" import="true" name="Jetbikes and Engines" hidden="false" id="13ab-a001-2ce8-222d" publicationId="307a-4562-12d7-0868">
      <profiles>
        <profile name="Jetbikes and Engines" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="17a2-6d9e-68c7-6c37">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3" />
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Skyweaver Jetbike" hidden="false" id="fd62-e8a6-495b-e7ce" publicationId="307a-4562-12d7-0868">
      <profiles>
        <profile name="Skyweaver Jetbike" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="3c5c-5301-8d14-8464">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model with a Skyweaver Jetbike becomes Cavalry (Antigrav), M 18 and gains Battle-Hardened (1), Deep Strike, Firing Protocols (2), Fleet (2), Hammer of Wrath (1), Hit &amp; Run, Relentless, Shrouded (5+). The model keeps any other Unit Sub-types it had.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Starweaver Skimmer" hidden="false" id="ad7a-65f5-3c06-bde1" publicationId="307a-4562-12d7-0868">
      <profiles>
        <profile name="Starweaver Skimmer" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="3ccb-3072-0acd-7616">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model with a Starweaver Skimmer becomes Cavalry (Antigrav), M 16, 3+ Armour Save and gains Deep Strike, Firing Protocols (2), Fleet (2), Hammer of Wrath (1), Hit &amp; Run, Relentless, Shrouded (5+). The model keeps any other Unit Sub-types it had.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Flip Belt" hidden="false" id="9d75-0651-5fba-6e5d" publicationId="307a-4562-12d7-0868">
      <profiles>
        <profile name="Flip Belt" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="c181-4bd2-ea42-8e17">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A unit made up entirely of models with Flip Belts may ignore terrain and intervening friendly units while moving, including Charges, Fall Back moves, Advancing, and Reactions. It still takes Dangerous Terrain tests when beginning or ending in it, but ignores Difficult Terrain entirely.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Mirage Launchers" hidden="false" id="9bd4-4b8d-6e75-26c3" publicationId="307a-4562-12d7-0868">
      <profiles>
        <profile name="Mirage Launchers" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="e53b-da7a-3f12-a4a5">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">When a unit made up entirely of models with Mirage Launchers is targeted by a Shooting Attack, the range counts as 6" further than it is. Primarchs ignore this. Barrage attacks against the unit always scatter as though it were out of line of sight.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Plasma Grenades" hidden="false" id="279f-8d6e-445f-96e9" publicationId="307a-4562-12d7-0868">
      <profiles>
        <profile name="Plasma Grenades" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="1624-6f0c-ed6b-29ba">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A unit with Plasma Grenades attacks at its normal Initiative after Charging through Difficult or Dangerous Terrain, but still suffers the Charge roll penalties. In the Assault phase, a model with Plasma Grenades engaged with a Building, Fortification, Vehicle, Dreadnought, or Automata may instead inflict one automatic Str 5, AP 4 Hit with Breaching (6+) at Initiative step 1. If it does, the unit Piles In at Initiative 1, and that model may not otherwise attack or use other Hit- or Wound-inflicting rules or wargear that phase (it may still Sweeping Advance).</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="c7bd-d307-210f-2da8" name="Plasma grenades" hidden="false" targetId="efc2-e504-e7c0-a0d9" type="profile" />
      </infoLinks>
      <entryLinks>
        <entryLink import="true" name="Plasma grenades" hidden="false" id="53dc-e04d-6512-73dc" type="selectionEntry" targetId="87e2-ed95-679a-bb7e">
