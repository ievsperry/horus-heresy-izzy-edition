            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="fb3d-1434-91b9-4c78" percentValue="false" includeChildSelections="false" includeChildForces="false" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0451-f96e-7cac-fc3a" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
        </entryLink>
      </entryLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="The Mask of Many Faces" hidden="false" id="4d2a-0ed9-379b-20ab" publicationId="307a-4562-12d7-0868">
      <profiles>
        <profile name="The Mask of Many Faces" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="6654-aa6e-75e2-b6a0">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A unit with a model equipped with The Mask of Many Faces adds +2 to its Wounds score for winning combat.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="The Thirsting Mask" hidden="false" id="4304-b9e8-a589-9813" publicationId="307a-4562-12d7-0868">
      <profiles>
        <profile name="The Thirsting Mask" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="d42f-652d-86e3-8715">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The model has Preferred Enemy (Daemons, Corrupted).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Veil of Tears" hidden="false" id="b0aa-4f36-fcd5-426d" publicationId="307a-4562-12d7-0868">
      <profiles>
        <profile name="Veil of Tears" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="b6e3-4040-bebd-80bc">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">*A wave of sorrow and guilt forces the Shadowseer's targets to turn their faces aside.* At any point in the Controlling Player's Movement phase, select a single enemy unit within 24" and line of sight. Until the beginning of the Controlling Player's next turn, it may not make Shooting Attacks over 18" against units made up entirely of Rillietann models. The Psyker may choose to take a Psychic check: if passed, the target also may not make Reactions against Rillietann-only units until the end of the opposing player's next turn; if failed, no effects apply and the Psyker suffers Perils of the Warp.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
