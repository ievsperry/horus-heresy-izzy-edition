        <selectionEntry type="upgrade" import="true" name="Strategist" hidden="true" id="b001-c4ee-7b2c-f457" publicationId="c336-0f01-71db-7a8f">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="4ea9-9fe2-fbc0-0691" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="96ca-9c33-2c30-3da2" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Strategist" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="a57f-d37a-2432-c5a6">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">While a Warlord with this Trait is alive (including while in Reserves), the controlling player may re-roll one Reserves roll per turn. In addition, an army whose Warlord has this Trait may make one additional Reaction during the opposing player's Movement phase, as long as the Warlord has not been removed as a casualty.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="3ae4-70f8-18fd-2d04" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Stalwart" hidden="true" id="8afa-7989-3a47-c297" publicationId="c336-0f01-71db-7a8f">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="2e6e-bafb-e46b-2bd7" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1730-90c3-e144-1147" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Stalwart" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="d16d-fd83-75e0-0fee">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">A Warlord with this Trait, and any unit he joins, gains the Feel No Pain (5+) special rule. In addition, an army whose Warlord has this Trait may make one additional Reaction during the opposing player's Assault phase, as long as the Warlord has not been removed as a casualty.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
