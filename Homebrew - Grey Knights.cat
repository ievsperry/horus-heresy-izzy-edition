      <categoryLinks>
        <categoryLink targetId="36c3-e85e-97cc-c503" id="c437-2a43-a102-f820" primary="false" name="Unit:" />
      </categoryLinks>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Brother-Captain" hidden="false" id="7e7c-0907-c6ee-b9f0" publicationId="c336-0f01-71db-7a8f">
