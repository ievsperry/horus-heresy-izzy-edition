  <sharedSelectionEntryGroups>
    <selectionEntryGroup name="Warlord Traits" hidden="false" id="cc20-5c75-ba1b-13e5">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="239c-9703-d132-191d" percentValue="false" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Daemonslayer" hidden="false" id="fe49-81df-410c-fe79" publicationId="c336-0f01-71db-7a8f">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3671-4e0d-6f42-bf01" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Daemonslayer" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="1af6-4c63-4c9f-9559">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">All Melee attacks made by the Warlord against models with the Daemon, Corrupted, Corrupted Engine, or Malefic Unit Type or Sub-type gain the Murderous Strike (4+) special rule. In addition, an army whose Warlord has this Trait may make one additional Reaction during the opposing player's Assault phase, as long as the Warlord has not been removed as a casualty.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="7347-782f-d30a-03f4" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Nemesis Lord" hidden="false" id="837a-75bd-6d92-223f" publicationId="c336-0f01-71db-7a8f">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d2ae-6a7e-0426-be75" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Nemesis Lord" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="686e-be34-6b76-9db2">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord may select one additional Minor Psychic Power at the start of the battle, and adds +1 to his Leadership Characteristic when making Psychic checks (to a maximum of 10). In addition, an army whose Warlord has this Trait may make one additional Reaction during the opposing player's Shooting phase, as long as the Warlord has not been removed as a casualty.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="c1aa-c904-9c56-c206" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Unyielding Will" hidden="false" id="a05c-e7f7-cd6a-0147" publicationId="c336-0f01-71db-7a8f">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="81f2-e299-aa06-c839" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Unyielding Will" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="1123-e585-154d-479d">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">Friendly units composed entirely of models with the Legiones Astartes (Grey Knights) special rule within 12" of the Warlord may re-roll failed Psychic checks once per phase. In addition, an army whose Warlord has this Trait may make one additional Reaction during the opposing player's Movement phase, as long as the Warlord has not been removed as a casualty.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="b9be-4f48-9e6a-d601" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="First Among Equals" hidden="true" id="7aaa-c54f-8ba0-ca18" publicationId="c336-0f01-71db-7a8f">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="5202-bcdf-02a3-8556" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4997-2559-1d28-cd29" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="First Among Equals" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="e8a1-1de2-660c-8b38">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">A Warlord with this Trait, and any unit he joins, gains the Rage (2) special rule. In addition, an army whose Warlord has this Trait may make one additional Reaction during the opposing player's Assault phase, as long as the Warlord has not been removed as a casualty.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="cb8e-e9a3-d641-fa55" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Unstoppable Champion" hidden="true" id="9dc4-0c3c-0140-d896" publicationId="c336-0f01-71db-7a8f">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="6f09-ea43-f142-d3b7" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="cc40-51e3-a0e9-2009" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Unstoppable Champion" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="4e68-47e2-6aa8-5bfe">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">All Melee weapons wielded by a Warlord with this Trait gain the Rending (6+) special rule (or improve an existing Rending value by 1, to a maximum of 4+). In addition, an army whose Warlord has this Trait may make one additional Reaction during the opposing player's Assault phase, as long as the Warlord has not been removed as a casualty.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="b6e2-b210-1350-08c5" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Master of Wards" hidden="true" id="28fe-83f0-4855-98e2" publicationId="c336-0f01-71db-7a8f">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="e3dc-675b-97c4-3550" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0439-d9e3-0911-138d" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Master of Wards" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="4290-3cbb-1ad5-16fd">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">A Warlord with this Trait may select one additional Minor Psychic Power at the start of the battle. In addition, an army whose Warlord has this Trait may make one additional Reaction during the opposing player's Shooting phase, as long as the Warlord has not been removed as a casualty.</characteristic>
              </characteristics>
            </profile>
