      <rules>
        <rule name="Psychic Discipline" id="ed5e-d7b8-9dc2-1608" hidden="false">
          <description>Dominus, Sanctic, Anathemata, Divination or Telepathy</description>
        </rule>
        <rule name="Unbroken Line" id="cb58-5492-e695-2852" hidden="false">
          <description>While Epimetheus is on the battlefield, any unit he joins gains the Heart of the Legion special rule and reduces the Strength Characteristic of all incoming Shooting Attacks targeting it by 1 (to a minimum of 1)</description>
        </rule>
        <rule name="Warlord" id="8fc6-2216-8906-00a9" hidden="false">
          <description>Stalwart</description>
        </rule>
      </rules>
