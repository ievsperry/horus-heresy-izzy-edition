<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="4b64-b0f5-2138-7dbe" name="Homebrew - Grey Knights" revision="12" battleScribeVersion="2.03" library="false" gameSystemId="28d4-bd2e-4858-ece6" gameSystemRevision="130" type="catalogue" authorName="Isaac">
  <publications>
    <publication id="c336-0f01-71db-7a8f" name="Grey Knights for The Horus Heresy 2.0 — Homebrew Conversion" shortName="HB - Grey Knights" />
  </publications>
  <selectionEntries>
    <selectionEntry type="upgrade" import="true" name="Grey Knights" hidden="false" id="fa33-cf16-cc44-f9c7" publicationId="c336-0f01-71db-7a8f">
      <constraints>
        <constraint type="min" value="1" field="selections" scope="force" shared="true" id="518b-5131-62ea-5937" percentValue="false" includeChildSelections="true" includeChildForces="false" />
        <constraint type="max" value="1" field="selections" scope="force" shared="true" id="7942-3fc4-1d05-bcf9" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile name="Psychic Ward" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="a6a8-1a04-a436-a846">
          <characteristics>
            <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Grey Knights unit is selected as the target of a Shooting Attack or a psychic weapon. Before the attack is resolved, the unit casts Sanctuary on itself (taking a Psychic check as normal).</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink targetId="e90d-e5a8-f42d-da84" id="1b5b-6b8f-fb45-4c7a" primary="true" name="Allegiance:" />
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Brotherhood" hidden="false" id="8cf7-353a-16f4-2b4d">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="1fba-d0e9-b1ee-907d" percentValue="false" includeChildSelections="false" includeChildForces="false" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f05b-d818-1457-8ae2" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="1st Brotherhood, the Swordbearers" hidden="false" id="5202-bcdf-02a3-8556" publicationId="c336-0f01-71db-7a8f">
              <profiles>
                <profile name="Blades Drawn" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="b54e-eaa7-8bc1-cc27">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: an enemy unit declares a charge against a 1st Brotherhood unit. Instead of firing Overwatch, the unit gains Counter-Charge (1) until the end of the phase†.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Unwavering" id="48cd-6af7-8fb1-3a2f" hidden="false">
                  <description>the unit has a Leadership of 10.</description>
                </rule>
                <rule name="Vanguard of the Chapter" id="a8fd-c6c2-1c37-1108" hidden="false">
                  <description>the unit adds 1 to its Attacks in a turn in which it charged.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="2nd Brotherhood, the Blades of Victory" hidden="false" id="6f09-ea43-f142-d3b7" publicationId="c336-0f01-71db-7a8f">
              <profiles>
                <profile name="Riposte" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="bc08-0685-f23c-091a">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: an enemy unit declares a charge against a 2nd Brotherhood unit. In the following combat, the unit strikes first this phase regardless of Initiative†.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Blade Mastery" id="be8b-2716-e542-2469" hidden="false">
                  <description>the unit may re-roll to-hit rolls of 1 in close combat.</description>
                </rule>
                <rule name="Lightning Reflexes" id="ad46-d40b-cd0a-7da5" hidden="false">
                  <description>the unit adds 1 to its Initiative.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="3rd Brotherhood, the Wardmakers" hidden="false" id="e3dc-675b-97c4-3550" publicationId="c336-0f01-71db-7a8f">
              <profiles>
                <profile name="Ward of the Brotherhood" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="4863-dd64-74f0-a082">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a 3rd Brotherhood unit is selected as the target of a Shooting Attack. Against that attack, the unit gains a 5+ Invulnerable Save, or improves an existing one by 1.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Psychic Discipline" id="3b5b-defa-e6a8-a68f" hidden="false">
                  <description>once per phase, the unit may re-roll a failed Psychic check.</description>
                </rule>
                <rule name="Searing Wards" id="e793-cbd6-5948-15d1" hidden="false">
                  <description>the unit's Purge Soul and Vortex of Doom gain Shred.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="4th Brotherhood, the Rapiers" hidden="false" id="4ea9-9fe2-fbc0-0691" publicationId="c336-0f01-71db-7a8f">
              <profiles>
                <profile name="Covering Bolters" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="e915-16c3-28f4-08eb">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a 4th Brotherhood unit is selected as the target of a Shooting Attack. Another friendly Grey Knights unit within 6" of the target makes a Return Fire Shooting Attack against the attacker.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Rapier Volleys" id="1df5-54ae-0ba6-2672" hidden="false">
                  <description>the unit's storm bolters gain Breaching (6+).</description>
                </rule>
                <rule name="Steady Aim" id="83ae-17de-0bc4-517a" hidden="false">
                  <description>the unit may re-roll to-hit rolls of 1 with ranged weapons.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="5th Brotherhood, the Preservers" hidden="false" id="2e6e-bafb-e46b-2bd7" publicationId="c336-0f01-71db-7a8f">
              <profiles>
                <profile name="Unyielding Anvil" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="a7b9-901e-a231-db25">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: an enemy unit declares a charge against a 5th Brotherhood unit. The charging unit subtracts D3 from its charge distance.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Stoic Defenders" id="edc1-fbdb-b61a-67a9" hidden="false">
                  <description>the unit has Feel No Pain (6+).</description>
                </rule>
                <rule name="Unbreakable" id="6c28-d7c6-e688-f231" hidden="false">
                  <description>the unit cannot be Pinned.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="6th Brotherhood, the Exactors" hidden="false" id="b120-1048-c1d9-cbcf" publicationId="c336-0f01-71db-7a8f">
              <profiles>
                <profile name="Swift Retribution" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="98f4-4479-9d7d-6a29">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Movement phase). Trigger: an enemy unit ends a move within 12" of a 6th Brotherhood unit. The unit makes a Shooting Attack against the triggering unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Relentless Pursuit" id="4c98-832c-5851-e993" hidden="false">
                  <description>the unit may re-roll to-wound rolls of 1 against Daemons and psykers.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="7th Brotherhood, the Prescient Brethren" hidden="false" id="f16c-9704-f63a-b015" publicationId="c336-0f01-71db-7a8f">
              <profiles>
                <profile name="Foresight" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="13bc-80be-0ef7-d3a9">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Movement phase). Trigger: an enemy unit ends a move within 12" of a 7th Brotherhood unit. The unit moves up to D6 plus its Initiative Characteristic in inches.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Foreseen Arrival" id="74a7-5b68-5ba8-07ab" hidden="false">
                  <description>add 1 to Reserves rolls for the unit.</description>
                </rule>
                <rule name="Perfect Teleport" id="f6cd-2c12-6b74-a097" hidden="false">
                  <description>the unit's Teleport Strike never scatters.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="8th Brotherhood, the Purifiers" hidden="false" id="fcdf-96a7-d7bc-2110" publicationId="c336-0f01-71db-7a8f">
              <profiles>
                <profile name="Cleansing Flame" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="28ec-7a7f-9b65-a6c7">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: an enemy unit declares a charge against an 8th Brotherhood unit. The unit fires Overwatch with Purifying Flame, at full Ballistic Skill.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Cleansing Flame" id="9d23-044c-031b-60d2" hidden="false">
                  <description>every unit knows the Purifying Flame psychic weapon.</description>
                </rule>
                <rule name="Purity of Purpose" id="ea7c-d2e5-ad91-1ce1" hidden="false">
                  <description>the unit has Hatred (Everything).</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Rite of War" hidden="false" id="8c9d-79be-6114-e4ac">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4892-bff8-3f98-89ac" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Nemesis Strike" hidden="false" id="4a3b-8958-41eb-9b28" publicationId="c336-0f01-71db-7a8f">
              <modifiers>
                <modifier type="set" field="ae9d-2706-6eac-8d79" value="0">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="c658-dc6b-727b-c488" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ae9d-2706-6eac-8d79" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule name="Effects" id="89ff-12c4-64f1-c513" hidden="false">
                  <description>Nemesis Dreadknights may be taken as Elites as well as Heavy Support.</description>
                </rule>
                <rule name="Limitations" id="ae07-680a-799d-8544" hidden="false">
                  <description>Requires a Grand Master in Nemesis Dreadknight as Warlord.   no Lords of War, and Troops must outnumber Dreadknights.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="7095-e817-db2a-c929" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Paladin Retinue" hidden="false" id="375b-d942-3927-3c58" publicationId="c336-0f01-71db-7a8f">
              <modifiers>
                <modifier type="set" field="b872-f0df-ae5d-d810" value="0">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="952b-1b89-5991-8ab9" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b872-f0df-ae5d-d810" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule name="Effects" id="c6f8-bae6-36e0-7011" hidden="false">
                  <description>Paladin Squads may be taken as Troops and gain the Line sub-type.</description>
                </rule>
                <rule name="Limitations" id="accd-88f7-a35d-6049" hidden="false">
                  <description>Requires a Grand Master or Kaldor Draigo as Warlord.   no Strike Squads.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="0cd1-795b-e397-7e85" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Purifier Crusade" hidden="false" id="0c08-5cd5-0cae-3c97" publicationId="c336-0f01-71db-7a8f">
              <modifiers>
                <modifier type="set" field="4f7f-795b-35b0-5745" value="0">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="5201-a352-e828-7459" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
                <modifier type="set" field="d579-e18f-8852-5fef" value="0">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="1ae5-f2f4-f0eb-de51" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
                <modifier type="set" field="8dde-1ab8-7b53-081e" value="0">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="2c3e-4d65-b5a4-847f" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4f7f-795b-35b0-5745" percentValue="false" includeChildSelections="false" includeChildForces="false" />
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d579-e18f-8852-5fef" percentValue="false" includeChildSelections="false" includeChildForces="false" />
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8dde-1ab8-7b53-081e" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule name="Effects" id="70bb-d0e6-6d34-8c71" hidden="false">
                  <description>Purifier Squads may be taken as Troops and gain the Line sub-type.</description>
                </rule>
                <rule name="Limitations" id="8161-6bd3-d160-b5fc" hidden="false">
                  <description>Requires Castellan Crowe or a Brother-Captain as Warlord.   no Nemesis Dreadknights or Land Raiders.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="ba50-e529-ac78-ce2f" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Teleport Assault" hidden="false" id="237f-cee9-50aa-c5e1" publicationId="c336-0f01-71db-7a8f">
              <rules>
                <rule name="Effects" id="ff6b-31e3-0965-9e06" hidden="false">
                  <description>every unit in Aegis Terminator armour may arrive by Deep Strike from the first game turn.</description>
                </rule>
                <rule name="Limitations" id="7aa8-f61d-7d32-1ccc" hidden="false">
                  <description>Requires a Grand Master or Kaldor Draigo as Warlord.   no Dedicated Transports, and at least half the army must start in Reserves.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="a3b3-4a7a-7444-2e86" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
      </costs>
    </selectionEntry>
  </selectionEntries>
