      <rules>
        <rule name="Aegis Conduit" id="cfd6-ad21-7ccf-a21c" hidden="false">
          <description>Friendly units composed entirely of models with the Legiones Astartes (Grey Knights) special rule within 12" of Iapto improve their Adamantium Will roll by +1 (to a maximum of 2+)</description>
        </rule>
        <rule name="Psychic Discipline" id="50da-bbbd-58ca-0d11" hidden="false">
          <description>Dominus, Sanctic, Anathemata, Divination or Telepathy</description>
        </rule>
        <rule name="Warlord" id="a4dc-9028-2991-52ea" hidden="false">
          <description>Master of Wards</description>
        </rule>
      </rules>
