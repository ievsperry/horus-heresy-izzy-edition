    <selectionEntry type="upgrade" import="true" name="Aegis Terminator Armour" hidden="false" id="a03b-838f-f694-0bf9" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Aegis Terminator Armour" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="d4cb-87ee-5458-be64">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Terminator plate inscribed with wards and hexagrammic sigils, proof against both bolt and sorcery.* A model in Aegis Terminator armour has a 2+ Armour Save, a 5+ Invulnerable Save and Bulky (2), and may not Advance.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="8b11-0ab5-260c-2c6a" hidden="false" targetId="2e5e-c3f1-d335-9842" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (5+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Brotherhood Banner" hidden="false" id="f454-f2a0-ba78-0824" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Brotherhood Banner" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="5dbd-37f3-8135-b400">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A sacred standard of the Brotherhood, carried into battle by its most honoured Paladin.* As the bearer's datasheet states.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Narthecium" hidden="false" id="5148-a235-9bc1-829e" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Narthecium" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="eaea-81ac-7c4c-728b">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*The Apothecary's medical gauntlet.* The unit the bearer joins has Feel No Pain (5+).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Personal Teleporter" hidden="false" id="249a-4293-2dcf-c69f" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Personal Teleporter" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="f260-d6dc-292d-4ee9">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A short-ranged teleporter that lets an Interceptor blink across the battlefield.* A personal teleporter counts as a jump pack, using the official 2.0 Jump Pack rules.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Psyk-out Grenades" hidden="false" id="4a00-51ea-e844-4d6e" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Psyk-out Grenades" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="65f4-ed8d-4e67-439b">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Grenades filled with dust ground from a null-crystal, agonising to psykers and daemons.* Psyk-out grenades count as frag grenades. In addition, enemy psykers and Daemons charged by the bearer's unit, or charging it, do not gain the Initiative bonus for charging†.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Rosarius" hidden="false" id="ac93-901c-00ae-41ab" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Rosarius" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="e972-1d8a-b83d-41cb">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*An amulet that projects a protective conversion field.* A model with a rosarius has a 4+ Invulnerable Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="60fa-8fc7-780c-4eca" hidden="false" targetId="2e5e-c3f1-d335-9842" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (4+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Teleport Harness" hidden="false" id="9f80-7aed-1501-2482" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Teleport Harness" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="3550-07d1-8716-87c9">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A heavy teleport array that lets a Dreadnought or Dreadknight strike from orbit.* The model has the Deep Strike special rule.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Deep Strike" id="b9a2-fb40-fdc0-b12f" hidden="false" targetId="f1e1-986f-c783-ca9e" type="rule" />
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="The Shield of Titan" hidden="false" id="37ef-3b06-9e51-b187" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="The Shield of Titan" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="ba9b-ccaa-e551-e0b3">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*The ancient storm shield carried by the Supreme Grand Master.* Kaldor Draigo has Feel No Pain (5+).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Astral Aim" hidden="false" id="222a-1316-e919-7bcf" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Astral Aim" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="bb2c-0f95-61ca-2f43">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">Shooting (start) phase. The unit's ranged weapons may target units out of line of sight, and the targets gain no cover saves†</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Banishment" hidden="false" id="6f14-795a-1558-ca24" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Banishment" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="1ca4-5cf6-db4a-5cd4">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">Shooting phase. One enemy Daemon unit within 24" loses its Invulnerable Save until the end of the turn</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Gate of Infinity" hidden="false" id="e3f5-ce26-1c80-e99a" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Gate of Infinity" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="2129-493f-b7d6-418d">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">Movement (start) phase. Remove the unit and place it anywhere on the battlefield, as though arriving by Deep Strike</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Hammerhand" hidden="false" id="0f81-f1f1-f06a-5ef5" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Hammerhand" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="1d22-125e-f4ec-cd91">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">Assault (start) phase. The unit adds 1 to its Strength in close combat until the end of the phase</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Sanctuary" hidden="false" id="c5d1-c9bf-8767-f964" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Sanctuary" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="28fc-39b3-d00c-070b">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">Movement (start) phase. The unit gains a 5+ Invulnerable Save (or improves an existing one by 1, to a best of 3+) until your next turn</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Brother-Captain" hidden="false" id="c3e9-f8e5-dff7-3250" publicationId="c336-0f01-71db-7a8f">
      <rules>
        <rule name="Brotherhood Leader" id="9f73-8970-c71e-46d9" hidden="false">
          <description>Friendly Grey Knights units within 12" may use his Leadership</description>
        </rule>
      </rules>
