    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Purifying Flame" hidden="false" id="6217-7693-ed78-e47d" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Purifying Flame" typeId="cede-0217-1b10-2a34" typeName="Psychic Weapon" hidden="false" id="aeb7-fa96-e29c-1166" publicationId="c336-0f01-71db-7a8f">
          <characteristics>
            <characteristic name="Range" typeId="62ec-fbf5-5252-0d17">Template</characteristic>
            <characteristic name="Strength" typeId="17ff-12e7-77d3-2fbe">5</characteristic>
            <characteristic name="AP" typeId="f431-a7b9-d9d0-36c9">4</characteristic>
            <characteristic name="Type" typeId="2159-62b6-4337-d516">Assault 1, Deflagrate, Torrent (6"), Psychic Focus, Nemesis Force</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Deflagrate" id="44b5-b1cc-8cd5-f5b2" hidden="false" targetId="60bc-f79a-67ae-be4f" type="rule" />
        <infoLink name="Torrent (X)" id="825b-2ddf-a12f-a491" hidden="false" targetId="5cfb-fc94-e6db-43b8" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Torrent (6&quot;)" />
          </modifiers>
        </infoLink>
        <infoLink name="Nemesis Force" id="e393-a0bd-2456-a7cd" hidden="false" targetId="c4fb-6217-c3b3-5be9" type="rule" />
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Void darts" hidden="false" id="ff20-f8fa-f4ea-7094" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Void darts" typeId="cede-0217-1b10-2a34" typeName="Psychic Weapon" hidden="false" id="5575-5a21-e9fe-fe51" publicationId="c336-0f01-71db-7a8f">
          <characteristics>
            <characteristic name="Range" typeId="62ec-fbf5-5252-0d17">18"</characteristic>
            <characteristic name="Strength" typeId="17ff-12e7-77d3-2fbe">5</characteristic>
            <characteristic name="AP" typeId="f431-a7b9-d9d0-36c9">4</characteristic>
            <characteristic name="Type" typeId="2159-62b6-4337-d516">Assault 12, Sanctic, Deflagrate, Psychic Focus</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Sanctic" id="7760-a6df-e279-d154" hidden="false" targetId="d1c9-ee74-4e4f-8830" type="rule" />
        <infoLink name="Deflagrate" id="362b-b9b3-8083-e753" hidden="false" targetId="60bc-f79a-67ae-be4f" type="rule" />
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Diviner's Dart" hidden="false" id="9b9e-59c4-fb29-a5d1" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Diviner's Dart" typeId="cede-0217-1b10-2a34" typeName="Psychic Weapon" hidden="false" id="ba44-0ae7-db69-bcef" publicationId="c336-0f01-71db-7a8f">
          <characteristics>
            <characteristic name="Range" typeId="62ec-fbf5-5252-0d17">18"</characteristic>
            <characteristic name="Strength" typeId="17ff-12e7-77d3-2fbe">6</characteristic>
            <characteristic name="AP" typeId="f431-a7b9-d9d0-36c9">2</characteristic>
            <characteristic name="Type" typeId="2159-62b6-4337-d516">Assault 1, Sniper, Guided Fire, Psychic Focus</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Sniper" id="60e6-adf4-2176-af7d" hidden="false" targetId="9cd8-e726-5dbe-b106" type="rule" />
        <infoLink name="Guided Fire" id="30b4-46ae-136e-b0cd" hidden="false" targetId="fa1e-0112-943e-b1f6" type="rule" />
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Telepathic Hallucinations" hidden="false" id="53ad-70d7-deaf-ab14" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Telepathic Hallucinations" typeId="cede-0217-1b10-2a34" typeName="Psychic Weapon" hidden="false" id="e2d7-9ab4-0c29-f1b3" publicationId="c336-0f01-71db-7a8f">
          <characteristics>
            <characteristic name="Range" typeId="62ec-fbf5-5252-0d17">36"</characteristic>
            <characteristic name="Strength" typeId="17ff-12e7-77d3-2fbe">-</characteristic>
            <characteristic name="AP" typeId="f431-a7b9-d9d0-36c9">-</characteristic>
            <characteristic name="Type" typeId="2159-62b6-4337-d516">Assault 6, Hallucinations, Psychic Focus</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Astral Aim" hidden="false" id="b6d3-57d1-fa45-ad91" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Astral Aim" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="9d7b-812a-9a48-c141">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Astral Aim may be activated at the start of any Shooting Phase. If the Psychic Check is successful, all ranged weapons in the unit gain Indirect Fire and Ignores Cover. In addition, all Psi-weapons carried by models in the unit gain +6" Range. Any Incinerator or Heavy Incinerator carried by models in the unit gains Torrent (6").</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Cleansing Flame" hidden="false" id="9ce2-c38f-5f7b-a65a" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Cleansing Flame" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="668d-afde-0d6a-a497">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Cleansing Flame may be activated at the start of any Assault Phase. If the Psychic Check is successful, every enemy unit within 6" of one or more models from the affected unit immediately suffers D6 Strength 3 AP - hits with Rending (6+). Against models with the Daemon Unit Type, these attacks instead gain Rending (4+). These hits are resolved immediately.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Gates of Infinity" hidden="false" id="22c0-2463-d374-b556" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Gates of Infinity" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="ca11-3b33-04b2-84b5">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A unit containing one or more models with this Psychic Power may use it during its Movement phase instead of moving normally. If successfully manifested, the unit may immediately make a move of up to 12". This movement ignores all terrain, intervening models and obstacles, but may not end within 1" of an enemy model. A unit that uses this Psychic Power may Shoot, Run and Charge normally during the same turn. A unit may not use Gates of Infinity while Falling Back or Pinned.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Hammerhand" hidden="false" id="a701-c3a9-39a7-d9ad" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Hammerhand" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="de41-3591-ec86-b7c4">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Hammerhand may be activated at the start of any Assault Phase. If the Psychic Check is successful, all models in the unit gain Furious Charge (2) and Rage (2) until the end of the current Phase.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Holocaust" hidden="false" id="b955-244c-5ccb-dfc4" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Holocaust" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="7a8f-3dcf-bff1-c233">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Holocaust may be activated at the start of any Assault Phase. If the Psychic Check is successful, all models in the unit gain Hammer of Wrath (3) until the end of the current Phase. Against models with the Daemon Unit Type, these Hammer of Wrath attacks are resolved at AP2.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Warp Quake" hidden="false" id="207a-cf13-95ef-b63a" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Warp Quake" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="24c6-2f8e-eb0e-a69c">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Warp Quake may be activated at the start of any Movement Phase. If the Psychic Check is successful, the unit gains Fleet (2) and Sudden Strike (2) until the end of the current turn. In addition, the unit may declare a Charge during a turn in which it Ran.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Warp Shroud" hidden="false" id="b5be-87ca-e330-404d" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Warp Shroud" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="c3aa-ac7e-74f5-809e">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Warp Shroud may be activated at the start of any Movement Phase. If the Psychic Check is successful, the unit gains Shrouded (5+) until the start of its controlling player's next turn. In addition, enemy units treat the affected unit as being 6" further away than it actually is when determining weapon range, the effects of Special Rules, and whether a model is within a specified distance. Enemy units declaring a Charge against the affected unit subtract 2" from their Charge Roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Aegis Artificer Armour" hidden="false" id="7d4c-f5dd-2a3e-7862" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Aegis Artificer Armour" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="97ed-ad4b-c36e-135f">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model equipped with Aegis Artificer armour gains a 2+ Armour Save. Models may also Run, even if they have the Heavy sub-type, but their Initiative is still calculated at -1.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Aegis-Cataphractii Terminator Armour" hidden="false" id="b9c4-b4a4-1bbb-5494" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Aegis-Cataphractii Terminator Armour" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="9377-19a3-da88-832f">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A rare, heavily modified variant of the Cataphractii pattern maintained exclusively by the armourers of Titan, incorporating sanctified silvered ceramite and psychically attuned shield capacitors.* A model equipped with Aegis-Cataphractii Terminator Armour has a 2+ Armour Save and a 4+ Invulnerable Save, and gains the Adamantium Will (3+), Relentless and Shrouded (6+) special rules and the Heavy Unit Sub-type. A model equipped with Aegis-Cataphractii Terminator Armour may not make Run moves in the Shooting phase, nor may it make Sweeping Advances in the Assault phase.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Adamantium Will (X+)" id="9ba6-973e-56ae-8c00" hidden="false" targetId="4380-44a5-f01a-d964" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Adamantium Will (3+), Relentless and Shrouded (6+)" />
          </modifiers>
        </infoLink>
        <infoLink name="Invulnerable Save (X)" id="90a2-f429-14ca-702c" hidden="false" targetId="2e5e-c3f1-d335-9842" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (4+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Aegis Dreadknight Armour" hidden="false" id="8776-fc3a-9655-a9c4" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Aegis Dreadknight Armour" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="7b5c-725c-38fe-de35">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model equipped with Aegis Dreadknight armour has a 2+ Armour Save and a 5+ Invulnerable Save. Models equipped with Aegis Dreadknight armour gain the Bulky (6) special rule. Models may also Run, even if they have the Heavy sub-type, but their Initiative is still calculated at -1. In addition, any Adamantium Will save it possesses is improved to Adamantium Will (4+).</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="0eb9-6d49-a167-fbf7" hidden="false" targetId="2e5e-c3f1-d335-9842" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (5+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Aegis Power Armour" hidden="false" id="71a4-2e39-de00-cd94" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Aegis Power Armour" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="e9ae-7ea4-db41-908f">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model equipped with Aegis Power armour gains a 3+ Armour Save. Models may also Run, even if they have the Heavy sub-type, but their Initiative is still calculated at -1.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Aegis Tartaros Armour" hidden="false" id="8bf8-4bc1-fb1a-cd63" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Aegis Tartaros Armour" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="7cd8-5674-c7af-98aa">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Aegis Tartaros armour provides a 2+ Armour Save and a 5+ Invulnerable Save. Models equipped with Aegis Tartaros armour gain the Bulky (2) and Shrouded (5+) special rules. Unlike models equipped with Aegis Terminator armour, models wearing Aegis Tartaros armour do not have the Heavy sub-type and may make Reactions, Sweeping Advances, Runs and Charges normally. A model equipped with Aegis Tartaros armour may not embark upon any Transport that prohibits models with the Bulky (2) special rule.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="d0e4-e9a0-3e39-6320" hidden="false" targetId="2e5e-c3f1-d335-9842" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (5+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Aegis Terminator Armour" hidden="false" id="a03b-838f-f694-0bf9" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Aegis Terminator Armour" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="d4cb-87ee-5458-be64">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Terminator plate inscribed with wards and hexagrammic sigils, proof against both bolt and sorcery.* A model equipped with Aegis Terminator armour has a 2+ Armour Save and a 5+ Invulnerable Save. Models equipped with Aegis Terminator armour gain the Bulky (2) special rule. Models may also Run, even if they have the Heavy sub-type, but their Initiative is still calculated at -1. In addition, any Adamantium Will save it possesses is improved to Adamantium Will (4+).</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="8b11-0ab5-260c-2c6a" hidden="false" targetId="2e5e-c3f1-d335-9842" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (5+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Brotherhood Banner" hidden="false" id="f454-f2a0-ba78-0824" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Brotherhood Banner" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="5dbd-37f3-8135-b400">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A sacred standard of the Brotherhood, carried into battle by its most honoured Paladin.* As the bearer's datasheet states.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Icon of Justice" hidden="false" id="439a-4ddc-a6d7-7c30" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Icon of Justice" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="d45c-fa8d-de70-8bdf">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model equipped with an Icon of Justice gains a 5+ Invulnerable Save. If the model already has an Invulnerable Save, improve the value of its Invulnerable Save by 1, to a maximum of 4+.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="30da-aea6-d95f-75ef" hidden="false" targetId="2e5e-c3f1-d335-9842" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (5+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Narthecium" hidden="false" id="5148-a235-9bc1-829e" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Narthecium" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="eaea-81ac-7c4c-728b">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*The Apothecary's medical gauntlet.* A unit that includes one or more models equipped with a Narthecium gains Feel No Pain (5+) and It Will Not Die (6+).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Paladin Banner" hidden="false" id="5709-eb7e-fdce-d187" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Paladin Banner" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="0c67-b6de-2b1f-7632">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A unit that includes one or more models equipped with a Paladin Banner gains the Line Unit Sub-type. Friendly units with the Legiones Astartes (Grey Knights) special rule within 12" of one or more models equipped with a Paladin Banner may re-roll failed Morale Checks and Pinning Checks. In addition, a unit that includes one or more models equipped with a Paladin Banner adds +1 to its Combat Resolution score.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Personal Teleporter" hidden="false" id="249a-4293-2dcf-c69f" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Personal Teleporter" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="f260-d6dc-292d-4ee9">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A short-ranged teleporter that lets an Interceptor blink across the battlefield.* A personal teleporter counts as a jump pack, using the official 2.0 Jump Pack rules.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Psybolts" hidden="false" id="965d-1f81-b025-d697" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Psybolts" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="6616-f794-8fc6-2713">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Storm bolters carried by models equipped with Psybolts gain the Nemesis Force special rule.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Psyk-out Grenades" hidden="false" id="4a00-51ea-e844-4d6e" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Psyk-out Grenades" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="65f4-ed8d-4e67-439b">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Grenades filled with dust ground from a null-crystal, agonising to psykers and daemons.* Psyk-out grenades count as frag grenades. In addition, enemy psykers and Daemons charged by the bearer's unit, or charging it, do not gain the Initiative bonus for charging†.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Purity Seals" hidden="false" id="d56c-c025-dfb4-8b79" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Purity Seals" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="eec2-7bb4-e6ce-1864">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model equipped with Purity Seals may re-roll failed Adamantium Will rolls of 1.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Rosarius" hidden="false" id="ac93-901c-00ae-41ab" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Rosarius" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="e972-1d8a-b83d-41cb">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*An amulet that projects a protective conversion field.* A model with a rosarius has a 4+ Invulnerable Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="60fa-8fc7-780c-4eca" hidden="false" targetId="2e5e-c3f1-d335-9842" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (4+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Teleport Harness" hidden="false" id="9f80-7aed-1501-2482" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Teleport Harness" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="3550-07d1-8716-87c9">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A heavy teleport array that lets a Dreadnought or Dreadknight strike from orbit.* A model equipped with a Teleport Harness gains the Deep Strike special rule.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Deep Strike" id="74a5-9b72-05da-98c5" hidden="false" targetId="f1e1-986f-c783-ca9e" type="rule" />
        <infoLink name="Deep Strike" id="b9a2-fb40-fdc0-b12f" hidden="false" targetId="f1e1-986f-c783-ca9e" type="rule" />
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Titan Shield" hidden="false" id="ac1c-290c-0723-f99e" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Titan Shield" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="5bf6-b7ab-7a34-2b23">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*The ancient storm shield carried by the Supreme Grand Master.* A model equipped with a Titan Shield gains a 4+ Invulnerable Save and Feel No Pain (5+).</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="21a8-a6e9-acfa-f48e" hidden="false" targetId="2e5e-c3f1-d335-9842" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (4+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Warp Manipulation" hidden="false" id="6101-00b0-70bd-8c71" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Warp Manipulation" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="c146-d400-8cb9-ce22">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">*Masters of the Dominus Discipline wield raw psychic force as a weapon and a shield, bending reality itself to hinder their enemies and empower their allies.* Instead of making a Shooting Attack, a Psyker with this Psychic Power may select another friendly unit within 12". That unit gains Fleet (2) and Sudden Strike (2) for the duration of the current player turn. When using this power, the controlling player may choose to have the Psyker take a Psychic check. If the Check is passed then the target unit instead gains Fleet (3) and Sudden Strike (3) for the duration of the current player turn. If the Check is failed then no additional benefit is gained and the Psyker suffers Perils of the Warp.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Sanctuary" hidden="false" id="c5d1-c9bf-8767-f964" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Sanctuary" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="28fc-39b3-d00c-070b">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">*The sacred wards and hexagrammic rites of the Grey Knights form an impenetrable barrier against the creatures of the Warp.* Instead of making a Shooting Attack, a Psyker with this Psychic Power may select a single friendly unit within 12". That unit gains a 6+ Invulnerable Save until the beginning of the controlling player's next turn. If the target unit already possesses an Invulnerable Save, improve that Invulnerable Save by 1, to a maximum of 4+. When using this power, the controlling player may choose to have the Psyker take a Psychic check. If the Check is passed then the target unit instead gains a 5+ Invulnerable Save or improves any existing Invulnerable Save by 1 to a maximum of 3+ until the beginning of the controlling player's next turn. If the Check is failed then no additional benefit is gained and the Psyker suffers Perils of the Warp.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Seal the Veil" hidden="false" id="e43f-feb5-6d2b-1c5b" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Seal the Veil" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="f7bd-cdc4-e32a-ba1a">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">*Some Esoterists study the Warp with the sole intent of discovering the weakness of those creatures that dwell within. They master the sealing of aetheric energy and investigate any method of repelling the foul entities that spill from that realm, no matter how strange or ritualistic such arcane tricks might be. Though those battle-psykers that have received real training may scoff at their dubious rites, few can deny their effectiveness in battle.* Instead of making a Shooting Attack, a Psyker with this Psychic Power may select a single enemy unit composed entirely of models with the Daemon Unit Type or Corrupted Unit Sub-type that is within line of sight and has at least one model within 18" of the Psyker. All models in the target unit must reduce their Strength and Toughness by 1 (to a minimum of Toughness or Strength 1) until the end of the target unit's controlling player's next turn – the controlling player of the Psyker using this Power may then choose to make a Psychic check for the Psyker. If the Check is passed the target unit also suffers Perils of the Warp, and if the Check is failed then both the target unit and the Psyker using this Psychic Power suffer Perils of the Warp.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Divinatory Aegis" hidden="false" id="456f-fa2f-1802-518f" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Divinatory Aegis" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="08e3-d791-ca60-4a4d">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">*Diviners can effortlessly predict the paths of bullets and swords. By focusing their warp-sight even more closely, they can guide their allies' aim, bringing a swift and merciless death to their foes.* Instead of making a Shooting Attack, a Psyker with this Psychic Power may select a single friendly unit within 12". The target unit gains the Precision Strikes (6+) and Precision Shots (6+) special rules for the duration of the current player turn. When using this power, the controlling player may choose to have the Psyker take a Psychic check. If the Check is passed then the target unit instead gains the Precision Strikes (5+) and Precision Shots (5+) special rules for the duration of the current player turn. If the Check is failed then no additional benefit is gained and the Psyker suffers Perils of the Warp.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Telepathic Fugue" hidden="false" id="7afc-6f64-cf13-53ec" publicationId="c336-0f01-71db-7a8f">
      <profiles>
        <profile name="Telepathic Fugue" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="0007-6fcb-52d2-7eb1">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">*Paranoia, confusion and panic are heightened to a debilitating degree as the telepath alters their foes' perceptions, denying them a chance to react to the reality around them.* Once per turn, at the start of any Phase, the Psyker with this Psychic Power's controlling player may select a single enemy unit within 24" and line of sight of the Psyker and take a Psychic check. If that Check is passed then the target unit may not make any Reactions for the duration of that Phase. If the Check is failed then the Psyker suffers Perils of the Warp.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
