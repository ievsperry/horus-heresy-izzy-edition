<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="4b64-b0f5-2138-7dbe" name="Homebrew - Grey Knights" revision="35" battleScribeVersion="2.03" library="false" gameSystemId="28d4-bd2e-4858-ece6" gameSystemRevision="130" type="catalogue" authorName="Isaac">
  <publications>
    <publication id="c336-0f01-71db-7a8f" name="Grey Knights for The Horus Heresy 2.0 — Homebrew Conversion" shortName="HB - Grey Knights" />
  </publications>
  <selectionEntries>
    <selectionEntry type="upgrade" import="true" name="Grey Knights" hidden="false" id="fa33-cf16-cc44-f9c7" publicationId="c336-0f01-71db-7a8f">
      <modifiers>
        <modifier type="set" field="7942-3fc4-1d05-bcf9" value="0">
          <conditions>
            <condition type="atLeast" value="1" field="selections" scope="force" childId="f9c0-0c5a-3e24-58c7" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint type="min" value="1" field="selections" scope="force" shared="true" id="518b-5131-62ea-5937" percentValue="false" includeChildSelections="true" includeChildForces="false" />
        <constraint type="max" value="1" field="selections" scope="force" shared="true" id="7942-3fc4-1d05-bcf9" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile name="Psychic Ward" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="a6a8-1a04-a436-a846">
          <characteristics>
            <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Grey Knights unit is selected as the target of a Shooting Attack or a psychic weapon. Before the attack is resolved, the unit casts Sanctuary on itself (taking a Psychic check as normal).</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink targetId="e90d-e5a8-f42d-da84" id="1b5b-6b8f-fb45-4c7a" primary="true" name="Allegiance:" />
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Brotherhood" hidden="false" id="8cf7-353a-16f4-2b4d">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="1fba-d0e9-b1ee-907d" percentValue="false" includeChildSelections="false" includeChildForces="false" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f05b-d818-1457-8ae2" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="1st Brotherhood, the Swordbearers" hidden="false" id="5202-bcdf-02a3-8556" publicationId="c336-0f01-71db-7a8f">
              <profiles>
                <profile name="Blades Drawn" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="b54e-eaa7-8bc1-cc27">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: This Advanced Reaction may be declared in the Assault phase, after an enemy unit declares a Charge against a friendly unit composed entirely of models with the Brotherhood (1st) special rule, before any Overwatch attacks are resolved. Effect: The reacting unit forfeits its ability to make an Overwatch reaction against the charging unit. Instead, every model in the reacting unit gains the Counter-Attack (1) special rule until the end of the current Assault phase.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Fury of the Vanguard: Unwavering" id="08d9-75d3-0b76-8ef3" hidden="false">
                  <description>All models with the Brotherhood (1st) special rule have a Leadership Characteristic of 10 (this may not be modified above 10).</description>
                </rule>
                <rule name="Fury of the Vanguard: Vanguard of the Chapter" id="f827-6c38-2e93-c7bd" hidden="false">
                  <description>Models with the Brotherhood (1st) special rule gain a +1 bonus to their Attacks Characteristic in any turn in which they made a successful Charge.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="2nd Brotherhood, the Blades of Victory" hidden="false" id="6f09-ea43-f142-d3b7" publicationId="c336-0f01-71db-7a8f">
              <profiles>
                <profile name="Riposte" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="bc08-0685-f23c-091a">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: This Advanced Reaction may be declared in the Assault phase, immediately after an enemy unit completes a successful Charge against a friendly unit composed entirely of models with the Brotherhood (2nd) special rule. Effect: During the ensuing Fight sub-phase, all models in the reacting unit fight at the Initiative 10 step, regardless of their actual Initiative Characteristic or any penalties from unwieldy weapons.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Peerless Duellists: Blade Mastery" id="6751-ce5d-542d-8931" hidden="false">
                  <description>Models with the Brotherhood (2nd) special rule re-roll To Hit rolls of 1 when fighting in the Assault phase.</description>
                </rule>
                <rule name="Peerless Duellists: Lightning Reflexes" id="b2e7-40f7-4eb7-1b93" hidden="false">
                  <description>Models with the Brotherhood (2nd) special rule gain a +1 bonus to their Initiative Characteristic.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="3rd Brotherhood, the Wardmakers" hidden="false" id="e3dc-675b-97c4-3550" publicationId="c336-0f01-71db-7a8f">
              <profiles>
                <profile name="Ward of the Brotherhood" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="4863-dd64-74f0-a082">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: This Advanced Reaction may be declared in the Shooting phase, after an enemy unit selects a friendly unit composed entirely of models with the Brotherhood (3rd) special rule as the target of a Shooting Attack, before any To Hit rolls are made. Effect: Until the end of that Shooting Attack, all models in the reacting unit gain a 5+ Invulnerable Save. If a model already possesses an Invulnerable Save, it improves that save by +1 instead (to a maximum of 3+).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Masters of the Aegis: Psychic Discipline" id="28ae-3244-c7ab-1f2d" hidden="false">
                  <description>Once per phase, a unit composed entirely of models with the Brotherhood (3rd) special rule may re-roll a single failed Psychic check.</description>
                </rule>
                <rule name="Masters of the Aegis: Searing Wards" id="cc19-34af-df21-a207" hidden="false">
                  <description>Any Dominus Blast or Purifying Flame psychic weapon used by a model with the Brotherhood (3rd) special rule gains the Shred special rule.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="4th Brotherhood, the Rapiers" hidden="false" id="4ea9-9fe2-fbc0-0691" publicationId="c336-0f01-71db-7a8f">
              <profiles>
                <profile name="Covering Bolters" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="e915-16c3-28f4-08eb">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: This Advanced Reaction may be declared in the Shooting phase, after an enemy unit selects a friendly unit composed entirely of models with the Brotherhood (4th) special rule as the target of a Shooting Attack. Effect: Rather than the targeted unit reacting, a single other friendly unit composed entirely of models with the Legiones Astartes (Grey Knights) special rule within 6" of the targeted unit may immediately make a Return Fire Shooting Attack targeting the active enemy unit, following all standard Return Fire restrictions.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Precision Volley: Rapier Volleys" id="3027-cb80-4b5f-23ca" hidden="false">
                  <description>All Storm Bolters (and Combi-bolters) fired by models with the Brotherhood (4th) special rule gain the Breaching (6+) special rule.</description>
                </rule>
                <rule name="Precision Volley: Steady Aim" id="89d7-7468-e5ed-deda" hidden="false">
                  <description>Models with the Brotherhood (4th) special rule re-roll To Hit rolls of 1 when making Shooting Attacks.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="5th Brotherhood, the Preservers" hidden="false" id="2e6e-bafb-e46b-2bd7" publicationId="c336-0f01-71db-7a8f">
              <profiles>
                <profile name="Unyielding Anvil" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="a7b9-901e-a231-db25">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: This Advanced Reaction may be declared in the Assault phase, immediately after an enemy unit declares a Charge against a friendly unit composed entirely of models with the Brotherhood (5th) special rule. Effect: The charging enemy unit must subtract D3 from its Charge Distance roll (to a minimum of 0).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Bastion of Titan: Stoic Defenders" id="5e31-8755-29e9-ba7b" hidden="false">
                  <description>Models with the Brotherhood (5th) special rule gain the Feel No Pain (6+) special rule.</description>
                </rule>
                <rule name="Bastion of Titan: Unbreakable" id="0119-3db3-b268-29b5" hidden="false">
                  <description>Units composed entirely of models with the Brotherhood (5th) special rule automatically pass all Pinning tests.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="6th Brotherhood, the Exactors" hidden="false" id="b120-1048-c1d9-cbcf" publicationId="c336-0f01-71db-7a8f">
              <profiles>
                <profile name="Swift Retribution" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="98f4-4479-9d7d-6a29">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Movement phase). Trigger: This Advanced Reaction may be declared in the Movement phase, after an enemy unit ends a move within 12" of, and within line of sight of, a friendly unit composed entirely of models with the Brotherhood (6th) special rule. Effect: The reacting unit may immediately make a Shooting Attack targeting the triggering enemy unit, following all normal rules for Shooting Attacks (this counts as an Interceptor reaction).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Inexorable Hunt: Relentless Pursuit" id="30dd-7699-a9d7-9637" hidden="false">
                  <description>Models with the Brotherhood (6th) special rule re-roll To Wound rolls of 1 against any unit containing at least one model with the Psyker Unit Sub-type, or the Daemon, Corrupted, Corrupted Engine, or Malefic Unit Type or Sub-type.</description>
                </rule>
                <rule name="Inexorable Hunt: Sanctified Quarry" id="f337-71d6-5422-5020" hidden="false">
                  <description>Units composed entirely of models with the Brotherhood (6th) special rule add +1 to their Sweeping Advance rolls.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="7th Brotherhood, the Prescient Brethren" hidden="false" id="f16c-9704-f63a-b015" publicationId="c336-0f01-71db-7a8f">
              <profiles>
                <profile name="Foresight" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="13bc-80be-0ef7-d3a9">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Movement phase). Trigger: This Advanced Reaction may be declared in the Movement phase, after an enemy unit ends a move within 12" of a friendly unit composed entirely of models with the Brotherhood (7th) special rule. Effect: Every model in the reacting unit may immediately make a move of up to D6 + its Initiative Characteristic in inches. This move may not bring any model within 1" of an enemy model, and does not prevent the unit from shooting or charging in its own turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Sight Beyond Sight: Foreseen Arrival" id="ee4b-5fc3-7e30-7b73" hidden="false">
                  <description>Add +1 to all Reserves rolls (including Deep Strike Assault rolls) made for units composed entirely of models with the Brotherhood (7th) special rule.</description>
                </rule>
                <rule name="Sight Beyond Sight: Perfect Teleport" id="c456-f557-c4c4-a006" hidden="false">
                  <description>Any unit composed entirely of models with the Brotherhood (7th) special rule arriving via Deep Strike (or Teleport Strike) does not scatter when placed on the battlefield (it must still be placed more than 1" away from enemy models and impassable terrain).</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="8th Brotherhood, the Purifiers" hidden="false" id="fcdf-96a7-d7bc-2110" publicationId="c336-0f01-71db-7a8f">
              <profiles>
                <profile name="Purging Volley" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="502b-2a23-ac5f-b85a">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: This Advanced Reaction may be declared in the Assault phase, after an enemy unit declares a Charge against a friendly unit composed entirely of models with the Brotherhood (8th) special rule. Effect: The reacting unit makes an Overwatch Shooting Attack targeting the charging unit using the Purifying Flame psychic weapon (if equipped/known), resolving those attacks at the models' full Ballistic Skill rather than as Snap Shots.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Soul-Fire of Purity: Purifying Fire" id="73ad-3d7f-ed84-2969" hidden="false">
                  <description>Every Psyker model with the Brotherhood (8th) special rule automatically knows the Purifying Flame psychic weapon in addition to any other psychic powers or weapons it possesses.</description>
                </rule>
                <rule name="Soul-Fire of Purity: Purity of Purpose" id="c47b-9aab-318a-1336" hidden="false">
                  <description>Models with the Brotherhood (8th) special rule gain the Hatred (Everything) special rule.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Rite of War" hidden="false" id="8c9d-79be-6114-e4ac">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4892-bff8-3f98-89ac" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Nemesis Strike" hidden="false" id="4a3b-8958-41eb-9b28" publicationId="c336-0f01-71db-7a8f">
              <modifiers>
                <modifier type="set" field="ae9d-2706-6eac-8d79" value="0">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="c658-dc6b-727b-c488" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ae9d-2706-6eac-8d79" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule name="Prerequisites" id="b02a-1216-a971-eb02" hidden="false">
                  <description>A Detachment using this Rite of War must include a Grand Master in Nemesis Dreadknight with the Master of the Legion special rule, and this model must be the army's Warlord.</description>
                </rule>
                <rule name="Effects" id="89ff-12c4-64f1-c513" hidden="false">
                  <description>Engines of Tithe: Dreadknight Talons may be selected as Elites choices in addition to Heavy Support choices in a Detachment using this Rite of War. Spearhead of Titan: Grey Knight Dreadlancer Talons may be selected as non-Compulsory Troops choices in a Detachment using this Rite of War. Any unit selected in this manner gains the Line (1) Unit Sub-type.</description>
                </rule>
                <rule name="Limitations" id="ae07-680a-799d-8544" hidden="false">
                  <description>A Detachment using this Rite of War may not include any Lords of War choices. A Detachment using this Rite of War must include more Troops choices than Dreadknight Talons (across all Force Organisation slots).</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="7095-e817-db2a-c929" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Paladin Retinue" hidden="false" id="375b-d942-3927-3c58" publicationId="c336-0f01-71db-7a8f">
              <modifiers>
                <modifier type="set" field="b872-f0df-ae5d-d810" value="0">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="952b-1b89-5991-8ab9" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b872-f0df-ae5d-d810" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule name="Prerequisites" id="f1b4-11cb-e83a-d98e" hidden="false">
                  <description>A Detachment using this Rite of War must include a Grand Master or Kaldor Draigo with the Master of the Legion special rule, and this model must be the army's Warlord.</description>
                </rule>
                <rule name="Effects" id="c6f8-bae6-36e0-7011" hidden="false">
                  <description>Chosen of the Chamber: Paladin Squads may be selected as Troops choices in a Detachment using this Rite of War. Any unit selected in this manner gains the Line (1) Unit Sub-type.</description>
                </rule>
                <rule name="Limitations" id="accd-88f7-a35d-6049" hidden="false">
                  <description>A Detachment using this Rite of War may not include any Strike Squads.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="0cd1-795b-e397-7e85" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Purifier Crusade" hidden="false" id="0c08-5cd5-0cae-3c97" publicationId="c336-0f01-71db-7a8f">
              <modifiers>
                <modifier type="set" field="13c7-17f6-6bbc-a640" value="0">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="fbe9-651b-7b02-04c1" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
                <modifier type="set" field="d579-e18f-8852-5fef" value="0">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="1ae5-f2f4-f0eb-de51" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
                <modifier type="set" field="8dde-1ab8-7b53-081e" value="0">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="2c3e-4d65-b5a4-847f" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="13c7-17f6-6bbc-a640" percentValue="false" includeChildSelections="false" includeChildForces="false" />
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d579-e18f-8852-5fef" percentValue="false" includeChildSelections="false" includeChildForces="false" />
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8dde-1ab8-7b53-081e" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule name="Prerequisites" id="efab-3d2c-1762-b6ba" hidden="false">
                  <description>A Detachment using this Rite of War must include Castellan Crowe or a Brother-Captain with the Master of the Legion special rule, and this model must be the army's Warlord.</description>
                </rule>
                <rule name="Effects" id="70bb-d0e6-6d34-8c71" hidden="false">
                  <description>Cleansing Flame: Purifier Squads may be selected as Troops choices in a Detachment using this Rite of War. Any unit selected in this manner gains the Line (1) Unit Sub-type.</description>
                </rule>
                <rule name="Limitations" id="8161-6bd3-d160-b5fc" hidden="false">
                  <description>A Detachment using this Rite of War may not include any Dreadknight Talons. A Detachment using this Rite of War may not include any Land Raiders of any variant (including as Dedicated Transports).</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="ba50-e529-ac78-ce2f" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Teleport Assault" hidden="false" id="237f-cee9-50aa-c5e1" publicationId="c336-0f01-71db-7a8f">
              <rules>
                <rule name="Prerequisites" id="fe3f-9579-d6bb-b086" hidden="false">
                  <description>A Detachment using this Rite of War must include a Grand Master or Kaldor Draigo with the Master of the Legion special rule, and this model must be the army's Warlord.</description>
                </rule>
                <rule name="Effects" id="ff6b-31e3-0965-9e06" hidden="false">
                  <description>First Strike Teleportation: Every unit in a Detachment using this Rite of War composed entirely of models equipped with Aegis Terminator Armour gains the Deep Strike special rule. When making a Deep Strike Assault using units from this Detachment, the controlling player may elect to make their Deep Strike Assault in their first Player Turn, rather than waiting until the second Player Turn.</description>
                </rule>
                <rule name="Limitations" id="7aa8-f61d-7d32-1ccc" hidden="false">
                  <description>No units in a Detachment using this Rite of War may be deployed inside or select Dedicated Transports. At least half of the units (rounding up) in a Detachment using this Rite of War must be placed in Reserves (including Deep Strike Reserves) during deployment.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="a3b3-4a7a-7444-2e86" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
      </costs>
    </selectionEntry>
  </selectionEntries>
  <entryLinks>
