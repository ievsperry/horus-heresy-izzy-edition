    <selectionEntry type="unit" import="true" name="Grand Master Khyron" hidden="false" id="d31c-4da9-5372-350c" publicationId="c336-0f01-71db-7a8f">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="force" shared="true" id="bd73-8332-7e78-04e6" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule name="Dark Foresight" id="3f1b-d857-6848-26d1" hidden="false">
          <description>Once per game, at the start of any Player Turn, Khyron may select a single enemy unit within 18" and line of sight. Until the end of that Player Turn, the opposing player must re-roll all successful To Hit rolls or all successful Saving Throws (controlling player's choice) made for that unit</description>
        </rule>
        <rule name="Psychic Discipline" id="7a0e-85b6-d0d5-6730" hidden="false">
          <description>Dominus, Sanctic, Anathemata, Divination or Telepathy</description>
        </rule>
        <rule name="Warlord" id="e4dc-0910-f957-a25b" hidden="false">
          <description>Prescience</description>
        </rule>
      </rules>
