      <rules>
        <rule name="Psychic Discipline" id="b532-9b6e-2f77-6359" hidden="false">
          <description>Dominus, Sanctic, Anathemata, Divination or Telepathy</description>
        </rule>
        <rule name="Seraphic Duelist" id="b923-0f0b-82a5-2fb7" hidden="false">
          <description>Satre must issue and accept Challenges whenever possible. While fighting in a Challenge, Satre re-rolls all failed To Hit rolls and imposes a -1 penalty on the opposing model's Weapon Skill Characteristic (to a minimum of 1)</description>
        </rule>
        <rule name="Warlord" id="ba5a-7275-db50-8651" hidden="false">
          <description>Unstoppable Champion</description>
