      </constraints>
      <rules>
        <rule name="Psychic Discipline" id="a4b2-6145-3c69-cc2a" hidden="false">
          <description>Dominus, Sanctic, Anathemata, Divination or Telepathy</description>
        </rule>
        <rule name="Tactical Exemplar" id="c7fb-373a-5f4a-6d78" hidden="false">
          <description>Friendly units composed entirely of models with the Brotherhood (1st) special rule within 12" of Koios may use his Leadership Characteristic for Morale and Pinning tests and gain the Counter-Attack (1) special rule</description>
        </rule>
        <rule name="Warlord" id="e997-f243-0b06-aca6" hidden="false">
          <description>First Among Equals</description>
        </rule>
      </rules>
