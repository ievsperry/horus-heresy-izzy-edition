      <rules>
        <rule name="Psychic Discipline" id="6a8e-b826-4b62-1f0c" hidden="false">
          <description>Dominus, Sanctic, Anathemata, Divination or Telepathy</description>
        </rule>
        <rule name="Strands of Fate" id="a997-7199-f793-bef2" hidden="false">
          <description>Once per turn, re-roll any one dice roll for Stern or his unit</description>
