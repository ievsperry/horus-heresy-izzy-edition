    <selectionEntry type="unit" import="true" name="Aegis Captain" hidden="false" id="095f-927b-2d79-0e54" publicationId="c336-0f01-71db-7a8f">
      <rules>
        <rule name="Aegis Retinue" id="747c-ee23-a2c9-b9d6" hidden="false">
          <description>The Aegis Captain may take one Aegis Bastion Squad as a Retinue Squad, with himself as its Leader, as the Retinue special rule describes. It does not use a Force Organisation slot, counts as part of his unit, must deploy with him, and he may not voluntarily leave it. It still counts as the Detachment's one Aegis Bastion Squad</description>
        </rule>
        <rule name="Psychic Discipline" id="cbf0-cf06-dd0f-28ae" hidden="false">
          <description>Dominus, Sanctic, Anathemata, Divination or Telepathy</description>
        </rule>
      </rules>
