    <selectionEntry type="unit" import="true" name="Supreme Grand Master Janus" hidden="false" id="38cc-f24a-e52d-84da" publicationId="c336-0f01-71db-7a8f">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="force" shared="true" id="12b8-76c7-cf2c-4ede" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule name="Psychic Discipline" id="07d8-a979-ddbf-b9a1" hidden="false">
          <description>up to three of Dominus, Sanctic, Anathemata, Divination or Telepathy</description>
        </rule>
        <rule name="Shard of the Crimson King" id="495a-2970-3a29-62a4" hidden="false">
          <description>Janus may select up to three Psychic Disciplines (instead of one) and knows all Minor Psychic Powers. He may manifest up to two Psychic Powers or Psychic Weapons per phase, and once per turn may re-roll a failed Psychic check</description>
        </rule>
        <rule name="Warlord" id="c7e2-dfd2-900e-4c55" hidden="false">
          <description>Architect of Titan</description>
        </rule>
      </rules>
      <infoLinks>
