              <profiles>
                <profile name="Supreme Grand Master" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="3db3-1943-75c9-fe2f">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">Kaldor Draigo automatically has this Trait if he is the Warlord and may not select any other. Friendly units with the Legiones Astartes (Grey Knights) special rule within 12" of Kaldor Draigo gain +1 Leadership, and may use his Leadership Characteristic when making Morale Checks, Pinning Checks, Regroup Tests and Psychic Checks. Kaldor Draigo gains Adamantium Will (3+). So long as he has not been removed as a casualty, his controlling player may make one additional Reaction during the opponent's Movement Phase; it follows all normal rules for Reactions and does not allow the same unit to React more than once to the same triggering event.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="ef1e-941f-0f55-d3d5" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
