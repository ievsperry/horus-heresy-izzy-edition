  <selectionEntries>
    <selectionEntry type="upgrade" import="true" name="Anhrathe" hidden="false" id="bfb0-3cf3-b297-83ed" publicationId="a8f3-52ed-030f-1805">
      <constraints>
        <constraint type="min" value="1" field="selections" scope="force" shared="true" id="c80e-9406-2abd-84ff" percentValue="false" includeChildSelections="true" includeChildForces="false" />
