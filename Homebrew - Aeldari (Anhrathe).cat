        <selectionEntry type="upgrade" import="true" name="Pirate King" hidden="true" id="ac01-ec5b-2951-e980" publicationId="a8f3-52ed-030f-1805">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="6229-98b6-4e89-d141" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
