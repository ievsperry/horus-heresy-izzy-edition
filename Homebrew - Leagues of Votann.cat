    <selectionEntry id="d636-14d1-4ec3-2027" name="Void-Hardened Extra Armour" hidden="false" collective="false" import="true" type="upgrade">
      <profiles>
        <profile id="e230-e1a3-178f-3d5b" name="Void-Hardened Extra Armour" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Grants a 2+ Armour Save and a 6+ Invulnerable Save against all shooting and melee attacks. In addition, enemy attacks targeting this model do not benefit from To Wound re-rolls granted by the Armourbane (X) special rule, and the value of any Brutal (X) special rule is reduced by 1 (to a minimum of 1).</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
      </costs>
    </selectionEntry>
    <selectionEntry id="31e4-3999-eed8-4289" name="Pan Spectral Targeting Array" hidden="false" collective="false" import="true" type="upgrade">
      <profiles>
        <profile id="eff7-bb19-e8ad-aaa1" name="Pan Spectral Targeting Array" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Grants Skyfire and Interceptor to all weapons fired by this model if it remained stationary in its preceding Movement phase.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="a236-5a6a-9e2e-8649" name="Skyfire" hidden="false" targetId="f2bf-5daa-9f93-0b01" type="rule" />
      </infoLinks>
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
      </costs>
    </selectionEntry>
    <selectionEntry id="97c4-3fc6-b534-691a" name="Ancestor-Linked Cogitators" hidden="false" collective="false" import="true" type="upgrade">
      <profiles>
        <profile id="ec82-9fca-3a84-ed20" name="Ancestor-Linked Cogitators" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">When resolving shooting attacks or close-combat attacks against an enemy unit that has at least 1 Judgement Token, this model treats that enemy unit as having +1 additional Judgement Token (to a maximum of 2). In addition, this model may re-roll failed Morale and Pinning tests.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
      </costs>
    </selectionEntry>
    <selectionEntry id="c66c-e306-d6e3-36bd" name="Overcharged Hydraulic Rams" hidden="false" collective="false" import="true" type="upgrade">
      <profiles>
        <profile id="dfda-3a55-43ca-d104" name="Overcharged Hydraulic Rams" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">This model ignores the -1" penalty to Charge distance rolls from Heavy Hydraulic Pistons (it still suffers the -1" penalty to Run moves), and gains Hammer of Wrath (2) and Furious Charge (1) on any turn in which it successfully completes a Charge.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="4b32-cae0-07b2-f14a" name="Hammer of Wrath (X)" hidden="false" targetId="aec0-c3aa-1e4e-1779" type="rule" />
        <infoLink id="80b3-b078-af8b-63a6" name="Furious Charge (X)" hidden="false" targetId="2821-9269-862f-0554" type="rule" />
      </infoLinks>
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
      </costs>
    </selectionEntry>
    <selectionEntry id="6ba6-ef0c-b241-1ee7" name="Void-Drift Thruster Vanes" hidden="false" collective="false" import="true" type="upgrade">
      <profiles>
        <profile id="cd84-1eb4-2dcd-3f97" name="Void-Drift Thruster Vanes" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">This model gains the Scout and Move Through Cover special rules, and automatically passes all Dangerous Terrain tests.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="2e14-4376-abed-b72d" name="Scout" hidden="false" targetId="aacf-9a7e-982d-b793" type="rule" />
        <infoLink id="8fb6-35ba-6903-b2f6" name="Move Through Cover" hidden="false" targetId="2b6f-bfec-759e-1746" type="rule" />
      </infoLinks>
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
      </costs>
    </selectionEntry>
    <selectionEntry id="6342-7e62-821b-d084" name="Ablative Bastion-Plates" hidden="false" collective="false" import="true" type="upgrade">
      <profiles>
        <profile id="14f5-1297-be76-6c43" name="Ablative Bastion-Plates" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">This model reduces the Strength of all incoming ranged attacks from Strength 8 or higher by -1 (to a minimum of 7) when resolving To Wound rolls, and gains Feel No Pain (6+) (or improves an existing Feel No Pain (X) roll by +1, to a maximum of 4+).</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="08ed-78fd-0788-ad85" name="Feel No Pain (X)" hidden="false" targetId="ec46-ff29-32e0-c2aa" type="rule" />
      </infoLinks>
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
      </costs>
    </selectionEntry>
    <selectionEntry id="60e2-9224-8052-cb1f" name="Master-Forged Weavefield Capacitors" hidden="false" collective="false" import="true" type="upgrade">
      <profiles>
        <profile id="e81f-d282-3bb5-0a91" name="Master-Forged Weavefield Capacitors" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">This model gains a 5+ Invulnerable Save against shooting attacks (if upgraded with Void-Hardened Extra Armour, its Invulnerable Save against melee attacks remains 6+). In addition, all Beam, Conversion, Magma, Plasma, and Volkanite ranged weapons equipped by this model add +4" to their maximum range.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
      </costs>
    </selectionEntry>
