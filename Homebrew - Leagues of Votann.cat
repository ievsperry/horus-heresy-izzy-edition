                  </repeats>
                </modifier>
                <modifier type="decrement" field="aaaf-3f46-9f8c-71d5" value="1">
                  <repeats>
                    <repeat field="selections" scope="force" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="b939-a824-d594-e0e7" repeats="1" roundUp="false" />
                  </repeats>
                </modifier>
              </modifiers>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="aaaf-3f46-9f8c-71d5" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule name="Prerequisites" id="233b-4b2a-1fc3-7f12" hidden="false">
                  <description>Requires a Brôkhyr Iron-master as Warlord.</description>
                </rule>
                <rule name="Effects" id="54cb-676f-fa39-09ea" hidden="false">
                  <description>Brôkhyr Thunderkyn squads may be taken as Troops choices. Every model in the Detachment with the Battlesmith (X) special rule improves its target number by 1. This stacks with Master Artisans, subject to the 2+ cap.</description>
                </rule>
                <rule name="Limitations" id="a409-344e-7cc4-f044" hidden="false">
                  <description>The Detachment may not include more Infantry units (not counting Brôkhyr Thunderkyn and Independent Characters) than the combined number of Vehicle units and Brôkhyr Thunderkyn units in the Detachment.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="8dca-7fbd-74a5-ea78" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Hekaton Spearhead" hidden="false" id="c4a2-a5d1-c625-5db5" publicationId="e1a3-795b-be05-784b">
              <rules>
                <rule name="Prerequisites" id="abca-3f26-9fe9-4a7b" hidden="false">
                  <description>Requires any Votann HQ as Warlord, and must begin the game embarked upon a Hekaton Land Fortress.</description>
                </rule>
                <rule name="Effects" id="a99c-650e-c49e-45a7" hidden="false">
                  <description>Hekaton Land Fortresses may be taken as Elites choices, in addition to Heavy Support choices. The Hekaton Land Fortress carrying your Warlord at the start of the game gains the Scout special rule.</description>
                </rule>
                <rule name="Limitations" id="8be2-405d-b21b-d586" hidden="false">
                  <description>Every Infantry unit in the Detachment must begin the game embarked upon a Transport with enough capacity. This can be a Dedicated Transport, or a Heavy Support or Lord of War Transport.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="395c-264f-ed89-59c9" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Oathband" hidden="false" id="8aa3-8686-1953-11df" publicationId="e1a3-795b-be05-784b">
              <modifiers>
                <modifier type="set" field="cb2c-2a1a-fd8a-5e1a" value="0">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="20ef-cd01-a8da-376e" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="cb2c-2a1a-fd8a-5e1a" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule name="Prerequisites" id="ceef-5675-1a31-747e" hidden="false">
                  <description>Requires a Kâhl or Ûthar the Destined as Warlord.</description>
                </rule>
                <rule name="Effects" id="c7f8-8338-9978-0c01" hidden="false">
                  <description>Einhyr Hearthguard squads may be taken as Troops choices and gain the Line unit sub-type.</description>
                </rule>
                <rule name="Limitations" id="9769-8213-4e50-2163" hidden="false">
                  <description>The Detachment may not include any Fast Attack choices.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="e7bd-b4ab-39c9-9285" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Prospector Fleet" hidden="false" id="8202-0016-eb84-9b6d" publicationId="e1a3-795b-be05-784b">
              <modifiers>
