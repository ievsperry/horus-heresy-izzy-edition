              </constraints>
              <rules>
                <rule name="Prerequisites" id="f1ee-1658-9d1e-d897" hidden="false">
                  <description>Requires any Votann HQ as Warlord.</description>
                </rule>
                <rule name="Effects" id="d01e-2a20-b727-a0ed" hidden="false">
                  <description>Hernkyn Pioneers and Hernkyn Yaegirs may be taken as Troops choices and gain the Line unit sub-type.</description>
                </rule>
                <rule name="Limitations" id="8e8d-e7de-6fc8-51f0" hidden="false">
                  <description>The Detachment may not include any Heavy Support choices.</description>
                </rule>
              </rules>
