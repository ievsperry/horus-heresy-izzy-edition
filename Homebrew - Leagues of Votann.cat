        <profile name="Exo-armour" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="6d60-05b8-952c-ad26">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Heavy powered armour worn by the Einhyr, the Kin's elite.* Exo-armour confers a 2+ Armour Save and the Void Armour special rule. A model in exo-armour has the Heavy sub-type.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Medipack" hidden="false" id="3be3-553e-f9f9-ae54" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Medipack" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="319b-ebd9-278a-e433">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Field medical supplies.* A unit that includes a model with a medipack has Feel No Pain (6+).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Pan Spectral Scanner" hidden="false" id="317f-b950-84f2-f218" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Pan Spectral Scanner" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="4cbf-bee3-776f-c791">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A scanner that sees through every kind of concealment.* A unit that includes a model with a pan spectral scanner ignores Stealth and Shrouded on its targets.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Rollbar Searchlight" hidden="false" id="bcc6-94ff-1ce2-574f" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Rollbar Searchlight" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="589d-41da-92bd-0e0f">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A powerful lamp mounted on a Pioneer's bike.* A unit that includes a model with a rollbar searchlight ignores Night Fighting when shooting†.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Teleport Crest" hidden="false" id="54d2-4590-5203-a13c" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Teleport Crest" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="683d-9d28-54f9-a205">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A personal teleporter that delivers the Einhyr to the heart of battle.* A unit whose models all have teleport crests gains Deep Strike.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Void Armour" hidden="false" id="44bb-8066-c045-54bf" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Void Armour" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="4c21-4861-b5f2-4ab5">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Sealed, layered armour that protects the Kin in vacuum and on hostile worlds.* Void armour confers a 4+ Armour Save and the Void Armour special rule. Some units have a different save with void armour (Beserks 5+, Thunderkyn 3+); their profile shows it.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Warforge Gauntlets" hidden="false" id="e07a-827f-9e8c-d527" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Warforge Gauntlets" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="c36b-42f4-69ed-13d8">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*The armoured gauntlets of Berehk Stornbröw.* The bearer makes one additional Attack, made with Kromlôk's Revenge.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Weavefield Crest" hidden="false" id="9f56-bdfb-7d26-7854" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Weavefield Crest" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="7a70-314b-d7af-f692">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A shoulder-mounted field generator that turns aside incoming fire.* A model with a weavefield crest has a 5+ Invulnerable Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="b20f-4efd-1860-0500" hidden="false" targetId="a75a-fe58-e375-cdb8" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (5+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Ancestral Ward" hidden="false" id="c0be-53e1-9b40-b7a2" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Ancestral Ward" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="5fef-23a4-6d1f-9b86">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">Movement (start) phase. The Grimnyr and any unit he has joined gain a 4+ Invulnerable Save against psychic weapons and a 5+ Invulnerable Save against everything else, until the start of your next turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Fortify" hidden="false" id="7c0a-d541-9db8-106c" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Fortify" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="fda2-d930-ced1-a51b">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">Movement (start) phase. One friendly Votann unit within 12" gains Feel No Pain (6+), or improves an existing Feel No Pain by 1, until the start of your next turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Null Vortex" hidden="false" id="b531-3eb4-0a17-8974" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Null Vortex" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="1c0f-f377-a279-8e76">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">Shooting phase. Enemy psykers within 18" subtract 2 from their Leadership for Psychic checks until the start of your next turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Arkanyst Evaluator" hidden="false" id="56ea-7bdf-7f5d-e2da" publicationId="e1a3-795b-be05-784b">
      <rules>
        <rule name="Field Upgrades" id="829b-745a-349c-d000" hidden="false">
          <description>Friendly Ironkin Steeljacks units within 6" may re-roll to-hit rolls of 1 when shooting</description>
        </rule>
        <rule name="Note" id="eb1e-1186-f8fa-de58" hidden="false">
          <description>Independent Character (may only join Ironkin Steeljacks, Brôkhyr Thunderkyn or Hearthkyn Warriors)</description>
        </rule>
        <rule name="Science Guild Support" id="72cc-f62b-afac-0a12" hidden="false">
          <description>While within 3" of another friendly Votann Infantry unit and not joined to a unit, enemy units may only target the Evaluator with Shooting Attacks if it is the closest visible enemy unit</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Xenos" id="d6a2-232e-a69a-95a6" hidden="false" targetId="e6a0-8f13-d5c2-4b79" type="rule" />
