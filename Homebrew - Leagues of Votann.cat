    <selectionEntry type="unit" import="true" name="Berehk Stornbröw" hidden="false" id="05e0-e005-d8da-0c0f" publicationId="e1a3-795b-be05-784b">
      <rules>
        <rule name="Break the Foe" id="b9e6-5c47-2bc4-8c4d" hidden="false">
          <description>The unit Berehk joins may re-roll to-hit rolls of 1 in close combat, and its melee weapons gain Rending (6+)</description>
        </rule>
        <rule name="Cloneskein" id="f42b-4aa9-a832-4d6e" hidden="false">
          <description>Berehk has Feel No Pain (4+)</description>
        </rule>
        <rule name="Freebooter Hater" id="8c44-086f-77bc-7476" hidden="false">
          <description>Berehk has Preferred Enemy (Orks)</description>
        </rule>
        <rule name="Note" id="b9e7-48eb-a0e2-0d65" hidden="false">
          <description>Independent Character (may only join Cthonian Beserks)</description>
        </rule>
        <rule name="Relentless Avalanche" id="ea3c-be73-c49d-c890" hidden="false">
          <description>Once per turn, the unit Berehk joins may make a reaction in your opponent's Assault phase without spending from your Reaction Allotment</description>
        </rule>
        <rule name="Note" id="4e5c-7152-f820-a94d" hidden="false">
          <description>Kromlôk's Revenge combines a plasma blade with a mass driver. Each time Berehk fights, choose one profile. His Warforge gauntlets give him one additional Attack, made with Kromlôk's Revenge.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Xenos" id="60d4-69ec-3557-ce99" hidden="false" targetId="e6a0-8f13-d5c2-4b79" type="rule" />
        <infoLink name="Eye of the Ancestors (Judgement)" id="ef61-035b-63d0-0305" hidden="false" targetId="9191-9822-8db6-275c" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Eye of the Ancestors" />
          </modifiers>
