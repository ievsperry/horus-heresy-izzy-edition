  <sharedSelectionEntryGroups>
    <selectionEntryGroup name="Warlord Traits" hidden="false" id="b4ab-b37d-3388-e425">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="39b3-fcab-ba76-2c4c" percentValue="false" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Ancestral Bearing" hidden="false" id="0531-c44d-43d8-1dca" publicationId="e1a3-795b-be05-784b">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="da91-7d38-cda5-950d" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Ancestral Bearing" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="2604-a8d3-ea2e-4f54">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">Friendly Votann units within 12" of your Warlord may use the Warlord's Leadership characteristic for all Morale, Pinning and Leadership checks. While your Warlord is alive and on the battlefield, your army may also make one additional Reaction during your opponent's Assault phase, above its normal Reaction Allotment. A single unit still cannot make more than one Reaction per phase.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="de71-7ca2-004c-64d6" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Calculating Tactician" hidden="false" id="b761-088b-a28d-a775" publicationId="e1a3-795b-be05-784b">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="55d2-d807-1540-5ac3" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Calculating Tactician" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="8922-cfd9-8502-81e3">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">You may re-roll one Reserves roll or Outflank roll each turn. While your Warlord is alive and on the battlefield, your army may also make one additional Reaction during your opponent's Movement phase, above its normal Reaction Allotment.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="b537-e1d6-5fbb-7a8e" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Grudgebearer" hidden="false" id="5efb-7d1c-a9a1-31c1" publicationId="e1a3-795b-be05-784b">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3f2d-f85e-27e3-e708" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Grudgebearer" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="2658-0cbd-4cc6-f953">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">When your Warlord and any unit they join make attacks, they treat every enemy unit as having 1 more Judgement Token than it has, to a maximum of 2. Units with no tokens count as having 1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="f4f5-b136-b83e-1cc4" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Unbreakable" hidden="true" id="593c-79be-b38b-fe97" publicationId="e1a3-795b-be05-784b">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="53a0-2151-818f-1792" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d0f5-672d-19f9-cbb5" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Unbreakable" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="a50f-edb7-44f1-6071">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">Your Warlord and any unit they join automatically pass all Pinning tests and Morale checks. They may still choose to Fall Back voluntarily if another rule allows it.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="226d-6178-1bca-359b" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Grim Conqueror" hidden="true" id="7d0b-3354-b45b-28a4" publicationId="e1a3-795b-be05-784b">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="c420-ead6-6567-06b5" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4625-24c3-8e8b-34e6" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Grim Conqueror" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="9730-1064-1c23-3e1a">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">Your Warlord and any unit they join gain Furious Charge (1). A unit that already has Furious Charge (X) increases X by 1 instead.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="bae1-0796-ba60-f217" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Convoy Master" hidden="true" id="f1a8-0d1f-8cb9-6a6e" publicationId="e1a3-795b-be05-784b">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="f1d3-30f8-4eba-00eb" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="db89-150d-895d-6c8d" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Convoy Master" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="b2a2-5359-382a-9e45">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">Your Warlord, any unit they join, and any Transport they begin the game embarked upon gain the Scout special rule.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="0413-3627-20b2-9e6b" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Scout-Master" hidden="true" id="eb37-1f47-8a93-d92c" publicationId="e1a3-795b-be05-784b">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="6323-25ed-9221-9ff4" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="623b-dce7-40a1-1f2c" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Scout-Master" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="841c-ba43-2d17-c64b">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">Before the first turn begins, you may remove up to three friendly Urani-Surtr Regulates units from the battlefield and redeploy them anywhere within your Deployment Zone, following all standard deployment rules. See Pre-Game Sequence for exact timing.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="11a2-296b-7494-1a21" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Master Engineer" hidden="true" id="47bb-ce26-d346-19f0" publicationId="e1a3-795b-be05-784b">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="a97e-906d-8554-dab7" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b817-60bd-7238-b3eb" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Master Engineer" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="5183-a2e8-be4c-7e0d">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">Your Warlord gains Battlesmith (4+). If they already have Battlesmith (X), improve its target number by 1 instead.</characteristic>
              </characteristics>
            </profile>
          </profiles>
