    <selectionEntry type="upgrade" import="true" name="Grudge-Ledger / Holo-Lectern" hidden="false" id="04d8-1b16-5eca-3067" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Grudge-Ledger / Holo-Lectern" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="c15e-b64d-8ebe-3d07">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Once per friendly Shooting phase, before any attacks are made, the bearer may select one enemy unit within 24" and in its Line of Sight. That unit gains 1 temporary Judgement Token.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Ammunition Store" hidden="false" id="6e64-a340-0df1-ff74" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Ammunition Store" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="c388-1a2b-1e7a-0bea">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Models embarked inside the Fortification or occupying its battlements may re-roll To Hit rolls of 1 during the Shooting phase. If the Fortification explodes, add +1 to the Building Damage table roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Arkanyst Hauberk" hidden="false" id="becf-9807-cc59-ad2a" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Arkanyst Hauberk" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="9e3e-8e73-e706-96b5">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A heavy hauberk that shields an Arkanyst Evaluator from the emissions of a transmatter inverter.* The model has a 3+ Armour Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Comms Array" hidden="false" id="49bd-f48c-445f-d728" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Comms Array" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="df7a-51e3-b2a3-3125">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Long-range communications gear.* A unit that includes a model with a comms array may re-roll its Reserves rolls.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="E-COG" hidden="false" id="ae64-a67b-90a2-fa73" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="E-COG" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="b3c5-01d2-166f-146b">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A helper drone that assists an Iron-master's repairs.* An Iron-master with an E-COG improves his Battlesmith by 1.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Exo-armour" hidden="false" id="2683-1a84-acb0-4254" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Exo-armour" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="6d60-05b8-952c-ad26">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Heavy powered armour worn by the Einhyr, the Kin's elite.* Exo-armour confers a 2+ Armour Save and the Void Armour special rule. A model in exo-armour has the Heavy sub-type.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Medipack" hidden="false" id="3be3-553e-f9f9-ae54" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Medipack" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="319b-ebd9-278a-e433">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Field medical supplies.* A unit that includes a model with a medipack has Feel No Pain (6+).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Pan Spectral Scanner" hidden="false" id="317f-b950-84f2-f218" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Pan Spectral Scanner" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="4cbf-bee3-776f-c791">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A scanner that sees through every kind of concealment.* A unit that includes a model with a pan spectral scanner ignores Stealth and Shrouded on its targets.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Rollbar Searchlight" hidden="false" id="bcc6-94ff-1ce2-574f" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Rollbar Searchlight" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="589d-41da-92bd-0e0f">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A powerful lamp mounted on a Pioneer's bike.* A unit that includes a model with a rollbar searchlight ignores Night Fighting when shooting†.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Searchlights" hidden="false" id="99f1-d288-9ef9-f8ca" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Searchlights" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="d905-ff4e-2caf-bd2a">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model with searchlights ignores the 24" limit to line of sight imposed by the Night Fighting rules when making Shooting Attacks, however enemy units also ignore that same restriction when making Shooting Attacks that target a model with searchlights. In addition, any unit that has been the target of a Shooting Attack made by a unit with searchlights may be freely targeted by any other unit, ignoring the 24" Night Fighting restriction. Searchlights do not count as weapons.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Teleport Crest" hidden="false" id="54d2-4590-5203-a13c" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Teleport Crest" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="683d-9d28-54f9-a205">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A personal teleporter that delivers the Einhyr to the heart of battle.* A unit whose models all have teleport crests gains Deep Strike.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Void-Hardened Reinforced Plating" hidden="false" id="cefe-3018-35a8-5ed3" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Void-Hardened Reinforced Plating" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="3104-b637-427b-8fa2">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A Brôkhyr Interlocking Bulwark with Void-Hardened Reinforced Plating improves its Cover Save to 3+ against shooting attacks that do not have the Ignores Cover or Barrage special rules.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Void-Weave Field Array" hidden="false" id="8767-afb1-f11a-2f7c" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Void-Weave Field Array" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="c206-49d4-419e-7144">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The Fortification projects 2 Void Shields (Armour Value 12) in a 12" radius around it, using the standard Void Shield rules of the Age of Darkness 2.0 rulebook (see Projected Void-Weave Dome).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Reinforced Bulkhead Plating" hidden="false" id="ad7e-3ede-d24d-797a" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Reinforced Bulkhead Plating" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="4fb5-3fd1-b103-9f19">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The Fortification's Front, Side and Rear Armour Values are 13.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Void Shield" hidden="false" id="f058-c72a-c9e8-c5e1" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Void Shield" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="7227-912c-f333-86c1">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Each Void Shield gives the Fortification one Void Shield (Armour Value 12), as detailed in the Void Shields rules of the Age of Darkness rulebook.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Void Armour" hidden="false" id="44bb-8066-c045-54bf" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Void Armour" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="4c21-4861-b5f2-4ab5">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Sealed, layered armour that protects the Kin in vacuum and on hostile worlds.* Void armour confers a 4+ Armour Save and the Void Armour special rule. Some units have a different save with void armour (Beserks 5+, Thunderkyn 3+); their profile shows it.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Warforge Gauntlets" hidden="false" id="e07a-827f-9e8c-d527" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Warforge Gauntlets" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="c36b-42f4-69ed-13d8">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*The armoured gauntlets of Berehk Stornbröw.* The bearer makes one additional Attack, made with Kromlôk's Revenge.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Weavefield Crest" hidden="false" id="9f56-bdfb-7d26-7854" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Weavefield Crest" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="7a70-314b-d7af-f692">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A shoulder-mounted field generator that turns aside incoming fire.* A model with a weavefield crest has a 5+ Invulnerable Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="b20f-4efd-1860-0500" hidden="false" targetId="a75a-fe58-e375-cdb8" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (5+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Ancestral Ward" hidden="false" id="c0be-53e1-9b40-b7a2" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Ancestral Ward" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="5fef-23a4-6d1f-9b86">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">Movement (Start) phase. Until the start of your next turn, the Psyker and any unit they have joined gain a 5+ Invulnerable Save, which is improved to a 4+ Invulnerable Save against wounds inflicted by weapons with the Psychic or Force special rules (including Perils of the Warp).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Fortify" hidden="false" id="7c0a-d541-9db8-106c" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Fortify" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="fda2-d930-ced1-a51b">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">Movement (Start) phase. Select one friendly Votann unit within 12" and Line of Sight of the Psyker. Until the start of your next turn, all models in that unit gain Feel No Pain (6+), or improve an existing Feel No Pain (X) special rule by +1 (to a maximum of 4+).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Null Vortex" hidden="false" id="b531-3eb4-0a17-8974" publicationId="e1a3-795b-be05-784b">
      <profiles>
        <profile name="Null Vortex" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="1c0f-f377-a279-8e76">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">Shooting phase. Until the start of your next turn, all enemy models with the Psyker unit sub-type within 18" of this Psyker suffer a -2 penalty to their Leadership characteristic when taking Psychic Checks or Deny the Witch rolls.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Arkanyst Evaluator" hidden="false" id="56ea-7bdf-7f5d-e2da" publicationId="e1a3-795b-be05-784b">
      <rules>
        <rule name="Field Upgrades" id="829b-745a-349c-d000" hidden="false">
          <description>Friendly Ironkin Steeljacks units within 6" may re-roll to-hit rolls of 1 when shooting</description>
        </rule>
        <rule name="Note" id="eb1e-1186-f8fa-de58" hidden="false">
          <description>Independent Character (may only join Ironkin Steeljacks, Brôkhyr Thunderkyn or Hearthkyn Warriors)</description>
        </rule>
        <rule name="Science Guild Support" id="72cc-f62b-afac-0a12" hidden="false">
          <description>While within 3" of another friendly Votann Infantry unit and not joined to a unit, enemy units may only target the Evaluator with Shooting Attacks if it is the closest visible enemy unit</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Eye of the Ancestors" id="7265-51f8-fecb-bce6" hidden="false" targetId="9a27-359a-8678-d056" type="rule" />
        <infoLink name="League (X)" id="1c72-bb42-689e-0201" hidden="false" targetId="8aaa-89ad-e8cb-8d09" type="rule" />
        <infoLink name="Stubborn Kin" id="1f90-caa0-d5a1-29c5" hidden="false" targetId="b9c6-1e4f-c03f-56fb" type="rule" />
      </infoLinks>
