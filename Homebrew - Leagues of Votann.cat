    <selectionEntry type="unit" import="true" name="Brôkhyr Interlocking Bulwark" hidden="false" id="1772-057b-e364-34e3" publicationId="e1a3-795b-be05-784b">
      <rules>
        <rule name="Stabilized Firing Step" id="f587-9942-b69c-83be" hidden="false">
          <description>Friendly Legiones Votann Infantry models within 1" of a Brôkhyr Interlocking Bulwark count as having remained stationary when firing Heavy or Salvo weapons (provided they did not move during their preceding Movement phase), and may re-roll To Hit rolls of 1 when firing Autocannon, Bolt, or HYLas weapons</description>
        </rule>
        <rule name="Grudge-Ledger Telemetry" id="ff1f-b844-97e1-91e1" hidden="false">
          <description>At the start of your Shooting phase, if at least one friendly Legiones Votann unit is within 1" of this Barricade, select one visible enemy unit within 24" of any section of the Barricade; friendly Legiones Votann units within 1" of the Barricade treat that enemy unit as having +1 Judgement Token (to a maximum of 2) until the end of that Shooting phase</description>
        </rule>
        <rule name="Stubborn Bastion" id="4d19-39dd-dbd0-e6f6" hidden="false">
          <description>Friendly Legiones Votann Infantry units within 1" of a Brôkhyr Interlocking Bulwark gain the Stubborn special rule and may re-roll failed Pinning tests</description>
        </rule>
        <rule name="Note" id="decd-cb7f-d3c6-efaa" hidden="false">
          <description>Heavy, modular blast-shields forged from dense void-hardened alloys and anchored by hydraulic ground-clamps, providing Kin oathbands with an immovable firing line.</description>
        </rule>
        <rule name="Note" id="dc32-423e-5786-542f" hidden="false">
          <description>The Brôkhyr Interlocking Bulwark is made up of 4 long sections and 4 short sections. The Ironkin Sentry-Mount is deployed within 1" of any section of the Bulwark; its weapon is an Automated Fire weapon (BS 3) with a 360° line of sight.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Barricade Fortification" id="6633-4ba8-32fa-4fd3" hidden="false" targetId="3d9c-eca1-5612-ad2b" type="rule" />
      </infoLinks>
      <categoryLinks>
        <categoryLink targetId="36c3-e85e-97cc-c503" id="df57-46d4-99aa-1de1" primary="false" name="Unit:" />
      </categoryLinks>
