<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="6e1c-15c5-ec26-3399" name="Homebrew - Leagues of Votann" revision="3" battleScribeVersion="2.03" library="false" gameSystemId="28d4-bd2e-4858-ece6" gameSystemRevision="130" type="catalogue" authorName="Isaac">
  <publications>
    <publication id="e1a3-795b-be05-784b" name="Leagues of Votann for The Horus Heresy 2.0 — Homebrew Conversion" shortName="HB - Leagues of Votann" />
  </publications>
  <selectionEntries>
    <selectionEntry type="upgrade" import="true" name="Leagues of Votann" hidden="false" id="af4f-b87c-fd33-0f49" publicationId="e1a3-795b-be05-784b">
      <constraints>
        <constraint type="min" value="1" field="selections" scope="force" shared="true" id="17ec-429b-92cd-9223" percentValue="false" includeChildSelections="true" includeChildForces="false" />
        <constraint type="max" value="1" field="selections" scope="force" shared="true" id="ccf7-97f6-5b38-8953" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile name="Grudgekeepers" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="d7ef-901b-fcf6-8dcc">
          <characteristics>
            <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Votann unit is selected as the target of a Shooting Attack. After the attack is resolved, the attacking unit gains one Judgement token (to a maximum of two), and the Votann unit may make a Return Fire Shooting Attack against it.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink targetId="e90d-e5a8-f42d-da84" id="1ebc-4643-8ad5-6f4a" primary="true" name="Allegiance:" />
        <categoryLink targetId="3c8e-5a1d-9b47-e2f0" id="fa35-073e-0f42-5d6f" primary="false" name="Xenos Army" />
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="League" hidden="false" id="6fd5-ac50-fc3b-92fb">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="63aa-6c7c-4c34-9949" percentValue="false" includeChildSelections="false" includeChildForces="false" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="926e-0757-2ff1-99d1" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Greater Thurian League" hidden="false" id="53a0-2151-818f-1792" publicationId="e1a3-795b-be05-784b">
              <profiles>
                <profile name="Hold the Hold" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="37c5-9722-29cc-3135">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: an enemy unit declares a charge against a Greater Thurian unit. Instead of firing Overwatch, the unit gains Counter-Charge (1) until the end of the phase†.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Ancestral Bloodlines" id="a3e8-913e-3528-2f11" hidden="false">
                  <description>the unit adds 1 to its Leadership, to a maximum of 10.</description>
                </rule>
                <rule name="Bastions of Grit" id="6a1b-2b9c-dcdf-e94c" hidden="false">
                  <description>Infantry units that did not move in their previous turn have Feel No Pain (6+).</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Kronus Hegemony" hidden="false" id="c420-ead6-6567-06b5" publicationId="e1a3-795b-be05-784b">
              <profiles>
                <profile name="Strike First" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="a9a4-15cb-e43a-6631">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Kronus unit is selected as the target of a Shooting Attack. The unit makes a Return Fire Shooting Attack before the enemy attack is resolved, instead of after it.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Hegemony's Wrath" id="6d63-914b-01a8-917a" hidden="false">
                  <description>the unit adds 1 to its charge distance rolls.</description>
                </rule>
                <rule name="Long Memory" id="f5d8-ca41-b23b-f268" hidden="false">
                  <description>when choosing Judgement targets after deployment, choose up to three enemy units instead of two.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Trans-Hyperian Alliance" hidden="false" id="f1d3-30f8-4eba-00eb" publicationId="e1a3-795b-be05-784b">
              <profiles>
                <profile name="Rapid Redeployment" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="6fca-fb4a-96a3-b757">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Movement phase). Trigger: an enemy unit ends a move within 12" of a Trans-Hyperian vehicle. The vehicle moves up to 6" in any direction.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Mechanised Kin" id="c83a-4599-1927-c9db" hidden="false">
                  <description>vehicles add 2 to their Movement Characteristic.</description>
                </rule>
                <rule name="Rapid Disembark" id="2779-9242-a533-344e" hidden="false">
                  <description>Infantry that disembark from a transport may shoot in the same turn as though they had not moved.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Urani-Surtr Regulates" hidden="false" id="6323-25ed-9221-9ff4" publicationId="e1a3-795b-be05-784b">
              <profiles>
                <profile name="Ambush Fire" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="da7a-f813-24ae-91b0">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Movement phase). Trigger: an enemy unit ends a move within 12" of a Urani-Surtr Infantry or Cavalry unit. The unit makes a Shooting Attack against the triggering unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Pathfinders" id="9132-e36a-7f71-3a4a" hidden="false">
                  <description>Hernkyn units gain the Outflank special rule†.</description>
                </rule>
                <rule name="Precise Fire" id="1762-cbb6-8b68-611c" hidden="false">
                  <description>the unit may re-roll to-wound rolls of 1 with ranged weapons.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ymyr Conglomerate" hidden="false" id="a97e-906d-8554-dab7" publicationId="e1a3-795b-be05-784b">
              <profiles>
                <profile name="Emergency Shielding" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="a72a-056c-6a1b-7e32">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Ymyr vehicle is selected as the target of a Shooting Attack. Against that attack, the vehicle gains a 5+ Invulnerable Save.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Master Artisans" id="3fe9-860a-e963-51cc" hidden="false">
                  <description>models with Battlesmith improve it by 1, to a best of 3+.</description>
                </rule>
                <rule name="Self-repairing Hulls" id="bff7-5ba1-65db-b250" hidden="false">
                  <description>vehicles gain Grot Riggers (6+)-style self-repair: at the end of each of your turns, roll a D6 for each damaged vehicle; on a 6 it restores one lost Hull Point.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Rite of War" hidden="false" id="c60f-0f51-88e3-d6ea">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5f7c-2f5c-702b-091a" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Brôkhyr Guild" hidden="false" id="19ae-b857-e068-48e5" publicationId="e1a3-795b-be05-784b">
              <rules>
                <rule name="Effects" id="54cb-676f-fa39-09ea" hidden="false">
                  <description>Brôkhyr Thunderkyn may be taken as Troops; every model with Battlesmith improves it by 1.</description>
                </rule>
                <rule name="Limitations" id="a409-344e-7cc4-f044" hidden="false">
                  <description>Requires a Brôkhyr Iron-master as Warlord.   the army may not include more Infantry units than it has vehicle and Thunderkyn units combined.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="8dca-7fbd-74a5-ea78" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Hekaton Spearhead" hidden="false" id="c4a2-a5d1-c625-5db5" publicationId="e1a3-795b-be05-784b">
              <rules>
                <rule name="Effects" id="a99c-650e-c49e-45a7" hidden="false">
                  <description>Hekaton Land Fortresses may be taken as Heavy Support or Lord of War choices, and gain Scout.</description>
                </rule>
                <rule name="Limitations" id="8be2-405d-b21b-d586" hidden="false">
                  <description>Requires any Votann HQ as Warlord, starting the game embarked on a Hekaton Land Fortress.   every Infantry unit must start the game embarked on a transport.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="395c-264f-ed89-59c9" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Oathband" hidden="false" id="8aa3-8686-1953-11df" publicationId="e1a3-795b-be05-784b">
              <modifiers>
                <modifier type="set" field="cb2c-2a1a-fd8a-5e1a" value="0">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="20ef-cd01-a8da-376e" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="cb2c-2a1a-fd8a-5e1a" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule name="Effects" id="c7f8-8338-9978-0c01" hidden="false">
                  <description>Einhyr Hearthguard may be taken as Troops and gain the Line sub-type.</description>
                </rule>
                <rule name="Limitations" id="9769-8213-4e50-2163" hidden="false">
                  <description>Requires a Kâhl or Ûthar the Destined as Warlord.   no Fast Attack choices.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="e7bd-b4ab-39c9-9285" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Prospector Fleet" hidden="false" id="8202-0016-eb84-9b6d" publicationId="e1a3-795b-be05-784b">
              <modifiers>
                <modifier type="set" field="f626-2bf3-811c-4e1d" value="0">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="7031-469a-1aeb-eab0" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f626-2bf3-811c-4e1d" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule name="Effects" id="d01e-2a20-b727-a0ed" hidden="false">
                  <description>Hernkyn Pioneers and Hernkyn Yaegirs may be taken as Troops and gain the Line sub-type.</description>
                </rule>
                <rule name="Limitations" id="8e8d-e7de-6fc8-51f0" hidden="false">
                  <description>Requires any Votann HQ as Warlord.   no Heavy Support choices.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="0096-c9f7-15cb-ed6c" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
      </costs>
    </selectionEntry>
