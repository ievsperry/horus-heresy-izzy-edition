            </infoLink>
            <infoLink id="ce3d-b616-f3a1-1a2e" name="Pinning" hidden="false" targetId="1c96-205c-59a0-3cf2" type="rule"/>
            <infoLink id="8fa0-04b1-17fe-42e8" name="Armourbane (X)" hidden="false" targetId="cb59-f920-f071-7cd4" type="rule">
