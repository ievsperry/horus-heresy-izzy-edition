      <selectionEntries>
        <selectionEntry id="493a-5efa-8772-b9c9" name="The Vodian Sceptre" publicationId="bde1-6db1-163b-3b76" page="63" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
