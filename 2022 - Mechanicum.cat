    <selectionEntry type="upgrade" import="true" name="Conversion Field" hidden="false" id="a995-6a4e-8cd1-01b9">
      <profiles>
        <profile name="Conversion Field" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="9a15-c3a5-980d-856f">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The bearer has a 4+ Invulnerable Save. At the end of a phase in which it passes one or more of these saves, every enemy unit within 6" must test as if hit by a Blind weapon. Friendly units are not affected.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="1742-fbe6-1ad5-f317" hidden="false" targetId="0fc2-757c-fd37-2526" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (4+)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Emanatus Forcefield" hidden="false" id="af46-5c68-a222-936c">
      <profiles>
        <profile name="Emanatus Forcefield" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="9af4-4061-dc12-2d52">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The bearer has a 6+ Invulnerable Save, improved by 1 for each other model with an emanatus forcefield within 5", to a maximum of 4+. A bearer with a Wounds Characteristic that suffers an unsaved Instant Death wound loses D3 Wounds instead of being removed. When the bearer loses its last Wound or Hull Point, before it is removed or replaced with a Wreck, every model within D6+2", friendly or enemy, suffers an automatic hit at Strength 8, AP -.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="9e66-f711-78e4-e999" hidden="false" targetId="0fc2-757c-fd37-2526" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (6+)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Voltagheist Field" hidden="false" id="7470-7c70-5af6-213e">
      <profiles>
        <profile name="Voltagheist Field" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="88b6-8251-0f8f-0b00">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The bearer has a 5+ Invulnerable Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="4191-4a9a-3a5d-f3a2" hidden="false" targetId="0fc2-757c-fd37-2526" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (5+)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Crawler Systems" hidden="false" id="a010-fc1a-0a2b-f840">
      <profiles>
        <profile name="Crawler Systems" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="9ac9-4eda-c627-0ba8">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The model gains the Crawler Sub-type and its Movement becomes 8.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Hover Nacelles" hidden="false" id="78aa-23b3-273b-cadc">
      <profiles>
        <profile name="Hover Nacelles" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="78ee-c3c3-988a-d90a">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The model gains the Slow and Skimmer Sub-types.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Track Units" hidden="false" id="dd95-db40-6c6c-a0eb">
      <profiles>
        <profile name="Track Units" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="2d7d-5da5-acd9-cae7">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The model gains the Slow Sub-type.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Aggression Stim-Injectors" hidden="false" id="f473-a076-2978-9a4f">
      <profiles>
        <profile name="Aggression Stim-Injectors" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="a7a8-f028-6808-0f6d">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The model gains Furious Charge (1) and Rage (2).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Stealth Suite Module" hidden="false" id="6e88-e3d4-9748-5c2d">
      <profiles>
        <profile name="Stealth Suite Module" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="1171-69d3-6927-8607">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The model gains Infiltrate, Pathfinder, Scout and Shrouded (5+).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Preysight Cogitators" hidden="false" id="ce13-0ee5-30c9-0df6">
      <profiles>
        <profile name="Preysight Cogitators" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="834b-ed03-dfe0-e891">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The model gains Precision Shots (5+) and Scout.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Sulphurite Reservoirs" hidden="false" id="f147-4abc-a846-b48f">
      <profiles>
        <profile name="Sulphurite Reservoirs" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="ca57-4e6a-f51d-4430">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The model gains Fleet (2) and Rad-Saturation, and is equipped with a sulphur ejector.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Battle-Automata Cradles" hidden="false" id="e696-259c-54cd-18b9">
      <profiles>
        <profile name="Battle-Automata Cradles" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="5d88-a06c-3e3c-5f58">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The model may transport a single Castellax or Vorax Battle-Automata unit of no more than two models, even if it does not have the Transport Capacity for them or has rules that would otherwise prevent it.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Battle Servitor Control" hidden="false" id="c8c4-3f1a-678e-342a">
      <profiles>
        <profile name="Battle Servitor Control" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="0269-23a2-cbd8-97d3">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The model gains Sunder.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Ironstrider Engine" hidden="false" id="0b98-f0d8-8e72-4632">
      <profiles>
        <profile name="Ironstrider Engine" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="9996-1aa4-0daa-549e">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The model's Unit Type becomes Cavalry, keeping its Sub-types, and it gains the Skirmish Sub-type. Its Movement becomes 12, and it gains Firing Protocols (2), Fleet (2), Hammer of Wrath (1) and Prototype Construct. A model with a Wounds Characteristic that suffers an unsaved Instant Death wound loses 2 Wounds instead of being removed. When it loses its last Wound or Hull Point, before it is removed or replaced with a Wreck, every model within D6", friendly or enemy, suffers an automatic hit at Strength 7, AP -.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Magno-Gravitic Thrusters (Remiare)" hidden="false" id="314e-b146-6fec-77be">
      <profiles>
        <profile name="Magno-Gravitic Thrusters (Remiare)" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="0cad-cd77-5cf8-bad9">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The model is not slowed by Difficult Terrain and automatically passes Dangerous Terrain tests.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Omnispex" hidden="false" id="6314-ee31-ab89-e2c9">
      <profiles>
        <profile name="Omnispex" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="e73e-15cc-fd55-ca74">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A unit with at least one omnispex gains Night Vision. While the bearer is alive, Cover Saves against the unit's attacks are made at -1. This does not stack with a second omnispex in the unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Personal Void (Koriel Zeth)" hidden="false" id="c34a-52f7-a349-19ef">
      <profiles>
        <profile name="Personal Void (Koriel Zeth)" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="91e9-f197-0646-f642">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Koriel Zeth has a 3+ Invulnerable Save and ignores the first wound she suffers from a failed Invulnerable Save in each battle. She may also re-roll failed Characteristic tests other than Leadership tests, Psychic checks and Dangerous Terrain tests.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="ab1c-7b8e-2fd1-9a5e" hidden="false" targetId="0fc2-757c-fd37-2526" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (3+)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Sapien (Arkhan Land)" hidden="false" id="e6dd-9be4-2561-6e86">
      <profiles>
        <profile name="Sapien (Arkhan Land)" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="14c2-fded-4134-faf9">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Gives Arkhan Land all the benefits of a cyber-familiar. Once per turn he may also make one additional attack with the Sapien's Sting profile (see Named Character Weapons); no other attacks may be made with it.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Scapuli-Pattern Thruster Pack" hidden="false" id="f320-eac4-3d74-9fbb">
      <profiles>
        <profile name="Scapuli-Pattern Thruster Pack" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="93c0-ad08-3a58-79f9">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">At the start of the controlling player's Movement phase, or when deployed by Deep Strike Assault, the model may activate the pack: its Movement becomes 14 for that turn, with every benefit of that value, including the Charge bonus. While activated, it ignores terrain when moving and charging, but must take Dangerous Terrain tests when starting or ending a move in Dangerous Terrain. It may move over friendly and enemy models without penalty but must end at least 1" from models in other units.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
