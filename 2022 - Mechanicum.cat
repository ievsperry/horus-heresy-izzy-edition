          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The model gains Ferromantic Invulnerability (*Legacies of the Age of Darkness*, page 24), and its Hull Points and Armour Values each increase by 1.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Self-Repair Systems" hidden="false" id="c050-3960-d9f0-47bb">
      <profiles>
        <profile name="Self-Repair Systems" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="6750-fd20-d221-1b2b">
