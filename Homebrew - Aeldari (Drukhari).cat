        <infoLink name="Master of the Kabal" id="d578-0590-97af-95ac" hidden="false" targetId="5d9f-5b00-6524-9f3e" type="rule" />
        <infoLink name="Power From Pain" id="298b-af14-b973-6375" hidden="false" targetId="ceac-7e1a-2851-4684" type="rule" />
        <infoLink name="Precision Shots (X)" id="44cf-9dcc-44bd-6540" hidden="false" targetId="4b71-81ee-31f4-fa09" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Precision Shots (4+)" />
          </modifiers>
        </infoLink>
        <infoLink name="Precision Strikes (X)" id="90a6-ccd9-c4d3-4261" hidden="false" targetId="2206-8497-8fe1-e973" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Precision Strikes (4+)" />
          </modifiers>
        </infoLink>
        <infoLink name="Retinue" id="deae-8591-bcd4-85ba" hidden="false" targetId="6b79-ac44-4d89-2124" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Retinue (Kabalite Trueborn)" />
          </modifiers>
        </infoLink>
      </infoLinks>
      <categoryLinks>
        <categoryLink targetId="36c3-e85e-97cc-c503" id="8d57-ec4a-3ad3-9cce" primary="false" name="Unit:" />
      </categoryLinks>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Archon" hidden="false" id="6b98-b454-14f6-f783" publicationId="9356-fc9b-2fee-7d11">
