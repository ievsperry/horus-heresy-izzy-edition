    <selectionEntry type="unit" import="true" name="Asdrubael Vect on the Dais of Destruction" hidden="false" id="153f-e81a-da0a-b0fe" publicationId="9356-fc9b-2fee-7d11">
      <modifiers>
        <modifier type="set" field="3c8a-46e2-9a02-a7be" value="0">
          <conditions>
            <condition type="atLeast" value="1" field="selections" scope="roster" childId="3214-efaf-e7dd-6b87" shared="true" includeChildSelections="true" includeChildForces="true" />
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="3c8a-46e2-9a02-a7be" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule name="Throne of the Tyrant" id="48ab-b518-8588-6269" hidden="false">
          <description>While Vect is embarked, the Dais uses his Leadership, he may issue his Master of Commorragh redeployment as normal, and he may fight in close combat from the Dais against enemies in base contact with it</description>
        </rule>
        <rule name="Master of Commorragh" id="1b82-e815-1c7b-77e8" hidden="false">
          <description>Once per game, at the start of your turn, you may redeploy up to 3 friendly units, including those in Reserves, as though deploying them</description>
        </rule>
        <rule name="Supreme Commander" id="9dbb-58a6-d401-5715" hidden="false">
          <description>If he is in your army, Vect must be your Warlord</description>
        </rule>
      </rules>
