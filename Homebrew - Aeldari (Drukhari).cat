                <characteristic name="I" typeId="62d3-22d7-2d49-52dc">6</characteristic>
                <characteristic name="A" typeId="f111-2ce5-dd12-d6b0">3</characteristic>
                <characteristic name="Ld" typeId="e8a6-1da9-d384-8727">10</characteristic>
                <characteristic name="Save" typeId="e593-6b3c-f169-04f0">4+</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="8b4f-bfe2-ce7b-f1b1" id="3081-f557-a515-d6eb" primary="false" name="Infantry Unit Type" />
            <categoryLink targetId="4f07-3d45-4f28-a0c6" id="6c8d-733a-7541-3ac0" primary="false" name="Independent Character" />
          </categoryLinks>
          <selectionEntryGroups>
            <selectionEntryGroup name="Exchange close combat weapon" hidden="false" id="c221-7375-b2b3-fec0" defaultSelectionEntryId="df38-f9b4-73da-c7fd">
