  <sharedSelectionEntryGroups>
    <selectionEntryGroup name="Warlord Traits" hidden="false" id="76b1-0683-1d7a-dca0">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6209-62c2-0098-3a5b" percentValue="false" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Ancient Evil" hidden="false" id="1839-1687-df07-1903" publicationId="9356-fc9b-2fee-7d11">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="adc7-5201-c954-642b" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Ancient Evil" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="be5f-f7be-0ec8-b48d">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">*A being so old and so cruel that lesser creatures quail in its presence.* Enemy units within 12" of the Warlord subtract 1 from their Leadership. In addition, while the Warlord is on the battlefield, your army may make one additional reaction in your opponent's Movement phase, above its normal Reaction Allotment.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="9138-9800-299a-a0a5" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Labyrinthine Cunning" hidden="false" id="a1e8-c527-0a99-7290" publicationId="9356-fc9b-2fee-7d11">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2da7-b63f-a6f5-fd21" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Labyrinthine Cunning" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="18c8-996b-ae4e-54d0">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">*A schemer whose plans have plans, and who is never where the enemy expects.* You may re-roll one Reserves roll each turn. In addition, while the Warlord is on the battlefield, your army may make one additional reaction in your opponent's Shooting phase, above its normal Reaction Allotment.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="3c14-d669-8212-89c9" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Master of Pain" hidden="false" id="73cf-f9cf-65da-0a26" publicationId="9356-fc9b-2fee-7d11">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="80d5-e58c-c2fc-2b65" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Master of Pain" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="24bc-c182-5fd3-5262">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">*A connoisseur of agony who drinks deep of every scream.* The Warlord and any unit it joins improve their Feel No Pain by 1. In addition, while the Warlord is on the battlefield, your army may make one additional reaction in your opponent's Assault phase, above its normal Reaction Allotment.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="a131-2c11-b09e-03a3" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Lord of the Black Raid" hidden="true" id="f077-e7e3-9675-b2e7" publicationId="9356-fc9b-2fee-7d11">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="ce4e-872d-8070-4ec4" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6155-88ad-be09-def2" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Lord of the Black Raid" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="41e6-24ff-12cb-2e3d">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Kabalite overlord orchestrates battlefield violence with terrifying precision, ensuring every strike falls exactly where resistance is weakest. The Warlord gains Master of the Raid and Fear (1). In addition, friendly units within 12" of the Warlord gain Precision Shots (6+). If a unit already possesses Precision Shots, improve its value by +1 instead, to a maximum of Precision Shots (4+).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="ca47-5631-43ae-f2d9" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Queen of Knives" hidden="true" id="0c92-a11a-c374-7eff" publicationId="9356-fc9b-2fee-7d11">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="67bd-95ce-b863-267c" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b375-3760-febb-8c03" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Queen of Knives" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="f62d-6fb8-5e25-12d0">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord is a legendary arena champion whose impossible speed and theatrical violence drives nearby warriors into ecstatic bloodshed. The Warlord gains Master of the Raid, Combat Drugs (4) and Fear (1). In addition, friendly units within 12" gain Fleet (1). If a unit already possesses Fleet, improve its value by +1 instead, to a maximum of 4.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="fdc1-8c6e-be08-6a9b" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Master of Agonies" hidden="true" id="6995-ccfd-17ac-08c1" publicationId="9356-fc9b-2fee-7d11">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="fd0f-3891-a5fa-7e66" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="08cb-c7cc-6ab9-b63d" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Master of Agonies" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="84e4-e770-f8ef-6be1">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Haemonculus Warlord reshapes flesh and suffering into weapons, driving nearby creations beyond mortal limitations. The Warlord gains Master of the Raid, Fear (2) and It Will Not Die (5+). In addition, friendly units within 12" with the Fleshcrafted Horror Special Rule improve their Feel No Pain rolls by +1 to a maximum of Feel No Pain (4+).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="61cd-2ad0-e468-3219" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Hatred Eternal" hidden="true" id="5bc9-6e69-633d-e7e1" publicationId="9356-fc9b-2fee-7d11">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="de4f-9184-2051-a4c2" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1998-c090-7b5d-d554" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Hatred Eternal" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="0d97-a95c-6c66-34f6">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord and any unit it joins have Hatred against every enemy.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="0041-64b7-3285-ea2e" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Soul Thirst" hidden="true" id="94e8-3d4a-a9f2-9809" publicationId="9356-fc9b-2fee-7d11">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="4e92-1ff0-9a92-9637" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d6f4-816c-19a1-7fc7" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Soul Thirst" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="da1e-45ec-1141-64f7">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">Each time the Warlord slays an enemy model in close combat, it restores one lost Wound, up to its starting value.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="af7f-9584-a9cb-1df5" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Precision Killer" hidden="true" id="24fb-3359-35e3-eec5" publicationId="9356-fc9b-2fee-7d11">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="419c-b6cb-9b92-158b" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0e97-25b8-d09c-a121" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Precision Killer" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="0145-7573-c713-2ec6">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord's melee weapons gain Murderous Strike (5+).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="863f-ca09-c654-18a3" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Hyper-swift Reflexes" hidden="true" id="3b7d-f157-a8f3-4f7c" publicationId="9356-fc9b-2fee-7d11">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="408a-a25b-c7ac-aeb9" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ef92-b54d-dffc-78e6" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Hyper-swift Reflexes" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="faa7-ea69-981b-e019">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord and any unit it joins add 1 to their Initiative and gain Outflank.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="e969-6ada-1998-c06e" primary="true" name="Warlord Traits:" />
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Dread Master" hidden="true" id="88b9-f214-7f5f-d8ae" publicationId="9356-fc9b-2fee-7d11">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="0e92-1880-6c23-4679" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0a4a-df6f-173d-b760" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Dread Master" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="f276-81c1-6607-8a8b">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">Enemy units within 12" of the Warlord subtract a further 1 from their Leadership.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <categoryLinks>
            <categoryLink targetId="1158-146a-d9a0-39ad" id="9964-4458-24a2-4885" primary="true" name="Warlord Traits:" />
