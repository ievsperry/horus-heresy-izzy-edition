                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="319f-4ff8-17ab-3b65" percentValue="false" includeChildSelections="false" includeChildForces="false" />
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="35d8-a686-4c48-7232" percentValue="false" includeChildSelections="false" includeChildForces="false" />
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3abf-55b1-2210-822a" percentValue="false" includeChildSelections="false" includeChildForces="false" />
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e186-c586-bb5c-deea" percentValue="false" includeChildSelections="false" includeChildForces="false" />
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5d9e-b726-c143-79b2" percentValue="false" includeChildSelections="false" includeChildForces="false" />
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="efe4-b5c0-f452-6c8d" percentValue="false" includeChildSelections="false" includeChildForces="false" />
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="cb81-1b22-bcc9-6801" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule name="Effects" id="2fea-1e78-e8ed-4903" hidden="false">
                  <description>Reavers and Hellions may be taken as Troops and gain the Line sub-type.</description>
                </rule>
                <rule name="Limitations" id="67db-bff6-da54-ed95" hidden="false">
                  <description>Requires a Succubus, Master Succubus or Lelith Hesperax as Warlord.   no Haemonculus Coven units (Haemonculus, Master Haemonculus, Wracks, Haemoxytes, Grotesques, Talos Pain Engine, Cronos Parasite Engine).</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="cee8-9a99-4b56-4c25" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Coven Experiments" hidden="false" id="67b7-e6c0-508e-2918" publicationId="9356-fc9b-2fee-7d11">
              <modifiers>
                <modifier type="set" field="6588-35af-ddc2-5fde" value="0">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="20ef-cd01-a8da-376e" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6588-35af-ddc2-5fde" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule name="Effects" id="8354-8554-1b2c-48fc" hidden="false">
                  <description>Talos Pain Engines and Cronos Parasite Engines may be taken as Troops.</description>
                </rule>
                <rule name="Limitations" id="d761-0785-29f2-5c34" hidden="false">
                  <description>Requires a Haemonculus, Master Haemonculus or Urien Rakarth as Warlord.   the army may not include more Infantry units than it has Bio-Construct units, and no Fast Attack choices.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="65a3-dd96-6e7a-dbaa" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Realspace Raid" hidden="false" id="3eab-0304-ba1a-b313" publicationId="9356-fc9b-2fee-7d11">
              <rules>
                <rule name="Effects" id="dcf0-c57b-8f79-778b" hidden="false">
                  <description>units may disembark from a Raider or Venom after it has moved at full speed, and may charge in the same turn.</description>
                </rule>
                <rule name="Limitations" id="b6d3-ba21-d1c1-23bb" hidden="false">
                  <description>Requires an Archon or Master Archon as Warlord.   every Infantry unit must start the game embarked on a transport.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="1b9a-0973-9646-c374" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
