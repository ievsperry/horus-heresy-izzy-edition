          <profiles>
            <profile name="Diabolical Soothsayer" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="9bbc-eed2-46f5-5f2d">
              <characteristics>
                <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord has a 4+ Invulnerable Save.</characteristic>
