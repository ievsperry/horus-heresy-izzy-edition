    <selectionEntry type="unit" import="true" name="Lelith Hesperax" hidden="false" id="7dea-125f-1f5e-2a01" publicationId="9356-fc9b-2fee-7d11">
      <rules>
        <rule name="Queen of Knives" id="d1a7-b876-a297-2db3" hidden="false">
          <description>Lelith Hesperax gains Rampage (3). During a Challenge, Lelith Hesperax gains Reach (2) and Murderous Strike (4+)</description>
        </rule>
        <rule name="Perfect Dodge" id="ad4b-4ee8-1aec-03d9" hidden="false">
          <description>In melee, failed Invulnerable Saves made by Lelith Hesperax may be re-rolled</description>
        </rule>
        <rule name="The Deadliest Blade" id="473d-72af-508c-095f" hidden="false">
          <description>Enemy models in base contact with Lelith Hesperax suffer -1 Weapon Skill and may not make reactions during Assaults involving Lelith Hesperax</description>
        </rule>
      </rules>
      <infoLinks>
