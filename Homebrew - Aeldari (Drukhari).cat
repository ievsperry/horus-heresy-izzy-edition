    <selectionEntry type="unit" import="true" name="Tantalus" hidden="false" id="d072-0316-8f4a-a2e3" publicationId="9356-fc9b-2fee-7d11">
      <rules>
        <rule name="Dire Scythe Blades" id="9371-b76a-acb8-d059" hidden="false">
          <description>Whenever a Tantalus successfully Charges, Tank Shocks, or ends a move that passes over one or more enemy Infantry, Cavalry, Swarm or Jetbike models, select one enemy unit affected by that movement. That unit suffers D6 Strength 7 AP - hits with the Rending (6+) special rule. Dire Scythe Blades have no effect against units with the Dreadnought, Automata, Vehicle, Knight, Titan or Building Unit Types</description>
        </rule>
      </rules>
