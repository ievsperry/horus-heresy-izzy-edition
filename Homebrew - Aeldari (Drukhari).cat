    <selectionEntry type="unit" import="true" name="Mandrakes" hidden="false" id="cd59-d9cf-8cf3-243b" publicationId="9356-fc9b-2fee-7d11">
      <rules>
        <rule name="Shadow Step" id="45e1-d14b-586c-7f86" hidden="false">
          <description>If the unit is not locked in combat it may return to Reserves at the end of any turn. If the unit is locked in combat it must win a contested D6 + Initiative check to return to Reserves; if it fails this roll it suffers D3 Strength 6 AP 6 Hits. The unit returns to play during the following turn as if it had successfully passed its Reserve roll</description>
        </rule>
      </rules>
