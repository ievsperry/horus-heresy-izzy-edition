<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="8f64-16d5-e3fa-06cc" name="Homebrew - Aeldari (Drukhari)" revision="18" battleScribeVersion="2.03" library="false" gameSystemId="28d4-bd2e-4858-ece6" gameSystemRevision="130" type="catalogue" authorName="Isaac">
  <publications>
    <publication id="9356-fc9b-2fee-7d11" name="Drukhari for The Horus Heresy 2.0 — Homebrew Conversion" shortName="HB - Drukhari" />
  </publications>
  <selectionEntries>
    <selectionEntry type="upgrade" import="true" name="Drukhari" hidden="false" id="897b-5b98-3dff-b74a" publicationId="9356-fc9b-2fee-7d11">
      <constraints>
        <constraint type="min" value="1" field="selections" scope="force" shared="true" id="2011-d398-c8ea-4059" percentValue="false" includeChildSelections="true" includeChildForces="false" />
        <constraint type="max" value="1" field="selections" scope="force" shared="true" id="f112-5131-73ce-0ada" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile name="Lightning Withdrawal" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="99f0-a082-8caf-edaa">
          <characteristics>
            <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Drukhari Infantry, Cavalry or vehicle unit is selected as the target of a Shooting Attack. Before the attack is resolved, the unit moves up to D6 plus its Initiative Characteristic in inches (vehicles move up to 6"), and must end further from the attacking unit than it started. If it is then out of range or line of sight, the attack is lost.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink targetId="e90d-e5a8-f42d-da84" id="09c2-04cb-624b-aced" primary="true" name="Allegiance:" />
        <categoryLink targetId="3c8e-5a1d-9b47-e2f0" id="c288-7bbd-9bdb-432f" primary="false" name="Xenos Army" />
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Sub-faction" hidden="false" id="fe9c-de49-f9a5-d9a6">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="c3d2-494d-6b72-f381" percentValue="false" includeChildSelections="false" includeChildForces="false" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8738-de58-68a6-9bff" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Kabals" hidden="false" id="ce4e-872d-8070-4ec4" publicationId="9356-fc9b-2fee-7d11">
              <profiles>
                <profile name="Coordinated Extermination" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="da36-3295-6ec3-44a1">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(once per battle). *The Kabalites are masters of synchronized violence, annihilating exposed enemies beneath precise and overwhelming fusillades.* This Advanced Reaction may be made once per battle when an enemy unit declares a Charge, arrives via Deep Strike, or ends a Movement within 12" of a unit composed entirely of models with the Kabalite Discipline Special Rule. The Reacting unit may immediately make a Shooting Attack targeting that enemy unit. During this Shooting Attack, all ranged weapons gain Precision Shots (5+). In addition, ranged weapons gain Breaching (5+) when targeting Pinned, Falling Back or Disordered enemy units.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Kabalite Line" id="04fd-fd14-c0e0-5506" hidden="false">
                  <description>Kabalite Warriors, Kabalite Trueborn (if selected as a Troops choice), and Raiders selected as Dedicated Transports for Line units gain the Line Sub-type.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Wych Cults" hidden="false" id="67bd-95ce-b863-267c" publicationId="9356-fc9b-2fee-7d11">
              <profiles>
                <profile name="Death in Motion" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="27d3-e0fd-ca44-ab3c">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(once per battle). *The Wyches of the arenas move with impossible speed and grace, turning enemy aggression into spectacle and slaughter.* This Advanced Reaction may be made once per battle when an enemy unit declares a Charge targeting a unit composed entirely of models with the Arena Killers Special Rule. The Reacting unit immediately gains Fleet (2), Sudden Strike (2) and Reach (2). In addition, the enemy unit's Charge is considered Disordered.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Wych Cult Line" id="1e04-17f0-3d61-8061" hidden="false">
                  <description>Wyches and Bloodbrides (if selected as a Troops choice) gain the Line Sub-type.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Haemonculus Covens" hidden="false" id="fd0f-3891-a5fa-7e66" publicationId="9356-fc9b-2fee-7d11">
              <profiles>
                <profile name="Flesh Rewoven" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="9ee5-3efa-8d30-0263">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(once per battle). *The grotesque creations of the Coven absorb horrific punishment while malformed flesh rapidly stitches itself back together amidst battle.* This Advanced Reaction may be made once per battle when a unit composed entirely of models with the Fleshcrafted Horror Special Rule is targeted by a Shooting Attack or Charge. Until the end of the current Phase, the Reacting unit gains Feel No Pain (4+) and Battle-hardened (2). In addition, models in the unit with more than 1 Wound regain 1 lost Wound at the end of the current Phase on a roll of 5+.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Coven Line" id="c472-2c99-6dfd-4860" hidden="false">
                  <description>Wracks, Haemoxytes and Grotesques (if selected as a Troops choice) gain the Line Sub-type.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Obsession" hidden="false" id="e8bb-aa68-fabc-fbb6">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="df21-1e2e-7755-a3be" percentValue="false" includeChildSelections="false" includeChildForces="false" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e148-ea89-e1af-7aeb" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Kabal of the Black Heart" hidden="true" id="de4f-9184-2051-a4c2" publicationId="9356-fc9b-2fee-7d11">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="ce4e-872d-8070-4ec4" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Strike First" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="d036-48f3-761d-ae4b">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Black Heart unit is selected as the target of a Shooting Attack. The unit makes a Return Fire Shooting Attack before the enemy attack is resolved, instead of after it.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Thirst for Power" id="bdea-bda1-9516-7f03" hidden="false">
                  <description>the unit may select two effects from the Power From Pain table each time it would normally select one.</description>
                </rule>
                <rule name="Vect's Favour" id="e2d3-3a20-b8fc-0f68" hidden="false">
                  <description>the unit may re-roll failed Morale checks.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Kabal of the Poisoned Tongue" hidden="true" id="4e92-1ff0-9a92-9637" publicationId="9356-fc9b-2fee-7d11">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="ce4e-872d-8070-4ec4" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Venomous Retort" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="488d-5171-0a41-edb2">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Poisoned Tongue unit is selected as the target of a Shooting Attack. After the attack is resolved, the unit makes a Return Fire Shooting Attack whose Poisoned weapons wound on 2+†.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Serpent's Kiss" id="091d-8918-9f06-abee" hidden="false">
                  <description>enemy units engaged with this unit subtract 1 from their Leadership.</description>
                </rule>
                <rule name="Toxin Crafters" id="be62-f2b7-8df0-3f32" hidden="false">
                  <description>the unit's weapons with Poisoned (X) improve that value by 1, to a best of 2+†.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Cult of Strife" hidden="true" id="419c-b6cb-9b92-158b" publicationId="9356-fc9b-2fee-7d11">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="67bd-95ce-b863-267c" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Whirling Death" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="1aec-c7cc-6acc-84e4">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: an enemy unit declares a charge against a Cult of Strife unit. Instead of firing Overwatch, the unit gains Counter-Charge (1) and Reach (1) until the end of the phase†.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Blades of Strife" id="99d0-a652-7dc6-e18f" hidden="false">
                  <description>the unit's melee weapons gain Shred.</description>
                </rule>
                <rule name="The Spectacle of Murder" id="832b-ce6c-0aef-d951" hidden="false">
                  <description>the unit may re-roll to-hit rolls of 1 in close combat.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Cult of the Red Grief" hidden="true" id="408a-a25b-c7ac-aeb9" publicationId="9356-fc9b-2fee-7d11">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="67bd-95ce-b863-267c" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Too Fast to Catch" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="2e61-4013-7143-46f6">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Movement phase). Trigger: an enemy unit ends a move within 12" of a Red Grief unit. The unit moves up to D6 plus its Initiative Characteristic in inches (vehicles move up to 6") in any direction.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Blur of Motion" id="77c5-bf27-221b-3455" hidden="false">
                  <description>the unit increases its Fleet (X) by 1.</description>
                </rule>
                <rule name="Speed Kills" id="8f29-8885-b4b2-0744" hidden="false">
                  <description>Cavalry, Jump and vehicle units add 2 to their Movement Characteristic.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="The Dark Creed" hidden="true" id="0e92-1880-6c23-4679" publicationId="9356-fc9b-2fee-7d11">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="fd0f-3891-a5fa-7e66" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Torment" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="6dc5-218d-f025-6b9b">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: an enemy unit declares a charge against a Dark Creed unit. The charging unit must take a Leadership test; if it fails, it gains no bonuses for charging in that combat.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Fear Incarnate" id="7b27-bd53-8b57-7fa9" hidden="false">
                  <description>enemy units within 6" subtract 1 from their Leadership.</description>
                </rule>
                <rule name="Masters of Torment" id="5cc3-7996-5241-8c22" hidden="false">
                  <description>enemy units that fail a Morale check within 12" of this unit lose one additional model.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Prophets of Flesh" hidden="true" id="a088-dae4-0485-4557" publicationId="9356-fc9b-2fee-7d11">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="fd0f-3891-a5fa-7e66" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Insensible to Pain" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="d1a3-f7f0-1999-5170">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Prophets of Flesh unit is selected as the target of a Shooting Attack. Against that attack, the unit's Feel No Pain improves by a further 1.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Experimental Creations" id="2fc5-63b1-1cb1-447c" hidden="false">
                  <description>Bio-Construct models in the detachment add 1 to their Wounds Characteristic.</description>
                </rule>
                <rule name="Masters of the Flesh" id="e3c1-ced7-a529-edec" hidden="false">
                  <description>improve the unit's Feel No Pain by 1, to a best of 4+.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Rite of War" hidden="false" id="8fac-57e4-52bf-4e27">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="080c-9026-d69c-cabd" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Arena Spectacle" hidden="false" id="5b1a-dc53-2633-fb42" publicationId="9356-fc9b-2fee-7d11">
              <modifiers>
                <modifier type="set" field="319f-4ff8-17ab-3b65" value="0">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="3188-1f01-2c70-81f1" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
                <modifier type="set" field="35d8-a686-4c48-7232" value="0">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="325f-d617-8205-8435" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
                <modifier type="set" field="3abf-55b1-2210-822a" value="0">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="1f99-acf8-cf47-dbae" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
                <modifier type="set" field="e186-c586-bb5c-deea" value="0">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="3fd5-f57c-9e82-be70" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
                <modifier type="set" field="5d9e-b726-c143-79b2" value="0">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="3576-3678-7a9e-2c63" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
                <modifier type="set" field="efe4-b5c0-f452-6c8d" value="0">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="3a4c-4562-5a0b-68be" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
                <modifier type="set" field="cb81-1b22-bcc9-6801" value="0">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="0f5b-4e3d-408b-a71f" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
