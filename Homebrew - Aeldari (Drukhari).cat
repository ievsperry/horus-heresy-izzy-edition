            <profile name="Archon" typeId="4bb2-cb95-e6c8-5a21" typeName="Unit" hidden="false" id="c443-bb4c-2b11-657d" publicationId="9356-fc9b-2fee-7d11">
              <characteristics>
                <characteristic name="Unit Type" typeId="ddd7-6f5c-a939-b69e">Infantry (Independent Character)</characteristic>
