                  </constraints>
                  <costs>
                    <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="5" />
                  </costs>
                </entryLink>
                <entryLink import="true" name="Power lance" hidden="false" id="55ec-dd4a-3cb1-c070" type="selectionEntry" targetId="accb-cd04-63ac-1666">
                  <constraints>
                    <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="62a7-9551-ebb8-f9af" percentValue="false" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <costs>
                    <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="10" />
                  </costs>
                </entryLink>
                <entryLink import="true" name="Mindphase gauntlet" hidden="false" id="6b8e-cf1b-1acc-8eb3" type="selectionEntry" targetId="12a5-b6f4-6d63-3ffd">
                  <constraints>
                    <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8c33-2d32-e5ab-4b56" percentValue="false" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <costs>
                    <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="10" />
