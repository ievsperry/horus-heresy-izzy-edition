    <selectionEntry type="upgrade" import="true" name="Alkonost Combat Bike" hidden="false" id="b381-7326-32b3-11de">
      <profiles>
        <profile name="Alkonost Combat Bike" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="c109-99d1-d231-e78b">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">An Alkonost Combat Bike has a Twin-Linked Vratine Bolter. - The model becomes Cavalry (Skirmish), keeping its other Sub-types, and has Movement 16. - It gains Battle-Hardened (1), Firing Protocols (2), Hammer of Wrath (1), Shrouded (6+) and Skilled Rider. - If it Runs, its Shrouded becomes (5+) until the start of its Controlling Player's next turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Halian Heavy Jetbike" hidden="false" id="6006-35cb-f333-a8a5">
      <profiles>
        <profile name="Halian Heavy Jetbike" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="dbf0-e9b1-725a-5bc3">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A Halian Heavy Jetbike has a Heavy Snare Cannon. The model gains Shrouded (6+) in any turn it moved, or Shrouded (5+) if it Ran.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Vigilant Standard" hidden="false" id="bb8e-c90b-b6dc-f8fe">
      <profiles>
        <profile name="Vigilant Standard" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="da09-96b2-9c1b-53a5">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">- A unit with at least one model with a Vigilant Standard adds +1 to its Wounds total when working out who won a Combat in the Assault phase. - Before rolling its Fall Back distance, the unit may choose to Fall Back D6" instead of 2D6", and stops 1" from the battlefield edge rather than leaving it.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Vratine Chainmail" hidden="false" id="b371-736a-b2c6-1d7a">
      <profiles>
        <profile name="Vratine Chainmail" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="dd8d-11ee-1050-7769">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Vratine Chainmail gives a 4+ Armour Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Vratine Voidplate" hidden="false" id="e834-9c33-0e30-d83e">
      <profiles>
        <profile name="Vratine Voidplate" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="bd4a-ad3c-5c5b-21cd">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Vratine Voidplate gives a 2+ Armour Save. A unit with any models in Vratine Voidplate suffers -1 to Sweeping Advance rolls.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
