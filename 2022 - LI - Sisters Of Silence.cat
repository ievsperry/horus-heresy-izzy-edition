    <selectionEntry type="unit" import="true" name="Sikari Dar" hidden="false" id="8b09-15d1-a2c5-8532">
      <rules>
        <rule name="Silent Sisterhood (Chamber of Oblivion)" id="dc36-1fa3-ee2f-571a" hidden="false">
          <description>Silent Sisterhood (Chamber of Oblivion)</description>
        </rule>
        <rule name="Note" id="2cf4-965e-54dd-9fa3" hidden="false">
          <description>An army containing Sikari Dar may take up to two extra Fast Attack choices, which must be Pursuer Cadres. These do not count towards the Silent Sisterhood (X) Chamber limits.</description>
        </rule>
        <rule name="Note" id="9b43-08d7-9260-7f6b" hidden="false">
          <description>While Sikari Dar is the Warlord and has not been removed as a casualty, the army's Reaction Allotment is +1 in the Assault phase.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Battle-Hardened (X)" id="e555-0742-a91c-b531" hidden="false" targetId="5c3b-ed0b-4ad0-d547" type="rule">
