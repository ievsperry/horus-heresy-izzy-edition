        <selectionEntry id="ec99-d709-c5fe-8290" name="Knight Vestal" hidden="false" collective="false" import="true" type="model">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a898-e885-202e-2e58" type="min"/>
