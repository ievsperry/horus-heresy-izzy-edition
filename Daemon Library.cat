                    <condition type="atLeast" value="1" field="selections" scope="force" childId="945c-b969-75eb-19d9" shared="true" includeChildSelections="true"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3b89-dc3-165b-e9ce" type="max"/>
            <constraint type="min" value="0" field="selections" scope="parent" shared="true" id="a479-4aa6-f789-880a"/>
          </constraints>
          <profiles>
            <profile id="3c4a-d599-faa6-79a4" name="Advanced Reaction: Reality Tear (Movement Phase)" hidden="false" typeId="90b9-7fab-87db-aed3" typeName="Reactions">
              <characteristics>
                <characteristic name="Description" typeId="c627-4637-8de5-65fb">Trigger: Declared in the Movement phase, after an enemy unit ends a move within 12" of a friendly unit aligned to Formless Distortion.
Effect: Remove the reacting unit from the battlefield and immediately redeploy it via Deep Strike anywhere within 12" of its previous position (and more than 1" away from enemy models and Impassable Terrain) without scattering.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="3546-bb80-a1d7-7d1d" name="Formless Distortion" hidden="false">
              <description>Detachment Ability: Models gain the Shrouded (6+) special rule, and at the start of the controlling player's turn, may re-roll failed reserves or Deep Strike scatter dice.

Restriction: Units in a Detachment with this Dominion suffer D3+1 automatic wounds (instead of the normal D3) whenever they fail a Morale check.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="4814-4311-4ad6-4f61" name="Shrouded (X)" hidden="false" targetId="10c3-fdb0-089f-ca65" type="rule">
              <modifiers>
                <modifier type="set" field="name" value="Shrouded (6+)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <categoryLinks>
            <categoryLink targetId="9556-82c1-c70a-126e" id="d912-34cf-3f4a-8e22" primary="false" name="Formless Distortion"/>
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="b7db-bf16-47c5-dc05" name="Putrid Corruption" publicationId="8775-88f5-cfdd-24f6" page="3" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" value="0" field="df60-2ef1-7656-9bd4">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="ca6c-e8cf-7bc1-eaa0" shared="true" includeChildSelections="true"/>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="8ed0-3582-f536-c48e" shared="true" includeChildSelections="true"/>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="3d70-1d54-a791-ac60" shared="true" includeChildSelections="true"/>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="e4fb-66cd-e07d-609b" shared="true" includeChildSelections="true"/>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="9508-8124-d34a-500a" shared="true" includeChildSelections="true"/>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="1214-3abe-c6d1-2038" shared="true" includeChildSelections="true"/>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="945c-b969-75eb-19d9" shared="true" includeChildSelections="true"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="df60-2ef1-7656-9bd4" type="max"/>
            <constraint type="min" value="0" field="selections" scope="parent" shared="true" id="16d2-6ab1-cba5-8828"/>
          </constraints>
          <profiles>
            <profile id="8331-ab6d-bfa2-06c7" name="Advanced Reaction: Cloud of Flies (Shooting Phase)" hidden="false" typeId="90b9-7fab-87db-aed3" typeName="Reactions">
              <characteristics>
                <characteristic name="Description" typeId="c627-4637-8de5-65fb">Trigger: Declared in the Shooting phase, after an enemy unit selects a friendly unit aligned to Putrid Corruption as the target of a Shooting Attack, before any To Hit rolls are made.
Effect: Until the end of that Shooting Attack, all models in the reacting unit gain the Shrouded (4+) special rule, and the attacking enemy unit suffers a -1 penalty to its Ballistic Skill Characteristic (to a minimum of BS 1).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="94eb-7da4-953-529f" name="Putrid Corruption" hidden="false">
              <description>Detachment Ability: Models gain the Feel No Pain (5+) special rule (or improve an existing Feel No Pain roll by +1, to a maximum of 4+).

Restriction: Models in a Detachment with this Dominion may not make Run moves in the Shooting phase, nor may they make Sweeping Advances in the Assault phase.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="ed3a-713d-6ace-110e" name="Feel No Pain (X)" hidden="false" targetId="ec46-ff29-32e0-c2aa" type="rule">
              <modifiers>
                <modifier type="set" field="name" value="Feel No Pain (5+)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <categoryLinks>
            <categoryLink targetId="8cf6-d802-d054-6a86" id="4f2b-3140-b910-3821" primary="false" name="Putrid Corruption"/>
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="945c-b969-75eb-19d9" name="Ravenous Dissolution" publicationId="8775-88f5-cfdd-24f6" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" value="0" field="2c74-20f9-5431-4525">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="ca6c-e8cf-7bc1-eaa0" shared="true" includeChildSelections="true"/>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="8ed0-3582-f536-c48e" shared="true" includeChildSelections="true"/>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="3d70-1d54-a791-ac60" shared="true" includeChildSelections="true"/>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="e4fb-66cd-e07d-609b" shared="true" includeChildSelections="true"/>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="9508-8124-d34a-500a" shared="true" includeChildSelections="true"/>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="b7db-bf16-47c5-dc05" shared="true" includeChildSelections="true"/>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="1214-3abe-c6d1-2038" shared="true" includeChildSelections="true"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
            <modifier type="set" field="2c74-20f9-5431-4525" value="0">
              <comment>Ravenous Dissolution: no Allied Detachment</comment>
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition type="atLeast" value="1" field="forces" scope="roster" childId="d4f2-6da5-b6de-06ec" shared="true" includeChildSelections="true" includeChildForces="true" percentValue="false"/>
                    <condition type="instanceOf" value="0" field="selections" scope="ancestor" childId="d4f2-6da5-b6de-06ec" shared="true" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2c74-20f9-5431-4525" type="max"/>
            <constraint type="min" value="0" field="selections" scope="parent" shared="true" id="5850-fc1b-fba6-42b0"/>
          </constraints>
          <profiles>
            <profile id="d46a-c5bb-49eb-d311" name="Advanced Reaction: Spiteful Frenzy (Assault Phase)" hidden="false" typeId="90b9-7fab-87db-aed3" typeName="Reactions">
              <characteristics>
                <characteristic name="Description" typeId="c627-4637-8de5-65fb">Trigger: Declared in the Assault phase, immediately after one or more models in a friendly unit aligned to Ravenous Dissolution are removed as casualties during an Initiative step before that unit has fought.
Effect: For each model removed as a casualty from the reacting unit during that Initiative step, one surviving model in the reacting unit gains +1 Attack until the end of the current Assault phase (to a maximum of +2 Attacks per model), and all attacks made by the reacting unit gain Murderous Strike (5+).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="ef2f-faf6-8a1a-d10b" name="Ravenous Dissolution" hidden="false">
              <description>Detachment Ability: Models gain the Hatred (Everything) special rule. In addition, models in a Detachment with this Dominion re-roll To Wound rolls of 1 in the Assault phase against any unit containing at least one model with the Daemon, Corrupted, Corrupted Engine, Malefic, or Psyker Unit Type or Sub-type, or any unit with the Faith special rule (including units with Acts of Faith or Shield of Faith).

Restriction: A Detachment with this Dominion may never include an Allied Detachment (and may not be taken as an Allied Detachment itself).</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="cb34-6afa-fce7-6635" name="Hatred (X)" hidden="false" targetId="dc0b-fe69-6b71-e0a4" type="rule">
              <modifiers>
                <modifier type="set" field="name" value="Hatred (Everything)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <categoryLinks>
            <categoryLink targetId="2774-1a32-f196-be76" id="64c3-8913-231f-55af" primary="false" name="Ravenous Dissolution"/>
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="1214-3abe-c6d1-2038" name="Rapturous Sensation" publicationId="8775-88f5-cfdd-24f6" page="3" hidden="false" collective="false" import="true" type="upgrade">
