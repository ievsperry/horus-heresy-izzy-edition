          </constraints>
          <profiles>
            <profile id="db31-f333-88d7-44f4" name="Advanced Reaction: Quicksilver Feint (Assault Phase)" hidden="false" typeId="90b9-7fab-87db-aed3" typeName="Reactions">
              <characteristics>
                <characteristic name="Description" typeId="c627-4637-8de5-65fb">Trigger: Declared in the Assault phase, immediately after an enemy unit completes a successful Charge against a friendly unit aligned to Rapturous Sensation.
Effect: During the ensuing Fight sub-phase, all models in the reacting unit fight at the Initiative 10 step regardless of their actual Initiative Characteristic, and enemy models locked in combat with the reacting unit suffer a -1 penalty to their Weapon Skill Characteristic (to a minimum of WS 1).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="1bf8-cca9-299a-6c5a" name="Rapturous Sensation" hidden="false">
              <description>Detachment Ability: Models gain a +1 bonus to their Initiative Characteristic, gain the Fleet (2) special rule, and inflict Rending (6+) on all close combat attacks (or improve an existing close combat Rending value by +1).

Restriction: Models in a Detachment with this Dominion suffer a -1 penalty to their Toughness Characteristic (to a minimum of T 1).</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="bea1-681b-9c7a-9641" name="Fleet (X)" hidden="false" targetId="ddc9-0b4b-78da-bbd2" type="rule">
              <modifiers>
                <modifier type="set" field="name" value="Fleet (2)"/>
              </modifiers>
            </infoLink>
            <infoLink id="adf9-e196-668b-09d8" name="Rending (X)" hidden="false" targetId="0ac9-fab7-aef3-de1d" type="rule">
              <modifiers>
                <modifier type="set" field="name" value="Rending (6+)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <categoryLinks>
            <categoryLink targetId="a1d4-4662-c944-19cc" id="d1d3-9004-1185-6ece" primary="false" name="Rapturous Sensation"/>
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="9508-8124-d34a-500a" name="Malevolent Artifice" publicationId="8775-88f5-cfdd-24f6" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" value="0" field="cc04-6295-5d05-77ec">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="ca6c-e8cf-7bc1-eaa0" shared="true" includeChildSelections="true"/>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="8ed0-3582-f536-c48e" shared="true" includeChildSelections="true"/>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="3d70-1d54-a791-ac60" shared="true" includeChildSelections="true"/>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="e4fb-66cd-e07d-609b" shared="true" includeChildSelections="true"/>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="b7db-bf16-47c5-dc05" shared="true" includeChildSelections="true"/>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="1214-3abe-c6d1-2038" shared="true" includeChildSelections="true"/>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="945c-b969-75eb-19d9" shared="true" includeChildSelections="true"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="cc04-6295-5d05-77ec" type="max"/>
            <constraint type="min" value="0" field="selections" scope="parent" shared="true" id="813c-889b-e59a-8005"/>
          </constraints>
          <profiles>
            <profile id="8643-7c0a-942d-1ca5" name="Advanced Reaction: Infernal Overdrive (Shooting Phase)" hidden="false" typeId="90b9-7fab-87db-aed3" typeName="Reactions">
              <characteristics>
                <characteristic name="Description" typeId="c627-4637-8de5-65fb">Trigger: Declared in the Shooting phase, after an enemy unit selects a friendly unit aligned to Malevolent Artifice as the target of a Shooting Attack.
Effect: After the enemy Shooting Attack is resolved, the reacting unit may immediately make a Return Fire Shooting Attack targeting the active enemy unit, adding +1 to the Strength Characteristic of all ranged weapons fired during that reaction.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="c488-ac28-c303-57b" name="Malevolent Artifice" hidden="false">
              <description>Detachment Ability: Models gain a +1 bonus to their Armour Save (or gain a 5+ Armour Save if they do not possess one) and gain the It Will Not Die (5+) special rule.

Restriction: Models in a Detachment with this Dominion may not make Run moves in the Shooting phase.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="d96a-5f3c-4fa4-e9d5" name="It Will Not Die (X)" hidden="false" targetId="2784-d0be-a4e2-890f" type="rule">
              <modifiers>
                <modifier type="set" field="name" value="It Will Not Die (5+)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <categoryLinks>
            <categoryLink targetId="bcf6-8350-9099-1e91" id="e208-25ca-de5b-1bc4" primary="false" name="Malevolent Artifice"/>
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="e4fb-66cd-e07d-609b" name="Infernal Tempest" publicationId="8775-88f5-cfdd-24f6" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" value="0" field="56cb-9c09-b338-b107">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="ca6c-e8cf-7bc1-eaa0" shared="true" includeChildSelections="true"/>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="8ed0-3582-f536-c48e" shared="true" includeChildSelections="true"/>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="3d70-1d54-a791-ac60" shared="true" includeChildSelections="true"/>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="9508-8124-d34a-500a" shared="true" includeChildSelections="true"/>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="b7db-bf16-47c5-dc05" shared="true" includeChildSelections="true"/>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="1214-3abe-c6d1-2038" shared="true" includeChildSelections="true"/>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="945c-b969-75eb-19d9" shared="true" includeChildSelections="true"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="56cb-9c09-b338-b107" type="max"/>
            <constraint type="min" value="0" field="selections" scope="parent" shared="true" id="6add-ddd3-87db-6d42"/>
          </constraints>
          <profiles>
            <profile id="06ad-c5f1-8a4f-5ab1" name="Advanced Reaction: Flickering Displacement (Shooting Phase)" hidden="false" typeId="90b9-7fab-87db-aed3" typeName="Reactions">
              <characteristics>
                <characteristic name="Description" typeId="c627-4637-8de5-65fb">Trigger: Declared in the Shooting phase, after an enemy unit selects a friendly unit aligned to Infernal Tempest as the target of a Shooting Attack, before any To Hit rolls are made.
Effect: Until the end of that Shooting Attack, all models in the reacting unit improve their Daemonic Invulnerable Save by +1 (to a maximum of 3+), and if the attacking unit rolls any unmodified To Hit rolls of 1, the attacking unit immediately suffers D3 automatic hits at Strength 5, AP 3, Soul Blaze.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="457b-86dd-cedd-ce60" name="Infernal Tempest" hidden="false">
              <description>Detachment Ability: Models improve their Daemonic Invulnerable Save by +1 (to a maximum of 4+), and models with the Psyker Unit Sub-type may re-roll failed Psychic checks once per phase.

Restriction: Models in a Detachment with this Dominion suffer a -1 penalty to their Strength Characteristic (to a minimum of S 1) when resolving close combat attacks in the Assault phase.</description>
            </rule>
          </rules>
          <categoryLinks>
            <categoryLink targetId="6508-4f6a-0dc1-8f56" id="f640-7c10-df4e-07fa" primary="false" name="Infernal Tempest"/>
          </categoryLinks>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="The Ætheric Dominion (X) Corrupted Engines" id="7e66-75ce-decd-dc8d" hidden="false" collective="false" import="true">
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Heedless Slaughter (Corrupted Engines)" hidden="false" id="4cd2-3d17-e493-f555" collective="false" publicationId="4934-46f7-208b-b4af" page="127">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5f96-3fef-cab0-4451" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="41d5-9a80-573b-4ac5"/>
          </constraints>
          <rules>
            <rule name="Heedless Slaughter" id="e5c0-13d0-8923-dd19" hidden="false" publicationId="4934-46f7-208b-b4af" page="127">
              <description>A unit entirely composed of models with this special rule must declare a Charge if able when they begin the Assault phase within 8&quot; of an enemy unit. If there is more than one eligible target, the controlling player chooses the target of any Charges made so long as that target is within 8&quot;. Note that this does not allow models with this special rule to Charge a different unit to one that they made a Shooting Attack against in the previous Shooting phase, even if they have made Shooting Attacks against a unit which is further than 8&quot; away and there are eligible targets for a Charge within 8&quot;.
Additionally, a unit entirely composed of models with this special rule adds +1 to the score used to determine if they win a Combat in the Assault phase (this modifier is cumulative with other modifiers to Combat Resolution) and adds +1 to the value of any rolls made to determine the result of a Sweeping Advance.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="The Ætheric Dominion (X) Corrupted Engines" id="ab0c-5041-ddcd-416d" hidden="false" type="rule" targetId="58e5-d2ef-f25e-496d"/>
          </infoLinks>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Malevolent Artifice (Corrupted Engines)" hidden="false" id="342d-f0f5-4302-69db" publicationId="4934-46f7-208b-b4af" collective="false" page="127">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="fdc9-d7e7-c6e1-9e85" percentValue="false" includeChildSelections="false" includeChildForces="false"/>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="15f1-1ab2-c905-b89e"/>
          </constraints>
          <rules>
            <rule name="Malevolent Artifice" id="cd2b-b7fb-4496-7504" hidden="false" publicationId="4934-46f7-208b-b4af" page="127">
              <description>Models with this special rule may re-roll all failed Armour Saves taken against any Wounds resolved at a Strength value lower than their Toughness Characteristic. This special rule has no effect on Cover Saves or Invulnerable Saves.</description>
            </rule>
          </rules>
          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="The Ætheric Dominion (X) Corrupted Engines" id="0ee3-37a7-f623-07c7" hidden="false" type="rule" targetId="58e5-d2ef-f25e-496d"/>
          </infoLinks>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
  </sharedSelectionEntryGroups>
  <categoryEntries>
    <categoryEntry name="Encroaching Ruin" hidden="false" id="c42-1919-c37e-51f0"/>
    <categoryEntry name="Heedless Slaughter" hidden="false" id="f074-f60a-9aa6-c52a"/>
    <categoryEntry name="Malevolent Artifice" hidden="false" id="bcf6-8350-9099-1e91"/>
    <categoryEntry name="Putrid Corruption" hidden="false" id="8cf6-d802-d054-6a86"/>
    <categoryEntry name="Formless Distortion" id="9556-82c1-c70a-126e" hidden="false"/>
    <categoryEntry name="Infernal Tempest" id="6508-4f6a-0dc1-8f56" hidden="false"/>
    <categoryEntry name="Rapturous Sensation" id="a1d4-4662-c944-19cc" hidden="false"/>
    <categoryEntry name="Ravenous Dissolution" id="2774-1a32-f196-be76" hidden="false"/>
  </categoryEntries>
  <sharedRules>
    <rule id="e05e-ed23-64fb-a535" name="Æthereal Invulnerability (X)" publicationId="cb13-da24-e6da-75b3" page="Various" hidden="false">
      <description>A model with this special rule gains an Invulnerable Save equal to the value listed in brackets. This Invulnerable Save cannot be taken against attacks made with weapons with the Force special rule.</description>
    </rule>
    <rule id="c694-20c8-455-baca" name="Empyrean Avatar" publicationId="cb13-da24-e6da-75b3" page="16" hidden="false">
      <description>When a model with this special rule suffers an unsaved Wound with the Instant Death special rule, it is not immediately removed as a casualty, but instead loses D3 Wounds instead of one for each unsaved Wound with the Instant Death special rule inflicted on it.</description>
    </rule>
    <rule name="The Ætheric Dominion (X) Corrupted Engines" id="58e5-d2ef-f25e-496d" hidden="false" publicationId="4934-46f7-208b-b4af" page="127">
      <description>Each Ætheric Dominion represents one of the innumerable strains of the Warp&apos;s influence, and any model with the Ætheric Dominion (X) special rule will have a number of additional special rules and abilities specific to their Ætheric Dominion. A unit which includes models with this special rule may only include models with one variation of the Ætheric Dominion special rule, e.g., Ætheric Dominion (Heedless Slaughter), and no model with this special rule may join a unit which includes any models with a different variation of the /Etheric Dominion (X) special rule.


Other publications have presented numerous different Ætheric Dominions, however only a limited number of those are used by the units presented in this section. For clarity, only the two relevant Ætheric Dominions are included in this section.</description>
    </rule>
  </sharedRules>
</catalogue>
