<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="8f64-16d5-e3fa-06cc" name="Homebrew - Drukhari" revision="1" battleScribeVersion="2.03" library="false" gameSystemId="28d4-bd2e-4858-ece6" gameSystemRevision="130" type="catalogue" authorName="Isaac">
  <publications>
    <publication id="9356-fc9b-2fee-7d11" name="Drukhari for The Horus Heresy 2.0 — Homebrew Conversion" shortName="HB - Drukhari" />
  </publications>
  <selectionEntries>
    <selectionEntry type="upgrade" import="true" name="Drukhari" hidden="false" id="897b-5b98-3dff-b74a" publicationId="9356-fc9b-2fee-7d11">
      <constraints>
        <constraint type="min" value="1" field="selections" scope="force" shared="true" id="2011-d398-c8ea-4059" percentValue="false" includeChildSelections="true" includeChildForces="false" />
        <constraint type="max" value="1" field="selections" scope="force" shared="true" id="f112-5131-73ce-0ada" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile name="Lightning Withdrawal" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="99f0-a082-8caf-edaa">
          <characteristics>
            <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Drukhari Infantry, Cavalry or vehicle unit is selected as the target of a Shooting Attack. Before the attack is resolved, the unit moves up to D6 plus its Initiative Characteristic in inches (vehicles move up to 6"), and must end further from the attacking unit than it started. If it is then out of range or line of sight, the attack is lost.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink targetId="e90d-e5a8-f42d-da84" id="09c2-04cb-624b-aced" primary="true" name="Allegiance:" />
        <categoryLink targetId="3c8e-5a1d-9b47-e2f0" id="c288-7bbd-9bdb-432f" primary="false" name="Xenos Army" />
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Obsession" hidden="false" id="fe9c-de49-f9a5-d9a6">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="c3d2-494d-6b72-f381" percentValue="false" includeChildSelections="false" includeChildForces="false" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8738-de58-68a6-9bff" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Cult of Strife" hidden="false" id="419c-b6cb-9b92-158b" publicationId="9356-fc9b-2fee-7d11">
              <profiles>
                <profile name="Whirling Death" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="1aec-c7cc-6acc-84e4">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: an enemy unit declares a charge against a Cult of Strife unit. Instead of firing Overwatch, the unit gains Counter-Charge (1) and Reach (1) until the end of the phase†.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Blade Artists" id="6484-2945-3a92-9772" hidden="false">
                  <description>the unit's melee weapons gain Shred.</description>
                </rule>
                <rule name="The Spectacle of Murder" id="832b-ce6c-0aef-d951" hidden="false">
                  <description>the unit may re-roll to-hit rolls of 1 in close combat.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Cult of the Red Grief" hidden="false" id="408a-a25b-c7ac-aeb9" publicationId="9356-fc9b-2fee-7d11">
              <profiles>
                <profile name="Too Fast to Catch" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="2e61-4013-7143-46f6">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Movement phase). Trigger: an enemy unit ends a move within 12" of a Red Grief unit. The unit moves up to D6 plus its Initiative Characteristic in inches (vehicles move up to 6") in any direction.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Blur of Motion" id="77c5-bf27-221b-3455" hidden="false">
                  <description>the unit increases its Fleet (X) by 1.</description>
                </rule>
                <rule name="Speed Kills" id="8f29-8885-b4b2-0744" hidden="false">
                  <description>Cavalry, Jump and vehicle units add 2 to their Movement Characteristic.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="The Dark Creed" hidden="false" id="0e92-1880-6c23-4679" publicationId="9356-fc9b-2fee-7d11">
              <profiles>
                <profile name="Torment" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="6dc5-218d-f025-6b9b">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: an enemy unit declares a charge against a Dark Creed unit. The charging unit must take a Leadership test; if it fails, it gains no bonuses for charging in that combat.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Fear Incarnate" id="7b27-bd53-8b57-7fa9" hidden="false">
                  <description>enemy units within 6" subtract 1 from their Leadership.</description>
                </rule>
                <rule name="Masters of Torment" id="5cc3-7996-5241-8c22" hidden="false">
                  <description>enemy units that fail a Morale check within 12" of this unit lose one additional model.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Kabal of the Black Heart" hidden="false" id="de4f-9184-2051-a4c2" publicationId="9356-fc9b-2fee-7d11">
              <profiles>
                <profile name="Strike First" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="d036-48f3-761d-ae4b">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Black Heart unit is selected as the target of a Shooting Attack. The unit makes a Return Fire Shooting Attack before the enemy attack is resolved, instead of after it.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Thirst for Power" id="bdea-bda1-9516-7f03" hidden="false">
                  <description>the unit gains each Power from Pain benefit one game turn earlier.</description>
                </rule>
                <rule name="Vect's Favour" id="e2d3-3a20-b8fc-0f68" hidden="false">
                  <description>the unit may re-roll failed Morale checks.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Kabal of the Poisoned Tongue" hidden="false" id="4e92-1ff0-9a92-9637" publicationId="9356-fc9b-2fee-7d11">
              <profiles>
                <profile name="Venomous Retort" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="488d-5171-0a41-edb2">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Poisoned Tongue unit is selected as the target of a Shooting Attack. After the attack is resolved, the unit makes a Return Fire Shooting Attack whose Poisoned weapons wound on 2+†.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Serpent's Kiss" id="091d-8918-9f06-abee" hidden="false">
                  <description>enemy units engaged with this unit subtract 1 from their Leadership.</description>
                </rule>
                <rule name="Toxin Crafters" id="be62-f2b7-8df0-3f32" hidden="false">
                  <description>the unit's weapons with Poisoned (X) improve that value by 1, to a best of 2+†.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Prophets of Flesh" hidden="false" id="a088-dae4-0485-4557" publicationId="9356-fc9b-2fee-7d11">
              <profiles>
                <profile name="Insensible to Pain" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="d1a3-f7f0-1999-5170">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Prophets of Flesh unit is selected as the target of a Shooting Attack. Against that attack, the unit's Feel No Pain improves by a further 1.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Experimental Creations" id="2fc5-63b1-1cb1-447c" hidden="false">
                  <description>Monstrous Creatures in the detachment add 1 to their Wounds Characteristic.</description>
                </rule>
                <rule name="Masters of the Flesh" id="e3c1-ced7-a529-edec" hidden="false">
                  <description>improve the unit's Feel No Pain by 1, to a best of 4+.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Rite of War" hidden="false" id="8fac-57e4-52bf-4e27">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="080c-9026-d69c-cabd" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Arena Spectacle" hidden="false" id="5b1a-dc53-2633-fb42" publicationId="9356-fc9b-2fee-7d11">
              <rules>
                <rule name="Effects" id="2fea-1e78-e8ed-4903" hidden="false">
                  <description>Reavers and Hellions may be taken as Troops and gain the Line sub-type.</description>
                </rule>
                <rule name="Limitations" id="67db-bff6-da54-ed95" hidden="false">
                  <description>Requires a Succubus or Lelith Hesperax as Warlord.   no Haemonculus Coven units (Haemonculus, Wracks, Grotesques, Talos, Cronos).</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="cee8-9a99-4b56-4c25" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Coven Experiments" hidden="false" id="67b7-e6c0-508e-2918" publicationId="9356-fc9b-2fee-7d11">
              <rules>
                <rule name="Effects" id="8354-8554-1b2c-48fc" hidden="false">
                  <description>Talos and Cronos may be taken as Troops.</description>
                </rule>
                <rule name="Limitations" id="d761-0785-29f2-5c34" hidden="false">
                  <description>Requires a Haemonculus or Urien Rakarth as Warlord.   the army may not include more Infantry units than it has Monstrous Creature units, and no Fast Attack choices.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="65a3-dd96-6e7a-dbaa" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Realspace Raid" hidden="false" id="3eab-0304-ba1a-b313" publicationId="9356-fc9b-2fee-7d11">
              <rules>
                <rule name="Effects" id="dcf0-c57b-8f79-778b" hidden="false">
                  <description>units may disembark from a Raider or Venom after it has moved at full speed, and may charge in the same turn.</description>
                </rule>
                <rule name="Limitations" id="b6d3-ba21-d1c1-23bb" hidden="false">
                  <description>Requires an Archon as Warlord.   every Infantry unit must start the game embarked on a transport.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="1b9a-0973-9646-c374" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Webway Ambush" hidden="false" id="384c-9ceb-885b-719a" publicationId="9356-fc9b-2fee-7d11">
              <rules>
                <rule name="Effects" id="8a2e-ee90-d22a-e991" hidden="false">
                  <description>every Infantry unit gains Deep Strike, and units arriving by Deep Strike may do so from the first game turn.</description>
                </rule>
                <rule name="Limitations" id="3589-a1eb-1fea-7c75" hidden="false">
                  <description>Requires any Drukhari HQ as Warlord.   no Heavy Support choices, and no Lords of War.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="05da-4301-b367-f9ca" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Warlord Trait" hidden="false" id="76b1-0683-1d7a-dca0">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6209-62c2-0098-3a5b" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Ancient Evil" hidden="false" id="1839-1687-df07-1903" publicationId="9356-fc9b-2fee-7d11">
              <profiles>
                <profile name="Ancient Evil" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="be5f-f7be-0ec8-b48d">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">*A being so old and so cruel that lesser creatures quail in its presence.* Enemy units within 12" of the Warlord subtract 1 from their Leadership. In addition, while the Warlord is on the battlefield, your army may make one additional reaction in your opponent's Movement phase, above its normal Reaction Allotment.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="9138-9800-299a-a0a5" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Labyrinthine Cunning" hidden="false" id="a1e8-c527-0a99-7290" publicationId="9356-fc9b-2fee-7d11">
              <profiles>
                <profile name="Labyrinthine Cunning" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="18c8-996b-ae4e-54d0">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">*A schemer whose plans have plans, and who is never where the enemy expects.* You may re-roll one Reserves roll each turn. In addition, while the Warlord is on the battlefield, your army may make one additional reaction in your opponent's Shooting phase, above its normal Reaction Allotment.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="3c14-d669-8212-89c9" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Master of Pain" hidden="false" id="73cf-f9cf-65da-0a26" publicationId="9356-fc9b-2fee-7d11">
              <profiles>
                <profile name="Master of Pain" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="24bc-c182-5fd3-5262">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">*A connoisseur of agony who drinks deep of every scream.* The Warlord and any unit he joins improve their Feel No Pain by 1. In addition, while the Warlord is on the battlefield, your army may make one additional reaction in your opponent's Assault phase, above its normal Reaction Allotment.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="a131-2c11-b09e-03a3" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Precision Killer" hidden="true" id="24fb-3359-35e3-eec5" publicationId="9356-fc9b-2fee-7d11">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="419c-b6cb-9b92-158b" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Precision Killer" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="0145-7573-c713-2ec6">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord's melee weapons gain Murderous Strike (5+).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="863f-ca09-c654-18a3" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Hyper-swift Reflexes" hidden="true" id="3b7d-f157-a8f3-4f7c" publicationId="9356-fc9b-2fee-7d11">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="408a-a25b-c7ac-aeb9" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Hyper-swift Reflexes" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="faa7-ea69-981b-e019">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord and any unit he joins add 1 to their Initiative and gain Outflank.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="e969-6ada-1998-c06e" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Dread Master" hidden="true" id="88b9-f214-7f5f-d8ae" publicationId="9356-fc9b-2fee-7d11">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="0e92-1880-6c23-4679" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Dread Master" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="f276-81c1-6607-8a8b">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">Enemy units within 12" of the Warlord subtract a further 1 from their Leadership.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="9964-4458-24a2-4885" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Hatred Eternal" hidden="true" id="5bc9-6e69-633d-e7e1" publicationId="9356-fc9b-2fee-7d11">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="de4f-9184-2051-a4c2" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Hatred Eternal" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="0d97-a95c-6c66-34f6">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord and any unit he joins have Hatred against every enemy.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="0041-64b7-3285-ea2e" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Soul Thirst" hidden="true" id="94e8-3d4a-a9f2-9809" publicationId="9356-fc9b-2fee-7d11">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="4e92-1ff0-9a92-9637" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Soul Thirst" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="da1e-45ec-1141-64f7">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">Each time the Warlord slays an enemy model in close combat, he restores one lost Wound, up to his starting value.</characteristic>
                  </characteristics>
                </profile>
