    <selectionEntry type="upgrade" import="true" name="Ghostplate Armour" hidden="false" id="a9da-3776-40a0-9323" publicationId="9356-fc9b-2fee-7d11">
      <profiles>
        <profile name="Ghostplate Armour" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="b0a8-f24c-eb05-53f4">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Armour laced with resin and a defensive field, worn by Archons and Scourges.* Ghostplate armour confers a 4+ Armour Save and a 6+ Invulnerable Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="9fff-09f0-08e3-d454" hidden="false" targetId="2d12-951d-7304-58f8" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (6+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Incubus Warsuit" hidden="false" id="96b2-0a8c-6657-b782" publicationId="9356-fc9b-2fee-7d11">
      <profiles>
        <profile name="Incubus Warsuit" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="c85f-c754-0eb8-5625">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*The heavy, ritual armour of the Incubi.* An Incubus warsuit confers a 3+ Armour Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Kabalite Armour" hidden="false" id="3dae-5443-5084-9de0" publicationId="9356-fc9b-2fee-7d11">
      <profiles>
        <profile name="Kabalite Armour" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="9c15-2fee-1267-bd91">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Segmented armour plates worn by Kabalite Warriors.* Kabalite armour confers a 5+ Armour Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Wychsuit" hidden="false" id="6b3a-b83b-e1bb-3a20" publicationId="9356-fc9b-2fee-7d11">
      <profiles>
        <profile name="Wychsuit" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="dc3a-428a-5d69-f6ea">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Minimal, flexible armour that leaves a Wych free to dodge and dance.* A wychsuit confers a 6+ Armour Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Chain-snares and Cluster Caltrops" hidden="false" id="78e2-7b04-a198-cc75" publicationId="9356-fc9b-2fee-7d11">
      <profiles>
        <profile name="Chain-snares and Cluster Caltrops" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="4364-f026-4f5f-335f">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Barbed chains and scattered blades trailed from a skimmer or jetbike.* After moving, a vehicle with chain-snares or a Reaver with cluster caltrops may inflict D3 hits at Strength 4, AP 5 on one enemy unit it moved over this turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Clone Field" hidden="false" id="f4b4-c686-54a8-09d4" publicationId="9356-fc9b-2fee-7d11">
      <profiles>
        <profile name="Clone Field" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="6dbe-5062-dba1-8b7f">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A field that projects shifting false images of the wearer.* A model with a clone field has a 5+ Invulnerable Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="511f-5a51-fd8b-0f75" hidden="false" targetId="2d12-951d-7304-58f8" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (5+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Flickerfield" hidden="false" id="ea67-2da1-460d-87a3" publicationId="9356-fc9b-2fee-7d11">
      <profiles>
        <profile name="Flickerfield" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="81b6-bac9-edd8-bba3">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A field that makes a skimmer flicker in and out of sight.* A vehicle with a flickerfield has a 5+ Invulnerable Save against Shooting Attacks.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="3e4a-de20-b366-1f5c" hidden="false" targetId="2d12-951d-7304-58f8" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (5+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Grav-talon" hidden="false" id="555e-a8db-be28-40aa" publicationId="9356-fc9b-2fee-7d11">
      <profiles>
        <profile name="Grav-talon" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="aa91-ae9e-512a-0837">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A gravitic projector that slams enemies into the ground as a jetbike passes.* When a Reaver with a grav-talon makes a Bladevane Strike, the hits gain Pinning.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Grisly Trophies" hidden="false" id="df4d-c184-20a0-f107" publicationId="9356-fc9b-2fee-7d11">
      <profiles>
        <profile name="Grisly Trophies" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="2431-173e-7bd3-07f3">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*The flayed remains of victims hung from a skimmer's hull.* Friendly Drukhari units within 6" of a vehicle with grisly trophies may re-roll failed Morale checks.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Night Shields" hidden="false" id="b98f-3f97-3baf-b4bd" publicationId="9356-fc9b-2fee-7d11">
      <profiles>
        <profile name="Night Shields" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="10b2-e238-21b4-be09">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Shadow-projectors that cloak a vehicle in darkness.* A vehicle with night shields has Shrouded (6+).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Phantasm Grenade Launcher" hidden="false" id="ad67-de96-ebec-89fd" publicationId="9356-fc9b-2fee-7d11">
      <profiles>
        <profile name="Phantasm Grenade Launcher" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="d86e-a259-1e74-d4c2">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A launcher that floods the area with hallucinogenic gas.* Enemy units that charge or are charged by a unit with a phantasm grenade launcher subtract 1 from their Leadership and Initiative until the end of the phase.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Plasma Grenades" hidden="false" id="005c-5bb5-0514-846c" publicationId="9356-fc9b-2fee-7d11">
      <profiles>
        <profile name="Plasma Grenades" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="7a3f-fd07-19c2-02e6">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Compact grenades that burst into searing plasma.* Plasma grenades count as frag grenades†.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Shadow Field" hidden="false" id="f9a1-8b0c-27ac-c18d" publicationId="9356-fc9b-2fee-7d11">
      <profiles>
        <profile name="Shadow Field" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="66e6-3f55-75ce-4ecc">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A personal field of impenetrable darkness, flawless until it fails.* A model with a shadow field has a 2+ Invulnerable Save. The first time it fails this save, the shadow field is destroyed for the rest of the game.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="64ae-a683-788e-d258" hidden="false" targetId="2d12-951d-7304-58f8" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (2+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Shock Prow" hidden="false" id="a116-3477-d057-866e" publicationId="9356-fc9b-2fee-7d11">
      <profiles>
        <profile name="Shock Prow" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="0a03-9c6c-80a6-2121">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*A reinforced prow for ramming enemy vehicles.* A vehicle with a shock prow adds 2 to its Strength when Ramming.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Spirit Probe and Spirit Vortex" hidden="false" id="2a55-1fd3-48bf-e7f3" publicationId="9356-fc9b-2fee-7d11">
      <profiles>
        <profile name="Spirit Probe and Spirit Vortex" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="4771-480e-cea8-67f1">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Devices that harvest and redirect the souls of the dying.* A Cronos with a spirit probe extends its Pain Parasite range to 12". A Cronos with a spirit vortex gains the spirit vortex weapon (see the Armoury).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Splinter Racks" hidden="false" id="2e61-9b22-010f-9352" publicationId="9356-fc9b-2fee-7d11">
      <profiles>
        <profile name="Splinter Racks" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="319f-ea65-ef73-801a">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*Racks of splinter guns that let passengers fire a hail of poisoned shards.* Units embarked on a vehicle with splinter racks may re-roll to-hit rolls of 1 with splinter weapons when firing from it.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Archon" hidden="false" id="786f-5326-4e60-88f8" publicationId="9356-fc9b-2fee-7d11">
      <rules>
        <rule name="Overlord" id="01f5-cda8-a24b-c87a" hidden="false">
          <description>Friendly Drukhari units within 12" may use the Archon's Leadership</description>
        </rule>
