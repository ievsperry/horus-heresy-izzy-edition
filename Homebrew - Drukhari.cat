    <selectionEntry type="unit" import="true" name="Asdrubael Vect" hidden="false" id="3214-efaf-e7dd-6b87" publicationId="9356-fc9b-2fee-7d11">
      <rules>
        <rule name="Master of Commorragh" id="4be8-ed48-f6ab-2203" hidden="false">
          <description>Once per game, at the start of your turn, you may redeploy up to 3 friendly units, including those in Reserves, as though deploying them</description>
        </rule>
        <rule name="Supreme Commander" id="6d7f-9381-1ea2-8acd" hidden="false">
          <description>If he is in your army, Vect must be your Warlord</description>
        </rule>
      </rules>
