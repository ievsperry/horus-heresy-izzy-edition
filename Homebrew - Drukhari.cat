    <selectionEntry type="unit" import="true" name="Cronos" hidden="false" id="f787-640f-7226-7015" publicationId="9356-fc9b-2fee-7d11">
      <rules>
        <rule name="Pain Parasite" id="a9db-c581-ea53-b2d9" hidden="false">
          <description>Each time the Cronos causes an unsaved Wound, one friendly Drukhari unit within 6" gains the next Power from Pain benefit early for the rest of the turn</description>
