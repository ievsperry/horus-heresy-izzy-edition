          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model accompanied by one or more ammo runts has the Ammo Runts special rule.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="'Ard Case" hidden="false" id="166b-c0a4-9d59-f7ef" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="'Ard Case" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="5ece-efa1-5b87-2834">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A vehicle with an 'ard case loses the Open-topped special rule and adds 1 to its Side Armour. It has one Access Point on each side of the hull and one at the rear.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Armored Plates" hidden="false" id="7c41-524e-f972-520a" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Armored Plates" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="07dd-6140-e3a9-37d4">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A vehicle equipped with armored plates ignores Crew Shaken results.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Attack Squig" hidden="false" id="5f90-098a-c9cf-7c99" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Attack Squig" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="3314-def9-e202-000b">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model accompanied by one or more attack squigs gains +1 Attack.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Boarding Plank" hidden="false" id="56a9-2e69-4958-ebf6" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Boarding Plank" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="30dd-a390-b9e5-7c87">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A vehicle equipped with a boarding plank gains the Assault Vehicle special rule.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Assault Vehicle" id="d40b-26be-2b11-4a7b" hidden="false" targetId="aa61-11f6-2bb5-7c0e" type="rule" />
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Bomb Squig" hidden="false" id="1978-a29f-7d13-6fcc" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Bomb Squig" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="ecdf-773b-31ca-7935">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A bomb squig may be released once per battle during the Shooting phase. Select one enemy unit within 12". That unit suffers D3 Strength 8 AP3 hits with the Rending (5+) special rule.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Bosspole" hidden="false" id="e2e0-a4e5-4709-03c3" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Bosspole" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="c828-8441-0098-ed5e">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Once per turn, a unit that includes at least one model with a bosspole may re-roll a failed Morale check or Pinning test. If the re-roll also fails, the unit may still use Breakin' Heads.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Butcha Boyz" hidden="false" id="8380-3be4-4807-34fe" publicationId="96d0-c462-d158-fbad">
      <entryLinks>
        <entryLink import="true" name="Butcha Boyz' choppas" hidden="false" id="e6d9-ac62-ac35-8738" type="selectionEntry" targetId="dd0f-6cc5-19c2-4a3f">
