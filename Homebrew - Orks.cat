      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Red Paint Job" hidden="false" id="c40e-efd7-b51e-395a" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Red Paint Job" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="2f76-4cec-ddc5-d9e6">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A vehicle equipped with a red paint job increases its Movement Characteristic by +2 while moving at Combat Speed.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Reinforced Ram" hidden="false" id="f0d3-a0b3-3516-ec85" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Reinforced Ram" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="e444-e27e-a3d3-b08d">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A vehicle equipped with a reinforced ram may re-roll failed Dangerous Terrain tests. In addition, Tank Shock attacks made by the vehicle inflict +1 Strength.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Rokk-pack" hidden="false" id="7132-a555-3981-3cc3" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Rokk-pack" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="397b-c5ad-3be9-3e61">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A rokkit pack grants the Jump Infantry Unit Type, Hammer of Wrath (1), Bulky (2), and the Deep Strike special rule. In addition, models equipped with rokkit packs increase their Movement Characteristic to 12 while Running. At the beginning of any Movement phase in which the unit Runs, the controlling player may attempt to push the rokkit packs beyond safe operational limits. Roll a D6: - On a roll of 6, the unit gains Fleet (3) and Hammer of Wrath (2) until the end of the turn. - On a roll of 2–5, the unit gains Fleet (2) until the end of the turn. - On a roll of 1, the unit immediately suffers 6 Strength 6 AP – hits and becomes Pinned.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Saddlegit with Slugga" hidden="false" id="e58f-3b1c-c87c-b156" publicationId="96d0-c462-d158-fbad">
      <entryLinks>
        <entryLink import="true" name="Saddlegit's slugga" hidden="false" id="d751-a7a7-788a-c4c8" type="selectionEntry" targetId="9d6c-82e9-83ae-55e7">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="5153-ee2d-abc3-4df3" percentValue="false" includeChildSelections="false" includeChildForces="false" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="afa8-3963-9b3e-21ba" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
        </entryLink>
        <entryLink import="true" name="Saddlegit's shiv" hidden="false" id="ec80-5df8-4e22-a77c" type="selectionEntry" targetId="d5dd-8d5c-b84b-5467">
