    <selectionEntry type="unit" import="true" name="Shokkjump Dragsta" hidden="false" id="beaf-0acb-2f19-bb3e" publicationId="96d0-c462-d158-fbad">
      <rules>
        <rule name="Shokk Tunnel Drive" id="2101-fa0e-1247-80f1" hidden="false">
          <description>Instead of Running during the Movement phase, a Shokkjump Dragsta may immediately remove itself from the battlefield and redeploy anywhere within 24" using the Deep Strike rules. If the scatter roll results in a Mishap, the Dragsta instead suffers D3 Strength 8 AP2 hits.</description>
        </rule>
      </rules>
