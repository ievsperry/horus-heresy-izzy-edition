    <selectionEntry type="unit" import="true" name="Mek Boss" hidden="false" id="deae-ce8a-a3dd-0a5e" publicationId="96d0-c462-d158-fbad">
      <rules>
        <rule name="Master Mek" id="a0ec-7171-8a4e-eecd" hidden="false">
          <description>A Mek Boss and any Vehicle or Dreadnought unit he joins gain It Will Not Die (5+). In addition, friendly Vehicles within 6" of a Mek Boss may ignore Crew Shaken results on a roll of 4+.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Xenos" id="a2ff-6a66-fa03-ea34" hidden="false" targetId="e6a0-8f13-d5c2-4b79" type="rule" />
