    <selectionEntry type="unit" import="true" name="Ghazghkull Thraka" hidden="false" id="797f-04dc-77fb-4579" publicationId="96d0-c462-d158-fbad">
      <rules>
        <rule name="Prophet of the Waaagh!" id="21b6-69c7-75af-7766" hidden="false">
          <description>While Ghazghkull Thraka is alive, all friendly Ork Infantry, Cavalry and Jump Infantry units within 12" gain Stubborn. In addition, Ghazghkull Thraka may declare a Waaagh! twice per battle at the start of any turn, though no more than one Waaagh! may be declared during the same turn.</description>
        </rule>
        <rule name="Warlord" id="a86e-f923-a79e-acd8" hidden="false">
          <description>Ghazghkull must be your Warlord</description>
        </rule>
      </rules>
