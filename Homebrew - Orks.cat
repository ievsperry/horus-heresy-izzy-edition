            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a09a-b9c9-197e-1b32" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
        </entryLink>
      </entryLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Smoke Bombz" hidden="false" id="3004-e579-9491-f268" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Smoke Bombz" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="5b5f-23ea-485a-96c1">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Once per battle, at the end of its Movement phase, a mob with smoke bombz may set them off. Until the start of its controlling player's next turn the mob counts as being more than 25% obscured, regardless of terrain, and gains a 6+ Cover Save; it may not make Shooting Attacks that turn except as part of a Reaction†. House rule: instead of the 6+ Cover Save, the mob gains Shrouded (5+).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Sneakin' Armour" hidden="false" id="1f4e-4036-dfaa-904f" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Sneakin' Armour" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="df91-d466-6042-3d6f">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Sneakin' armour grants a 6+ Armour Save and the Shrouded (5+) special rule.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Squig Hound" hidden="false" id="95d9-0a4c-52a0-f977" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Squig Hound" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="df84-79c6-7598-d7f6">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A Gretchin unit joined by one or more models equipped with a squig hound may re-roll failed Morale checks. If a Morale check is failed and then successfully re-rolled using this rule, the unit immediately suffers D3 Strength 3 AP – hits.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Stikkbomb Chukka" hidden="false" id="e541-8b6e-8df8-3b12" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Stikkbomb Chukka" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="81be-ff09-180b-a217">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Units disembarking from a vehicle with a stikkbomb chukka count as having stikkbombz when they charge in the same turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Stikkbomb Flinga" hidden="false" id="057d-0d95-c700-485e" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Stikkbomb Flinga" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="024a-f90e-08cc-86d0">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model with a stikkbomb flinga may fire it using the stikkbomb flinga profile in the Ork Armoury. Any Ork vehicle, Dreadnought or Speed Freek buggy may take one.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <entryLinks>
        <entryLink import="true" name="Stikkbomb flinga" hidden="false" id="9da5-efe0-76cb-d090" type="selectionEntry" targetId="92c7-b271-8572-ee11">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="89d5-1807-c035-578e" percentValue="false" includeChildSelections="false" includeChildForces="false" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a8d1-519b-9ef2-1c97" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
        </entryLink>
      </entryLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Stikkbombz" hidden="false" id="960a-b583-75a7-cab5" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Stikkbombz" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="402d-9eb8-e4a2-4e62">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Stikkbombz count as frag grenades†.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Tankbusta Bombz" hidden="false" id="13d1-b389-4f9a-4f6f" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Tankbusta Bombz" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="3f06-5ada-19f5-96f3">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Tankbusta bombz count as melta bombs†.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Tellyporta" hidden="false" id="01f3-497d-aa7d-c658" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Tellyporta" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="f17c-8cb4-4dad-4644">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A unit containing one or more models equipped with a teleporta gains the Deep Strike special rule. In addition, at the beginning of each of the controlling player's turns, roll a D6 for every model in the unit. For each roll of a 1, the unit suffers a Strength 8 AP – hit with the Pinning special rule. If the unit is not Pinned after resolving these hits, it may immediately be removed from the battlefield and placed into Ongoing Reserves. The unit automatically enters play via Deep Strike at the end of the controlling player's following Movement phase.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Deep Strike" id="6498-5322-9dc0-a847" hidden="false" targetId="f1e1-986f-c783-ca9e" type="rule" />
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Waaagh! Banner" hidden="false" id="cced-0024-06cc-b831" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Waaagh! Banner" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="7c7e-35b7-82f7-351a">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A unit that includes at least one model with a Waaagh! banner adds 1 to its Weapon Skill while that model lives.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Warbike" hidden="false" id="75f2-0220-1fb3-60d2" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Warbike" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="dd43-fdec-1a36-4ccb">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">An Ork warbike has one twin-linked big shoota. In addition, a model with an Ork warbike that chooses to Run gains the Shrouded (5+) special rule until the beginning of the controlling player's next turn. A model with the Infantry Unit Type that selects an Ork warbike as an upgrade changes its Unit Type to Cavalry, keeping any Unit Sub-types it previously possessed, and may choose to gain the Skirmish Unit Sub-type. In addition, the model changes its Movement Characteristic to 14 and gains the Firing Protocols (2) and Hammer of Wrath (1) special rules.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Shrouded (X)" id="8361-96a2-3601-ae4d" hidden="false" targetId="10c3-fdb0-089f-ca65" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Shrouded (5+)" />
          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Warphead" hidden="false" id="eaff-e0e8-d237-dcd1" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Warphead" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="84cf-6945-7614-431f">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A Weirdboy upgraded to a Warphead may roll twice on both the Weirdboy Psychic Powers and Weirdboy Psychic Weapons tables and select which result to use at the beginning of each controlling player turn. In addition, a Warphead gains +1 to its Waaagh! Energy bonus, to a maximum total bonus of +3.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Wreckin' Ball" hidden="false" id="9896-1609-46e7-100a" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Wreckin' Ball" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="a840-42b2-d717-0b63">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">At the end of any Movement phase in which the vehicle moved, select one enemy unit within 3" of the vehicle. That unit suffers D3 Strength 8 AP4 hits.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <entryLinks>
        <entryLink import="true" name="Wreckin' ball" hidden="false" id="de2e-3042-af41-dc4e" type="selectionEntry" targetId="af08-16c7-9e1f-7635">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="41c6-b41c-15d1-d4e9" percentValue="false" includeChildSelections="false" includeChildForces="false" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="93d9-5376-0251-c077" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
        </entryLink>
      </entryLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Da Jump" hidden="false" id="920b-c0d6-3639-f13b" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Da Jump" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="c4a7-5d44-e69f-5155">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">Movement phase. Select one friendly Ork unit within 12" of the Weirdboy, plus one more for each +1 of his current Waaagh! Energy bonus. Remove the selected units from the battlefield and place them in Reserves. Roll for them as normal for Reserves, adding the Waaagh! Energy bonus to each roll; when they arrive, they enter play by Deep Strike as normal. The Waaagh! Energy bonus is fixed when Da Jump is cast, and that same value is used for these Reserves rolls.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Fists of Gork" hidden="false" id="984c-272d-334e-5a2a" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Fists of Gork" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="1ecc-87cc-c0e0-b67b">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">Assault phase. Until end of phase the Weirdboy has +2 Strength and +2 Attacks.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Da Jump" hidden="false" id="358e-9f5e-f44a-bcaa" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Da Jump" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="5811-8fbc-14a4-3984">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">Movement phase. D3 roll of 1. Instead of moving during the Movement phase, select one friendly Ork Infantry unit within 12". Remove that unit from the battlefield and immediately redeploy it using the Deep Strike special rules. The redeployed unit gains Fleet (2) until the end of the turn. If the Psychic check is failed, the unit scatters D6" and suffers D6 Strength 4 AP – hits.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Waaagh! Pulse" hidden="false" id="3473-1f0b-f812-6201" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Waaagh! Pulse" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="35e1-48a6-588b-8da3">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">Shooting phase. D3 roll of 2. Instead of making a Shooting Attack, all friendly Ork units within 12" gain Furious Charge (2) and Dakka! (5+) until the beginning of the controlling player's next turn. If the Psychic check is failed, all affected units become Pinned.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Green Fury" hidden="false" id="adb5-8c5e-509e-b798" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Green Fury" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="bb11-18d4-6a1a-41dd">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">Shooting phase. D3 roll of 3. Instead of making a Shooting Attack, select one friendly Ork Infantry unit within 12". That unit gains Counter-Attack (1), Crusader and Fearless until the beginning of the controlling player's next turn. If the Psychic check is failed, the affected unit suffers −1 Weapon Skill until the beginning of the controlling player's next turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Beastboss" hidden="false" id="f037-60e3-2394-0e3d" publicationId="96d0-c462-d158-fbad">
      <rules>
        <rule name="Beastboss" id="34f4-d16f-41c8-c05d" hidden="false">
          <description>May only join Beast Snagga Boyz; while he lives, that unit has Feel No Pain (6+) and re-rolls charge distance</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Xenos" id="2276-a910-6db3-3922" hidden="false" targetId="e6a0-8f13-d5c2-4b79" type="rule" />
