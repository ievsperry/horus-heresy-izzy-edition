    <selectionEntry type="unit" import="true" name="Stompa" hidden="false" id="d452-383b-61a4-8fcd" publicationId="96d0-c462-d158-fbad">
      <rules>
        <rule name="Unstable Reactor" id="7b1e-6f5a-293c-ca70" hidden="false">
          <description>At the beginning of each controlling player turn, roll a D6. On a roll of 1, the Stompa suffers D6 Strength 8 AP2 hits resolved against its Rear Armour. On a roll of 2–5, select one of the following effects until the beginning of the next turn: Rage (3), Hammer of Wrath (D6+1), Fleet (3), Sudden Strike (3), It Will Not Die (5+), or a 4+ Invulnerable Save On a roll of 6, select any two of the above effects.</description>
        </rule>
        <rule name="Transport" id="4ebe-155c-b75d-8205" hidden="false">
          <description>Transport Capacity 21 Ork Infantry models.</description>
        </rule>
      </rules>
      <infoLinks>
