    <selectionEntry type="upgrade" import="true" name="1" hidden="false" id="392a-8501-14d1-a8b0" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="1" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="d99d-ce8f-f1a5-cf73">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Mishap Result: Warp Core Collapse!, Rules Effect: The firer and every model in the entire unit suffer a Strength 6 AP4 hit with the Deflagrate special rule. The Shokk Attack Gun may not be fired again for the remainder of the battle.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="2" hidden="false" id="3082-3e04-a7c1-194d" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="2" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="fb68-5a55-2b16-d956">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Mishap Result: Polarity Reversed, Rules Effect: Remove the firer from play and immediately place him in base contact with the target enemy unit. The firer counts as having successfully Charged and becomes Locked in combat, but begins the combat Pinned.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="3" hidden="false" id="8e66-a17f-ebaa-dec4" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="3" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="c838-9692-8f43-b936">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Mishap Result: Snotling Rain, Rules Effect: The original attack causes no damage. Instead place a Massive Blast (7") template centered on the target. Every unit touched by the template must immediately take a Pinning test.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="4" hidden="false" id="ee18-58ff-bf37-d937" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="4" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="ffa9-1721-aec4-fd81">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Mishap Result: Ear-Biting Madness, Rules Effect: If the target is a Vehicle, it immediately suffers a Crew Shaken result. If the target is Infantry, Cavalry or a Dreadnought, the target gains Blind and Concussive (1) until the end of the next player turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="5" hidden="false" id="53f9-cd65-ed63-dd81" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="5" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="ff86-cc93-f388-b685">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Mishap Result: Subatomic Materialization, Rules Effect: The attack resolves at Strength 10 and gains Fleshbane and Sunder. After resolving the attack, the firer suffers one automatic Wound with no saves of any kind allowed.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="6" hidden="false" id="96ba-820e-e5d6-2689" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="6" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="bfc4-ffe8-f3f5-e3a7">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Mishap Result: Annihilation Vortex, Rules Effect: The attack resolves at Strength 10 AP1 and gains Instant Death. The target unit must immediately take a Morale check at -2 Leadership.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
