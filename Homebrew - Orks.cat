            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="b14f-934c-d905-9936" percentValue="false" includeChildSelections="false" includeChildForces="false" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="358c-48d4-1882-b903" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
        </entryLink>
      </entryLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Cybork Body" hidden="false" id="db38-ed87-8517-73be" publicationId="96d0-c462-d158-fbad">
      <profiles>
        <profile name="Cybork Body" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="b6fe-673f-8a03-c960">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model with cybork implants (a cybork body) gains a 5+ Invulnerable Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Invulnerable Save (X)" id="82d9-3526-68db-8988" hidden="false" targetId="85f3-c187-c717-378e" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (5+)" />
