    <selectionEntry type="unit" import="true" name="Warboss Retinue" hidden="false" id="605d-265a-f714-6370" publicationId="96d0-c462-d158-fbad">
      <rules>
        <rule name="Note" id="94c8-8092-aee1-d945" hidden="false">
          <description>A Boss Retainer with mega armour uses this profile instead: M 6, WS 5, BS 2, S 4, T 4, W 3, I 2, A 3, Ld 6, Sv 2+.</description>
        </rule>
        <rule name="Note" id="8cbe-1fc1-634b-28a9" hidden="false">
          <description>A Head Nob with mega armour uses this profile instead: M 6, WS 5, BS 2, S 4, T 4, W 4, I 3, A 4, Ld 7, Sv 2+.</description>
        </rule>
      </rules>
