      <rules>
        <rule name="Speed Demons" id="4cf5-2632-7812-f3cb" hidden="false">
          <description>A model that chooses to Advance gains Shrouded (5+) until the start of the controlling player's next turn</description>
        </rule>
        <rule name="Note" id="39c0-114b-a3df-7226" hidden="false">
          <description>The biggest, meanest Speed Freeks, who have earned (or taken) the fastest bikes in the Waaagh!</description>
        </rule>
