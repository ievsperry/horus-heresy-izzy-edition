    <selectionEntry type="unit" import="true" name="Odd Boys" hidden="false" id="0e7a-7a27-6896-6155" publicationId="96d0-c462-d158-fbad">
      <rules>
        <rule name="Dok's Tools" id="9360-20df-b9c4-ec47" hidden="false">
          <description>Friendly Ork Infantry units joined by a Painboy gain Feel No Pain (5+). If the unit already possesses Feel No Pain, improve that roll by +1 to a maximum of Feel No Pain (4+).</description>
        </rule>
        <rule name="Psychic discipline" id="e0d8-6a6b-e64a-543c" hidden="false">
          <description>Power of da Waaagh! (Weirdboy only)</description>
        </rule>
        <rule name="Note" id="6336-f04b-ac51-33cd" hidden="false">
          <description>The Odd Boys are the Meks, Painboys and Weirdboys of the warband. The unit costs 55 points, plus 55 points for each Odd Boy and the extra for his kind: a Mek +0, a Painboy +20 and a Weirdboy +45 points.</description>
        </rule>
      </rules>
