    <selectionEntry type="unit" import="true" name="Big Mek" hidden="false" id="963a-3aa5-6455-315d" publicationId="96d0-c462-d158-fbad">
      <rules>
        <rule name="Master Mek" id="ed9e-da5d-9ce0-85a2" hidden="false">
          <description>A Big Mek and any Vehicle or Dreadnought unit he joins gain It Will Not Die (6+). In addition, friendly Vehicles within 6" of a Big Mek may ignore Crew Shaken results on a roll of 5+.</description>
        </rule>
