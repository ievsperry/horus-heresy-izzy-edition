          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="3a06-af9b-5578-2c17" type="min"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="40bf-b6fa-7c1e-b14a" name="Levy Squad" hidden="false" collective="false" import="true" type="unit">
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="7734-dc53-f78f-5405" type="min"/>
                <constraint field="selections" scope="parent" value="3" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="f49c-d7bb-ad58-611e" type="max"/>
                <constraint type="min" value="0" field="selections" scope="force" shared="true" id="8e1b-abfb-e65-45d3" includeChildSelections="true"/>
              </constraints>
              <rules>
                <rule id="e5da-18a3-fb79-318f" name="Expendable" publicationId="48c2-d023-0069-001a" page="18" hidden="false">
                  <description>The opposing player never gains Victory points for removing a unit that includes any models with this special rule as casualties. However, if a unit that includes any models with this special rule fails a Morale check, it does not Fall Back, but instead all models in the unit are removed from play as casualties immediately.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="d969-a6f9-04b6-45ee" name="Support Squad" hidden="false" targetId="768e-56d6-ca52-24ae" type="rule">
