    <selectionEntry type="unit" import="true" name="IM - Demagogue Cadre" hidden="false" id="8eb8-130e-6cae-0390">
      <rules>
        <rule name="Note" id="a0f8-8085-3296-bb94" hidden="false">
          <description>A Demagogue upgraded to a Mounted Demagogue must be assigned to an Imperialis Militia Cavalry Squad, Mounted Command Cadre or Wolf Rapid Response Section, ignoring Among the Flock's normal Unit Type restrictions.</description>
        </rule>
      </rules>
