                <selectionEntry id="8a1d-95fd-6538-0cf6" name="Detcon Unit" hidden="false" collective="true" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="40ab-c572-cc6c-ddf1" type="min"/>
