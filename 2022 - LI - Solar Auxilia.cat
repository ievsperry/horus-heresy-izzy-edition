    <selectionEntry type="unit" import="true" name="Lord Marshal Ireton MaSade" hidden="false" id="1330-beaa-9d7c-db6b">
      <rules>
        <rule name="Note" id="5c27-417d-a04b-2b14" hidden="false">
          <description>After both sides have deployed (including Infiltrators and Scouts) and any roll to Seize the Initiative, but before the game begins, the Controlling Player may redeploy up to three of their units within the mission's limits. They may go into Reserves but not into a Deep Strike, Subterranean or Flanking Assault. Each Tercio unit counts separately and may ignore the normal Tercio deployment rules when redeployed.</description>
        </rule>
        <rule name="Note" id="993d-22c3-5c88-fa5f" hidden="false">
          <description>Before deployment, the Controlling Player picks one phase. While MaSade lives, the army gains one extra Reaction in that phase of the opponent's turn.</description>
        </rule>
        <rule name="Note" id="1f98-cbe4-94ac-d368" hidden="false">
          <description>If MaSade takes an Extremis Warsuit, an Extremis Boarding Rig Section may be taken as his Retinue Squad. It uses no Force Organisation slot, is part of his unit, must deploy with him, and he may not voluntarily leave it. Its models lose Battlesmith (X) and gain Chosen Warriors and Counter-Attack (1). One Extremis Boarding Rig may exchange a Vox Interlock for a Command Vox (+5 points), and one may exchange an Auxilia Vexilla for a Cohorts Vexilla (+5 points).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Battle-Hardened (X)" id="b021-5619-96df-84c8" hidden="false" targetId="5c3b-ed0b-4ad0-d547" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Battle-Hardened (1)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Field Officer" id="6d3d-ff2d-2ad4-b538" hidden="false" targetId="846b-dfa0-a574-07f0" type="rule"/>
        <infoLink name="Hatred (X)" id="04f1-a99c-b383-fa9b" hidden="false" targetId="dc0b-fe69-6b71-e0a4" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Hatred (Traitors)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Loyalist" id="9b40-a877-c89f-8514" hidden="false" targetId="d1de-a45d-2b9b-c878" type="rule"/>
        <infoLink name="Stubborn" id="ad01-57f4-abee-4022" hidden="false" targetId="7989-1f2c-a43d-82ae" type="rule"/>
      </infoLinks>
