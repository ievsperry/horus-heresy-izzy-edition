    <selectionEntry type="upgrade" import="true" name="Ambulator Frame (Ireton MaSade)" hidden="false" id="5cf2-e5ee-4c08-2d34">
      <profiles>
        <profile name="Ambulator Frame (Ireton MaSade)" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="66a4-9716-e6c9-f2aa">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">An Ambulator Frame gives a 2+ Armour Save and It Will Not Die (5+).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Auspex Surveyor" hidden="false" id="c29a-231d-0adb-6f73">
      <profiles>
        <profile name="Auspex Surveyor" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="3ae1-da71-b87c-21ba">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A unit with at least one model with an Auspex Surveyor makes Shooting Attacks with Ignores Cover, and: - Enemy models may not Infiltrate within 24" of the model. - The unit ignores the 24" line of sight limit and the -1 BS penalty from Night Fighting. - When an enemy unit arrives from Reserves, the unit may make the Interceptor Advanced Reaction without spending a Reaction point. This may exceed three Reactions in a phase but not one per phase for the unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Auxilia Tempestor Land Speeder" hidden="false" id="663e-9d93-cafa-cd8d">
      <profiles>
        <profile name="Auxilia Tempestor Land Speeder" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="76ab-8cc0-bea9-e20d">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">An Auxilia Tempestor Land Speeder has a Multi-Laser and a Havoc Launcher. A model with one that Runs gains Shrouded (5+) until the start of its Controlling Player's next turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Battle Servitor Control" hidden="false" id="0537-1d23-62b5-ff60">
      <profiles>
        <profile name="Battle Servitor Control" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="1317-d707-2fda-6064">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model with Battle Servitor Control gains Sunder.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Breacher Charges" hidden="false" id="d098-2a51-3a7b-a464">
      <profiles>
        <profile name="Breacher Charges" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="8c1f-1419-f369-7ff2">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">In the Assault phase, a model with Breacher Charges that is Engaged with or in base contact with a Building or Fortification may, instead of attacking normally, make one automatic Str 10, AP 2 Hit against it at Initiative step 1. Any model doing so may not use any other weapon, rule or wargear to inflict Hits or Wounds that phase, but may still Sweeping Advance.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Extremis Warsuit" hidden="false" id="1486-c116-70d0-bfad">
      <profiles>
        <profile name="Extremis Warsuit" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="4527-797c-169d-251c">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Ireton MaSade with an Extremis Warsuit uses his Mechanised profile, exchanges his Archaeotech Pistol for a Rotary Bolt Cannon, and gains Fleet (2), Inexorable, Move Through Cover and the Light and Mechanised Sub-types.</characteristic>
          </characteristics>
        </profile>
        <profile name="Ireton MaSade Mechanised" typeId="4bb2-cb95-e6c8-5a21" typeName="Unit" hidden="false" id="046d-25a7-34ad-9f2e">
          <characteristics>
            <characteristic name="Unit Type" typeId="ddd7-6f5c-a939-b69e">Infantry (Independent Character, Light, Mechanised, Unique)</characteristic>
            <characteristic name="Move" typeId="893e-2d76-8f04-44e5">8</characteristic>
            <characteristic name="WS" typeId="cc42-7ed5-7092-5c84">4</characteristic>
            <characteristic name="BS" typeId="74ae-c840-0036-d244">5</characteristic>
            <characteristic name="S" typeId="e478-41d4-a092-48a8">5</characteristic>
            <characteristic name="T" typeId="c32b-5fdd-3fbe-9b1f">5</characteristic>
            <characteristic name="W" typeId="57ee-1126-32a9-5672">4</characteristic>
            <characteristic name="I" typeId="62d3-22d7-2d49-52dc">3</characteristic>
            <characteristic name="A" typeId="f111-2ce5-dd12-d6b0">3</characteristic>
            <characteristic name="Ld" typeId="e8a6-1da9-d384-8727">10</characteristic>
            <characteristic name="Save" typeId="e593-6b3c-f169-04f0">2+</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Psi-Jammer" hidden="false" id="b74a-3e47-9b63-abfb">
      <profiles>
        <profile name="Psi-Jammer" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="ed94-d638-ce44-2738">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Enemy models within 18" and line of sight suffer -2 Leadership on Psychic checks (not cumulative; one Psi-Jammer at a time). The model and any unit it joins gain Adamantium Will (5+).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Siege Retrofit" hidden="false" id="a0b4-ef7f-8b7e-e0b9">
      <profiles>
        <profile name="Siege Retrofit" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="a092-5db7-16a3-f82c">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model with a Siege Retrofit loses the Fast Sub-type, has Front Armour 14, and has a Flare Shield at no cost (it may not buy one from any other source).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Verticalis Drop Harness" hidden="false" id="8138-2c78-eb04-1fb2">
      <profiles>
        <profile name="Verticalis Drop Harness" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="cfce-0058-44ed-1b70">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model with a Verticalis Drop Harness gains Deep Strike, and may disembark from a Zooming Flyer, or a Flyer moving at Cruising Speed, regardless of other rules.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
