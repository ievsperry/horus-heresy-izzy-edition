          <costs>
            <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
          </costs>
        </selectionEntry>
      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup name="Warrants of Trade" hidden="false" id="2c28-3094-ac45-a4a3">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition type="instanceOf" value="0" field="selections" scope="ancestor" childId="d4f2-6da5-b6de-06ec" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
            <modifier type="set" field="a4ed-4ae7-9878-a289" value="0">
              <conditions>
                <condition type="instanceOf" value="0" field="selections" scope="ancestor" childId="d4f2-6da5-b6de-06ec" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="a4ed-4ae7-9878-a289" percentValue="false" includeChildSelections="false" includeChildForces="false" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a053-a575-5be7-76b5" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Warrant of Compliance" hidden="false" id="dc8d-73ae-9ca6-ee7e" publicationId="7753-116a-18d0-aa13">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="fe3f-ac1d-8461-44a8" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule name="Warrant of Compliance" id="3d8b-de7f-3035-0476" hidden="false">
                  <description>The most common Warrant, issued in bulk to legitimise short, brutal campaigns of subjugation under the close watch of a patron.

Effects

• A Loyalist army may include one Allied Detachment with the Agents of the Emperor Faction.
• A Traitor army may include one Allied Detachment with the Agents of the Warmaster Faction.

Limitations

• The army may not include any Detachments from a Faction that may select the Xenos Allegiance.
• No more than one Agents of the Emperor or Agents of the Warmaster Allied Detachment may be included.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Warrant of Conquest" hidden="false" id="7d99-80a3-171d-9ff7" publicationId="7753-116a-18d0-aa13">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f70d-b474-f827-6301" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule name="Warrant of Conquest" id="4253-914b-ffff-0e31" hidden="false">
                  <description>Granted to single-minded, bloody-handed Traders who would reclaim systems at any cost, even with xenos aid.

Effects

• The army may include one Detachment from a Faction that may select the Xenos Allegiance.

Limitations

• No more than one Xenos Detachment may be included.
• The army may not include any Allied or Optional Detachments from the Agents of the Emperor or Agents of the Warmaster Factions.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Warrant of Exploration" hidden="false" id="5bfa-92c0-29e9-a55c" publicationId="7753-116a-18d0-aa13">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="96cd-e970-c2c9-cde1" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule name="Warrant of Exploration" id="9b2a-07ae-02f1-6fd1" hidden="false">
                  <description>Carried by those who ranged ahead of the fleets and fraternised with human strays and xenos alike, to the Legions' disgust.

Effects

• The army may include up to two Detachments from the Mechanicum Faction.

Limitations

• The army must include one Detachment from a Faction that may select the Xenos Allegiance, and no more than one.
• The army may include only one Detachment from a Faction containing models with the Legiones Astartes (X) Special Rule.
• No more than two Mechanicum Detachments may be included.
• The Detachment may not include any Allied or Optional Detachments from the Agents of the Emperor or Agents of the Warmaster Factions.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Warrant-Breaker" hidden="false" id="8717-ca0c-cdc3-67d0" publicationId="7753-116a-18d0-aa13">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b170-ca76-ca18-f1c8" percentValue="false" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule name="Warrant-Breaker" id="6e23-de1a-67a9-5f9a" hidden="false">
                  <description>Those who broke the terms of their Warrant found it voided, and were hunted by loyalist and traitor alike.

Effects

• The same Faction or Sub-faction may be selected for more than one Allied or Optional Detachment (up to twice each), overriding any limit on taking more than one Faction or Sub-faction that may select the Xenos Allegiance.

Limitations

• The army may only include Allied or Optional Detachments from Factions that may select the Xenos Allegiance, or from the Imperial Army Faction.
• No Faction or Sub-faction may be selected more than twice.
• All enemy models gain Hatred (Traders Militant) when fighting this army.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="90" />
      </costs>
    </selectionEntry>
